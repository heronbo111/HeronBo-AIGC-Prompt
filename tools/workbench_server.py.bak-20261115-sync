        elif not cfg:
            out["rootIssue"] = "还没配置项目库——选一个目录，我会记进 references/paths.local.md"
        return out

    def agent_ok(self):
        """界面用：选中的 agent + 候选清单（哪个装了本技能、哪个可用）。

        "exe 跟着 skill 走"就体现在这里：exe 先看本机哪些 agent 把本技能装在自己
