    # ---- ①栏「＋ 新建项目」/ ②栏「需求 · 素材增删排序」----------------------
    def delete_project(self, b):
        """①栏项目的「删除」，两种方式由用户当场选（2026-09-16 用户要求）：

        - `mode="trash"`（默认）：扔进 **Windows 系统回收站**（能在回收站里还原）；回收站用不了
          时退回项目内的 `<项目库>/_已删除/<名字>-<时间戳>/`，同样可逆——而且在资源管理器里
          搬回来就恢复，`_` 开头不会被列出来（`_samples()` 跳过下划线目录）。
        - `mode="purge"`：**真删**（`shutil.rmtree`），删错了没得救，所以前端必须二次确认
          （把件数和目录路径都摆出来）。
        """
        d = (b.get("dir") or "").rstrip("\\/")
        mode = (b.get("mode") or "trash").strip().lower()
        if mode not in ("trash", "purge"):
            return {"ok": False, "error": "不认识的删除方式：%s" % mode}
        if not (d and os.path.isdir(d)):
            return {"ok": False, "error": "目录不存在：%s" % d}
        lib_root = Handler.root or detect_root()
        if not (lib_root and _inside(lib_root, d)):
            return {"ok": False, "error": "拒绝删除：目录不在当前项目库下"}
        if os.path.normcase(_norm_path(d)) == os.path.normcase(_norm_path(lib_root)):
            return {"ok": False, "error": "拒绝删除：这是项目库根目录，不是项目"}
        root = os.path.dirname(d)
        name = os.path.basename(d)
        if name.startswith("_"):
            return {"ok": False, "error": "这个目录不是项目（下划线开头）：%s" % name}
        if os.path.normcase(d) == os.path.normcase(read_proj() or ""):
            self._set_proj("")                       # 删的正是当前项目 → 清掉指针
        if mode == "purge":
            try:
                shutil.rmtree(d, ignore_errors=False)
            except OSError as e:
                return {"ok": False, "error": "永久删除失败：%s" % e}
            _invalidate_samples(root)
            return {"ok": True, "purged": d}
        if mode == "trash" and recycle_bin_delete(d):
            _invalidate_samples(root)
            return {"ok": True, "recycled": d, "how": "recycle"}
        dest_root = os.path.join(root, "_已删除")
        dest = os.path.join(dest_root, "%s-%s" % (name, time.strftime("%Y%m%d-%H%M%S")))
        try:
            os.makedirs(dest_root, exist_ok=True)
            shutil.move(d, dest)
        except OSError as e:
            return {"ok": False, "error": "移走失败：%s" % e}
        _invalidate_samples(root)
        return {"ok": True, "movedTo": dest, "how": "trashdir"}

    def heal_skeleton(self, pdir):
        """打开一个**缺 框架.json** 的项目时把骨架补齐（返回 True 表示补了）。

        2026-09-16 实测遇到一个只有空目录、没有 框架.json/_会话 的项目（建到一半被打断，
        或目录是人手建的）——打开它界面什么都不显示，用户也不知道该怎么办。这里自动补一下：
        **只在文件不存在时补**（文件在但坏了不动，免得把内容覆盖掉）。
        """
        if not pcore:
            return False
        lib_root = Handler.root or detect_root()
        if not (lib_root and os.path.isdir(pdir) and _inside(lib_root, pdir)):
            return False
        if os.path.normcase(_norm_path(pdir)) == os.path.normcase(_norm_path(lib_root)):
            return False
        if os.path.isfile(os.path.join(pdir, "框架.json")):
            return False
        try:
            base = pdir.rstrip("\\/")
            pcore.build_skeleton(os.path.dirname(base), os.path.basename(base),
                                 project_dir=pdir, register=False)
            return True
        except Exception:                                        # noqa: BLE001
            return False

    def new_project(self, b):
        """给一张白纸：空骨架 + 空提示词 + 空素材，并切过去。

        为什么要有（2026-09-16 用户要求）：创作台记着"上次打开的项目"，用旧项目干活时它身上
        已经堆满了东西，想从干净状态开始得自己去项目库翻。名字留空就自动起一个。
        register=False：建项目**不动**全局项目库（换根只走①栏「选项目库」）。
        """
        name = (b.get("name") or "").strip() or ("新项目-" + time.strftime("%m%d-%H%M"))
        name = _safe_project_name(name)
        if not name:
            return {"ok": False, "error": "项目名不合法：不能带 / 或 \\，也不能只有空格/点"}
        root = b.get("root") or Handler.root or detect_root()
        active_root = Handler.root or detect_root()
        if not (pcore and root):
            return {"ok": False, "error": "还没有项目库，先在①栏选一个目录"}
        if active_root and os.path.normcase(_norm_path(root)) != os.path.normcase(_norm_path(active_root)):
            return {"ok": False, "error": "拒绝建项：只能在当前项目库里新建（先切项目库）"}
        try:
            pdir, _sk, _log = pcore.build_skeleton(root, name, register=False)
        except Exception as e:                                   # noqa: BLE001
            return {"ok": False, "error": "建项目失败：%s" % e}
        if not _inside(root, pdir):
            return {"ok": False, "error": "拒绝建项：目标目录不在项目库下"}
        try:                       # 规则第 270 条：交付提示词时必须同步建 平台上传/
            os.makedirs(pcore.upload_dir(pdir, create=True) if pcore
                        else os.path.join(pdir, "平台上传"), exist_ok=True)
        except OSError:
            pass
        self._set_proj(pdir)
        _invalidate_samples(root)
        return {"ok": True, "dir": pdir, "project": _scan_project(pdir)}

    FIELDS = FIELD_KEYS          # ②栏「分镜字段速填」的六个键（模块级同名常量，start_agent 也要用）

    def save_fields(self, b):
        """②栏「分镜字段速填」（借鉴文影AI 的"引导词编创"六栏）→ 框架.json→project.fields。

        为什么要它：字段是**用户能直接控的旋钮**（景别/运镜/光影/情绪/口播/字幕），
        写进框架后 agent 出提示词时必须照它写，少猜、风格也更稳（配合统一骨架）。
        """
        pdir = self._proj(b)
        f = b.get("fields") or {}
        if not (pcore and pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "还没选项目"}
        if not isinstance(f, dict):
            return {"ok": False, "error": "fields 必须是对象（六栏键值），没有改动任何数据"}
        err = pcore.skeleton_error(pdir)
        if err:
            return {"ok": False, "error": "框架.json 损坏（%s）：先备份并修复它，不能按空项目覆盖" % err}
        clean = {k: str(f.get(k) or "").strip() for k in self.FIELDS}
        try:
            sk = pcore.load_skeleton(pdir) or {}
            sk.setdefault("project", {})["fields"] = clean
            pcore.save_skeleton(pdir, sk)
            # 另存一份人读的（agent 与用户都能一眼看）
            d = os.path.join(pdir, "备注")
            os.makedirs(d, exist_ok=True)
            body = "\n".join("%s：%s" % (k, v or "（agent 自定）") for k, v in clean.items())
            open(os.path.join(d, "分镜字段.txt"), "w", encoding="utf-8", newline="\n").write(
                "分镜字段（②栏填的；出提示词时按它写）\n" + body + "\n")
        except Exception as e:                                   # noqa: BLE001
            log_exc(pdir, "保存分镜字段")
            return {"ok": False, "error": str(e)}
        return {"ok": True, "fields": clean}

    def open_file(self, b, reveal=False):
        """用系统默认程序打开这件素材/产物；`reveal=True` 则在资源管理器里定位它。

        2026-09-19 用户要求：②栏那些行要能**双击打开、右键在文件夹里找**——
        用户核对素材时最烦的就是"得自己去文件管理器里翻"。候选路径按
        项目内常见位置依次试（素材/ 文案/ 项目根/ _已移除/），再试待投放的绝对路径。
        """
        name = (b.get("name") or "").strip()
        raw = (b.get("path") or "").strip()
        pdir = self._proj(b)
        cand = []
        if raw:
            cand.append(raw)
            if pdir and not os.path.isabs(raw):     # 相对路径按项目根解析（素材行的 movedTo 用）
                cand.append(os.path.join(pdir, raw.replace("/", os.sep)))
        if name:
            for pend in list(self._pending() or []):
                if os.path.basename(pend) == name:
                    cand.append(pend)
            if pdir:
                for sub in ("素材", "文案", "_已移除", ""):
                    cand.append(os.path.join(pdir, sub, name) if sub
                                else os.path.join(pdir, name))
        for c in cand:
            try:
                if not (c and os.path.exists(c)):
                    continue
                c = os.path.normpath(c)
                # 2026-11 QA 实测：原实现把 b["path"] 原样入候选，命中就 os.startfile，
                # 跨站 POST 可以打开/执行库外任意文件。只允许项目、豆包输出、临时输出三个根。
                roots = [pdir, os.path.expanduser(os.path.join("~", "DoubaoWork")),
                         os.path.join(os.environ.get("TEMP") or os.environ.get("TMP") or ".",
                                      "heronbo_out")]
                if os.path.isfile(c) and os.path.splitext(c)[1].lower() in DANGEROUS_OPEN_EXT:
                    return {"ok": False, "error": "出于安全考虑，创作台不直接打开可执行/脚本文件：%s"
                                                  % os.path.basename(c)}
                if not any(r and _inside(r, c) for r in roots):
                    continue
                if reveal and os.name == "nt":
                    # 资源管理器定位到该文件（/select），比只开目录准
                    subprocess.Popen(["explorer", "/select,", c])
                else:
                    os.startfile(c)                              # noqa: S606（本机动作，用户点的）
                return {"ok": True, "opened": c}
            except OSError as e:
                return {"ok": False, "error": "打不开：%s" % e}
        return {"ok": False, "error": "找不到这个文件（可能已被移走或改名）"}

