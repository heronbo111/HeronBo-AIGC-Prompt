def read_questions(pdir):
    """读 agent 留下的待确认问题 → {"items": [...], "source": "file|receipt"}。"""
    items = []
    fp = questions_path(pdir)
    if fp and os.path.isfile(fp):
        try:
            raw = json.load(open(fp, encoding="utf-8"))
        except (OSError, ValueError):
            raw = []
        for i, x in enumerate(raw if isinstance(raw, list) else []):
            if isinstance(x, dict):
                items.append({"i": i, "q": str(x.get("q") or x.get("问题") or "").strip(),
                              "hint": str(x.get("hint") or x.get("说明") or "").strip(),
                              "def": str(x.get("def") or x.get("default") or x.get("默认") or "").strip()})
            else:
                items.append({"i": i, "q": str(x).strip(), "hint": "", "def": ""})
        items = [x for x in items if x["q"]]
        if items:
            return {"items": items, "source": "file"}
    # 退路：**只有**回执里明确出现"待确认/要你确认"这类标记时才从记录里挑问句——
    # 否则回执里的反问句会被当成"agent 要你回答"，每个项目一进就弹窗（2026-09-17 实测误报）
    MARKERS = ("❓待确认", "待确认：", "待确认:", "要你确认", "等你一句话", "需要你拍板")
    try:
        recs = sorted(glob.glob(os.path.join(agent_records_dir(pdir), "*.jsonl")),
                      key=os.path.getmtime, reverse=True)[:1]
        if recs:
            txt = ""
            for ln in open(recs[0], encoding="utf-8", errors="replace"):
                try:
                    o = json.loads(ln)
                except ValueError:
                    continue
                if o.get("kind") in ("end", "line") and o.get("text"):
                    txt += o["text"] + "\n"
            if not any(m in txt for m in MARKERS):
                return {"items": [], "source": ""}
            tail = txt
            for mk in MARKERS:                       # 只从标记之后的那段里抓，别把整篇反问句都收进来
                i = txt.find(mk)
                if i >= 0:
                    tail = txt[i + len(mk):]
                    break
            qs = [q.strip() for q in re.findall(r"[^。\n]{6,120}[？?]", tail)][-6:]
            if qs:
                return {"items": [{"i": i, "q": q, "hint": "", "def": "都行，你定"} for i, q in enumerate(qs)],
                        "source": "receipt"}
    except Exception:                                            # noqa: BLE001
        pass
    return {"items": [], "source": ""}


