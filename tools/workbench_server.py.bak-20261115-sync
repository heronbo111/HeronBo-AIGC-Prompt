    def stop_agent(self, b):
        """「暂停」：停掉这一轮（**连 agent 拉起来的子进程一起**），可选顺手留一句话给下一轮。

        为什么要一起杀（2026-09-17 用户实测）：点了停止，那个"深度视频"还在算——
        因为 CLI 是父进程、深度脚本是孙子进程，只 kill 父在 Windows 上杀不掉孙子。
        `abridge.stop_current()` 现在用 taskkill /T 整棵树。
        """
        _STOPPED["flag"] = True
        _PAUSED["flag"] = True          # 暂停闩：自动读信箱的泵也一起停（别④栏自己开跑）
        kids = 0
        try:
            kids = len(abridge.proc_children()) if abridge else 0
        except Exception:                                        # noqa: BLE001
            kids = 0
        ok = bool(abridge and abridge.stop_current())
        if not ok:
            # 重开创作台后接回的"上一轮"不在本进程的 _CURRENT 里，按任务文件里的
            # agent PID 直接杀整棵树；否则用户点暂停也停不掉它。
            prev = _job_snapshot()
            pid = int((prev or {}).get("agent_pid") or 0)
            if pid:
                ok = _kill_job_process(pid)
                if ok:
                    with _PROG_LOCK:
                        _PROG.update({"running": False, "done": True, "ok": False,
                                      "text": "上一轮已在后台停止",
                                      "lines": (_PROG.get("lines") or []) + ["· 已停止后台的上一轮（PID %d）" % pid]})
                        _PROG.pop("detached_pid", None)
                    _clear_job(force=True)
        pdir = self._proj(b)
        note = (b.get("note") or "").strip()
        if ok:
            _push_line("!! 用户按了「暂停」：这一轮停掉（结果不算数，可重跑）"
                       + ("；连带 %d 个子进程一起停了" % kids if kids else "")
                       + "；排队中的提交先不自动读，下次点按钮或提交时恢复")
        if pdir and note:
            try:                       # 让下一轮一定看得到（信箱 + 待办 + 执行记录）
                inbox_append(pdir, "反馈", note, extra="用户按暂停时顺手写的")
                log_append(pdir, "· 暂停时补了一句：%s" % note, "ui")
            except Exception:                                    # noqa: BLE001
                log_exc(pdir, "暂停补话")
        return {"ok": ok, "kids": kids,
                "error": "" if ok else "现在没有在跑的任务",
                "note_saved": bool(pdir and note)}

    def remove_material(self, b):
        """②栏素材的「移除」。

        - 还没归类的（待投放）→ 直接从待投放里拿掉；
        - 已归类的 → 从 框架.json 的 materials 里删掉，文件**移到项目里的 `_已移除/`**
          （不真删：素材是用户辛苦攒的，误删要能捞回来），`平台上传/` 下的同名副本一并挪走。
        """
        f = (b.get("file") or "").strip().replace("\\", "/")
        name = (b.get("name") or "").strip()
        # mode（2026-09-19 用户要求：②栏那个 × 要能**真删**）：
        #   trash（默认）→ 真文件扔进 Windows 回收站（能还原）；permanent → 真删；
        #   keep → 只从列表/框架里拿掉，文件移到项目里的 _已移除/（老行为）。
        mode = (b.get("mode") or "trash").strip().lower()
        if mode not in ("trash", "permanent", "keep"):
            mode = "trash"

        def _kill(path):
            """按 mode 处理一个真文件；返回 True 表示动过了。"""
            if not (path and os.path.exists(path)):
                return False
            try:
                if mode == "trash":
                    return bool(recycle_bin_delete(path))
                if mode == "permanent":
                    if os.path.isdir(path):
                        shutil.rmtree(path)
                    else:
                        os.remove(path)
                    return True
            except OSError:
                return False
            return False                       # keep：由调用方自己搬

        def _move_aside(path):
            """trash/permanent 失败时的兜底：挪进 `_已移除/`，绝不让文件留在原素材夹。

            原实现 `_kill` 返回 False 也照样把元数据删了 → 文件还在 `素材/<版>/`，
            下一轮 `materials_payload()` 的兜底扫描又把它当“未登记素材”列出来，
            用户看到的就是“删掉的素材又回来了”。这里保证两者要么都成功、要么都不动。
            """
            if not (path and os.path.isfile(path)):
                return ""
            try:
                os.makedirs(dest0, exist_ok=True)
                name0 = os.path.basename(path)
                target = os.path.join(dest0, name0)
                if os.path.exists(target):
                    target = os.path.join(dest0, "%s-%d%s" % (
                        os.path.splitext(name0)[0], int(time.time() * 1000),
                        os.path.splitext(name0)[1]))
                shutil.move(path, target)
                return target
            except OSError:
                return ""
        dest0 = os.path.join(self._proj(b), "_已移除")

        if b.get("pending"):
            pdir0 = self._proj(b)
            pend = self._pending()
            hit = [p_ for p_ in list(pend)
                   if p_ == b.get("pending") or os.path.basename(p_) == name]
            for p_ in hit:
                pend.remove(p_)
            done = []
            for p_ in hit:
                if _kill(p_):
                    done.append(p_)
                elif _move_aside(p_):
                    done.append(p_)       # 真删失败也要把文件挪出素材夹
            # 2026-10-27 用户报：删掉的素材重开/再导入又出现——内存列表改了但没落盘
            save_pending(pdir0, pend)
            return {"ok": True, "pending": pend, "moved": done, "mode": mode}
        pdir = self._proj(b)
        if not (pcore and pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "没有项目"}
        sk = pcore.load_skeleton(pdir)
        if not isinstance(sk, dict):
            return {"ok": False, "error": "读不到 框架.json"}
        mats = (sk.get("project") or {}).get("materials") or []
        keep, moved = [], []
        dest = os.path.join(pdir, "_已移除")
        for m in mats:
            if not isinstance(m, dict):
                continue
            rel = (m.get("file") or "").replace("\\", "/")
            if (f and rel == f) or (not f and name and (m.get("name") or "") == name):
                src = os.path.join(pdir, rel.replace("/", os.sep)) if rel else ""
                upbase = (pcore.upload_dir(pdir) if pcore
                          else os.path.join(pdir, "平台上传"))
                # 上传副本可能在夹子根、也可能在**当前版的子目录**里（rules 71 起按版本分夹）
                ups = [os.path.join(upbase, os.path.basename(rel or name))]
                _vn = cur_ver_name(pdir)
                if _vn:
                    ups.append(os.path.join(upbase, _vn, os.path.basename(rel or name)))
                if mode in ("trash", "permanent"):      # 真删（回收站 / 永久）
                    if _kill(src):
                        moved.append(rel or name)
                    elif _move_aside(src):
                        moved.append(rel or name)       # 删失败也必须挪出素材夹
                    for up in ups:
                        if _kill(up):
                            moved.append("平台上传/" + os.path.basename(up))
                        elif _move_aside(up):
                            moved.append("平台上传/" + os.path.basename(up))
                    continue
                try:
                    os.makedirs(dest, exist_ok=True)
                    if os.path.isfile(src):
                        shutil.move(src, os.path.join(dest, os.path.basename(src)))
                        moved.append(rel)
                    for up in ups:
                        if os.path.isfile(up):
                            shutil.move(up, os.path.join(dest, os.path.basename(up)))
                            moved.append("平台上传/" + os.path.basename(up))
                except OSError as e:
                    return {"ok": False, "error": "移动失败：%s" % e}
                continue
            keep.append(m)
        if len(keep) == len(mats) and not moved:
            return {"ok": False, "error": "框架里没有这件素材：%s" % (f or name)}
        _sync_cur_mats(sk, keep)       # 当前版：与 versions[] 里该版的快照同步
        pcore.save_skeleton(pdir, sk)
        # 同名条目还在待投放里的话一并清掉（否则②栏会同时出现"已删除"和"待归类"）
        try:
            pend1 = self._pending()
            base1 = os.path.basename(name or f)
            left = [x for x in pend1 if os.path.basename(x) != base1]
            if len(left) != len(pend1):
                self.server.pending[:] = left
                save_pending(pdir, left)
        except Exception:                                    # noqa: BLE001
            pass
        return {"ok": True, "moved": moved, "materials": materials_payload(pdir),
                "project": _scan_project(pdir)}

    def open_path(self, b):
        """在资源管理器里打开一个项目相关的目录/文件（用户点的动作）。

        kind: uploads（平台上传）/ project（项目根）/ materials（素材）/ code（文案）/
              finals（成片）/ rejects（废片）/ reviews（评价）/ records（对话记录）
        sub: 打开某个子目录（比如平台上传的某个版本）
        """
        pdir = self._proj(b)
        if not (pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "还没有项目"}
        kind = (b.get("kind") or "project").strip()
        sub = (b.get("sub") or "").strip()
        # 2026-10-10（m11686 2.3）：kind=file —— 直接打开一个**项目里的文件**的所在文件夹并选中它
        #（成片 done 弹窗的「打开文件夹」用；只允许项目内的文件，防目录穿越）
        if kind == "file":
            fp = os.path.normpath(os.path.abspath(str(b.get("path") or "")))
            # 白名单根（2026-10-16 用户要求"成片指原位置、不再拷贝"）：除项目目录外，再放两个
            # "豆包的家"——成片原位置（~/DoubaoWork/…）与文件交接目录（%TEMP%\heronbo_out\…）；
            # 别的一律拒（防目录穿越）。
            _roots = [os.path.normpath(pdir)]
            try:
                _roots.append(os.path.join(os.path.expanduser("~"), "DoubaoWork"))
                _tmp0 = os.environ.get("TEMP") or os.environ.get("TMP") or ""
                if _tmp0:
                    _roots.append(os.path.join(_tmp0, "heronbo_out"))
            except Exception:                                    # noqa: BLE001
                pass
            # 2026-11-10 修「所有文件夹按钮全部失效」：这里原本又写了一个局部 def _inside(p, r)，
            # Python 因此把 _inside 当成 open_path 的**局部名**——只要没进 kind=="file" 这一支，
            # 下面 5477 那行 `_inside(pdir, target)` 就抛 UnboundLocalError（HTTP 500）。
            # 直接复用文件顶部的模块级 _inside(root, path)（口径相同，参数顺序是 root 在前）。
            if not any(_inside(r, fp) for r in _roots if r):
                return {"ok": False, "error": "路径越界"}
            if not os.path.isfile(fp):
                return {"ok": False, "error": "文件不存在：%s" % fp}
            if os.name == "nt":
                try:
                    subprocess.Popen(["explorer", "/select,", fp])
                except OSError as e:
                    return {"ok": False, "error": "打不开：%s" % e}
            return {"ok": True, "opened": fp}
        # 上传夹走 upload_dir()：老项目里叫「即梦上传」也能正确打开（不会凭空建一个空的新夹）
        if kind == "uploads":
            base = pcore.upload_dir(pdir, create=True) if pcore else os.path.join(pdir, "平台上传")
            rel = os.path.relpath(base, pdir)
        else:
            rel = {"project": "", "materials": "素材", "code": "文案",
                   "finals": "成片", "rejects": "废片", "reviews": "评价",
                   "records": os.path.join("_会话", "agent记录")}.get(kind)
        if rel is None:
            return {"ok": False, "error": "不认识的 kind：%s" % kind}
        target = os.path.normpath(os.path.join(pdir, rel, sub)) if sub else             os.path.normpath(os.path.join(pdir, rel))
        # 防目录穿越：必须还在项目里（realpath 口径，防 `..` 与符号链接）
        if not _inside(pdir, target):
            return {"ok": False, "error": "路径越界"}
        if not os.path.exists(target):
            try:
                os.makedirs(target, exist_ok=True)
            except OSError as e:
                return {"ok": False, "error": "建不了目录：%s" % e}
        if os.name == "nt":
            try:
                os.startfile(target)                             # noqa: S606（本机动作，用户点的）
            except OSError as e:
                return {"ok": False, "error": "打不开：%s" % e}
        return {"ok": True, "opened": target}

    def prompt_save(self, b):
        """③栏「存下改稿」：用户手改的提示词正文写回磁盘（2026-11-10 用户要求）。

        为什么必须落文件：生成视频时 doubao_cdp 是拿 `--prompt-file` 指向
        `文案/提示词正文.txt` 的（见 wb_video._prompt_file），只改界面不改文件，
        下一句"改好的词"根本进不了请求。所以这颗按钮＝把界面里的字变成本地正文。
        "先看再改再生成"这一步就闭合了：改完存下 → 点「让豆包生成视频」用的就是这份。
        """
        pdir = self._proj(b)
        if not (pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "还没有项目"}
        text = str(b.get("text") or "").replace("\r\n", "\n").strip("\n")
        if not text.strip():
            return {"ok": False, "error": "正文是空的，没存"}
        # 目标文件：沿用已有那份（根目录的老项目 / 文案 下的新口径）；都没有就建 文案/提示词正文.txt
        cands = [os.path.join(pdir, "提示词正文.txt"),
                 os.path.join(pdir, "文案", "提示词正文.txt")]
        target = next((p for p in cands if os.path.isfile(p)), "")
        if not target:
            target = cands[1]
            try:
                os.makedirs(os.path.dirname(target), exist_ok=True)
            except OSError as e:
                return {"ok": False, "error": "建不了 文案 目录：%s" % e}
        backup = ""
        try:
            if os.path.isfile(target):
                d = os.path.join(pdir, "文案", "_备份")
                os.makedirs(d, exist_ok=True)
                backup = os.path.join(d, "提示词正文-%s.txt" % time.strftime("%Y%m%d-%H%M%S"))
                shutil.copy2(target, backup)
        except OSError:
            backup = ""
        try:
            with open(target, "w", encoding="utf-8", newline="\n") as f:
                f.write(text + "\n")
        except OSError as e:
            return {"ok": False, "error": "写不进去：%s" % e}
        rel = os.path.relpath(target, pdir)
        # 框架.json 里那份正文也同步（它只是兜底来源，但 agent 下一轮会照着它改，别留两个版本）
        sk_synced = False
        try:
            if pcore:
                sk = pcore.load_skeleton(pdir)
                proj = (sk or {}).get("project") or {}
                prs = proj.get("prompts") or []
                hit = None
                for pr in prs:
                    if isinstance(pr, dict) and pr.get("text"):
                        hit = pr
                if hit is None and prs and isinstance(prs[-1], dict):
                    hit = prs[-1]
                if hit is not None:
                    hit["text"] = text
                    pcore.save_skeleton(pdir, sk)
                    sk_synced = True
        except Exception:                                        # noqa: BLE001
            sk_synced = False
        # 重拼带元信息的 文案/提示词.txt（复制到平台用的那份）；元信息从旧文件头部捡回来，
        # 捡不到就不动它——宁可不动，也不要把"形态/模型/台词"写成（待补）把元信息抹掉。
        assembled, note = False, ""
        try:
            full = os.path.join(pdir, "文案", "提示词.txt")
            if pcore and os.path.isfile(full) and hasattr(pcore, "assemble_prompt"):
                head = open(full, encoding="utf-8-sig").read().split("\n")[:4]
                form = model = dur = ratio = lines = ""
                for ln in head:
                    m = re.search(r"形态：(.+?)｜", ln)
                    if m:
                        form = m.group(1).strip()
                    m = re.search(r"模型：(.+?)｜", ln)
                    if m:
                        model = m.group(1).strip()
                    m = re.search(r"时长：(\d+)\s*s", ln)
                    if m:
                        dur = m.group(1)
                    m = re.search(r"画幅：.*?(\d+:\d+)", ln)
                    if m:
                        ratio = m.group(1)
                    m = re.match(r"台词：(.+)$", ln)
                    if m:
                        lines = m.group(1).strip()
                if model or dur or form:
                    r2 = pcore.assemble_prompt(pdir, form=form, model=model, duration=dur,
                                               ratio=ratio, lines=lines)
                    assembled = bool((r2 or {}).get("ok"))
                    if not assembled:
                        note = str((r2 or {}).get("error") or "")[:120]
                else:
                    note = "旧 提示词.txt 里没读到元信息，这份没重拼（正文已经存好）"
        except Exception as e:                                   # noqa: BLE001
            note = "重拼 提示词.txt 没成功：%s" % str(e)[:100]
        try:
            log_append(pdir, "用户手改提示词正文并保存（%d 字）→ %s" % (len(text), rel), "ok")
        except Exception:                                        # noqa: BLE001
            pass
        return {"ok": True, "file": rel, "chars": len(text),
                "backup": (os.path.relpath(backup, pdir) if backup else ""),
                "skel": sk_synced, "assembled": assembled, "note": note}

    def questions(self):
        """agent 留下的「待确认问题」（没有就返回空表）。"""
        pdir = self._proj()
        if not (pdir and os.path.isdir(pdir)):
            return {"ok": False, "items": [], "error": "还没选项目"}
        if _PROG.get("running") and _PROG.get("what") == "intake":
            return {"ok": True, "items": [], "source": "file", "suppressed": "intake"}
        d = read_questions(pdir)
        return {"ok": True, "items": d["items"], "source": d["source"]}

    def answer_questions(self, b):
        """用户回答问题 → 写进 todo（agent 下一轮就会读到）+ 把问题文件归档，别再弹。

        为什么要走 todo：那正是"程序 → agent"的通道（agent 每轮开头会读 待办.jsonl），
        所以答案会**随下一次 agent 调用**自然带过去，不需要额外的接线。
        """
        pdir = self._proj(b)
        if not (pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "还没选项目"}
        ans = b.get("answers") or {}
        if not isinstance(ans, dict) or not any(str(v).strip() for v in ans.values()):
            return {"ok": False, "error": "还没填回答"}
        lines = ["【你上一轮问的问题，用户这样答的】"]
        for q, a in ans.items():
            a = str(a).strip()
            if a:
                lines.append("问：%s\n答：%s" % (q.strip(), a))
        text = "\n".join(lines)
        try:
            if pcore:
                pcore.push_todo(pdir, "反馈", text, by="user")
        except Exception as e:                                   # noqa: BLE001
            return {"ok": False, "error": "写待办失败：%s" % e}
        # 归档问题文件：下次不再弹同一批
        try:
            fp = questions_path(pdir)
            if os.path.isfile(fp):
                os.replace(fp, os.path.join(os.path.dirname(fp),
                                            "待确认_已答_%s.json" % time.strftime("%Y%m%d-%H%M%S")))
        except OSError:
            pass
        log_append(pdir, "已回答 agent 的 %d 个问题（会随下一轮带过去）" % len(
            [1 for v in ans.values() if str(v).strip()]), "ok")
        return {"ok": True}

    def prompt_check(self):
        """③栏「提示词体检」：按《统一骨架》检查当前项目的提示词（references/prompt-templates.md 第 0 节）。

        为什么要摆到界面上（2026-09-16）：用户发现同一天两个项目的提示词**风格各写各的**——
        光靠 agent 自觉记不住骨架，所以给一个当场能跑的检查，不合格就把行号与改法摆出来。
        """
        if not pcheck:
            return {"ok": False, "error": "找不到 tools\\提示词体检.py"}
        pdir = self._proj()
        if not (pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "还没选项目"}
        # 优先体检"正在交付的那一份"：**文案/提示词.txt 排第一**（2026-09-21 新口径：提示词只放 文案/）
        # → 再退项目根 提示词.txt（老项目）→ 最后 文案/*提示词*.txt
        cand = [os.path.join(pdir, "文案", "提示词.txt"), os.path.join(pdir, "提示词.txt")]
        d = os.path.join(pdir, "文案")
        if os.path.isdir(d):
            cand += [os.path.join(d, fn) for fn in sorted(os.listdir(d))
                     if "提示词" in fn and fn.lower().endswith(".txt")]
        p = next((x for x in cand if os.path.isfile(x)), "")
        if not p:
            return {"ok": False, "error": "这个项目还没有提示词文件"}
        ok, ps, ws, fs = pcheck.check_path(p)
        return {"ok": True, "pass": ok, "file": p,
                "passed": [{"name": n, "detail": d} for n, d in ps],
                "warn": [{"name": n, "detail": d} for n, d in ws],
                "fail": [{"name": n, "detail": d} for n, d in fs]}

    def records(self):
        """本项目跑过的 agent 轮次 + agent 自己那份会话正文的路径。

        为什么要创作台自己记一份：各家 agent 的会话存储格式/位置都不一样（WorkBuddy 在
        `~/.workbuddy/projects/<路径打平>/<id>.jsonl`，ZCode 在 `~/.zcode/cli/rollout/model-io-<id>.jsonl`），
        而且**桌面端里看不到**。创作台每跑一轮就写一份人能读的记录（时间线），翻起来最省事。
        """
        pdir = self._proj()
        if not (pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "还没有项目", "records": []}
        st = _proj_state(pdir)
        sid = st.get("agentSession") or ""
        tpath = ""
        if abridge and sid:
            try:
                key, _why = abridge.pick_agent()
                tpath = abridge.transcript_path(key or "", pdir, sid)
            except Exception:                                    # noqa: BLE001
