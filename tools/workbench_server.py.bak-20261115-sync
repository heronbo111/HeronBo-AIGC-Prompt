    def video_action(self, path, b):
        if not wvideo:
            return {"ok": False, "error": "缺 wb_video.py"}
        if path == "/api/video/cdp/restart":
            # 2026-11-14：豆包在跑但没调试端口时，不再让视频桥偷偷 kill + 重开，
            # 改由用户在失败弹窗里点一下，这里才带端口重启并接管。
            # 这条不依赖项目，放在"先选项目"之前。
            return wvideo.restart_doubao()
        pdir = self._proj(b)
        if not pdir:
            return {"ok": False, "error": "先选项目"}
        if path == "/api/video/estimate":
            return wvideo.api_estimate(pdir, b)
        if path == "/api/video/prepare":
            if _PROG.get("running"):
                return {"ok": False, "error": "主 agent 正在跑（一次一轮），等它完再准备视频"}
            # 2026-10-21：**去掉"通道必须是豆包工作"的门槛**。视频生成走的是豆包 CDP 桥
            #（api_prepare 自己调 doubao_cdp.mjs），跟"出提示词用的 agent 通道"是两件事。
            # 用户同事的真实工作流：项目绑 WorkBuddy 出提示词、视频让豆包生成——原门槛与
            # rules 80「同项目不换通道」叠在一起就是死锁（绑定的 WorkBuddy 可用 → 不许切；
            # 非豆包 → 直接拒）。豆包桥真不可用时 api_prepare 会给出具体原因。
            return wvideo.api_prepare(pdir, b)
        if path == "/api/video/confirm":
            if _PROG.get("running"):
                return {"ok": False, "error": "主 agent 正在跑（一次一轮），等它完再生成"}
            return wvideo.api_confirm(pdir, b)
        if path == "/api/video/cancel":
            return wvideo.api_cancel(pdir, b)
        return {"ok": False, "error": "不认识的视频动作：%s" % path}

    def serve_video_file(self):
        from urllib.parse import urlparse, parse_qs
        fp = (parse_qs(urlparse(self.path).query).get("path") or [""])[0]
        if not fp or not os.path.isfile(fp) or not fp.lower().endswith((".mp4", ".mov", ".webm")):
            self.send_error(404, "not found")
            return
        # 2026-11 QA 实测：这里只判 isfile，`/api/video/play?path=C:\\任意.mp4`
        # 能把库外文件整段读进内存返回。只允许项目内 / 豆包输出目录。
        pdir = self._proj()
        roots = [pdir, os.path.expanduser(os.path.join("~", "DoubaoWork")),
                 os.path.join(os.environ.get("TEMP") or os.environ.get("TMP") or ".", "heronbo_out")]
        # 本进程刚取回的成片（豆包可能把文件卡片放在用户指定的其它目录）单独放行。
        allowed = []
        try:
            allowed = [os.path.realpath(p) for p in (wvideo.exported_paths() if wvideo else [])
                       if p]
        except Exception:                                    # noqa: BLE001
            allowed = []
        if (os.path.realpath(fp) not in allowed) and not any(r and _inside(r, fp) for r in roots):
            self.send_error(404, "not found")
            return
        try:
            size = os.path.getsize(fp)
            f = open(fp, "rb")
        except OSError:
            self.send_error(404, "read fail")
            return
        self.send_response(200)
        self.send_header("Content-Type", "video/mp4")
        self.send_header("Content-Length", str(size))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            with f:
                shutil.copyfileobj(f, self.wfile, 1 << 20)   # 分块发，别把整段视频读进内存
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass

