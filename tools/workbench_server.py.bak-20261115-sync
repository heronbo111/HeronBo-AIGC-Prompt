    def pending_filtered(self):
        """待归类列表 → 去掉"已经归进项目"的（同名同大小已在 框架.json 或已在 素材/文案/）。"""
        pend = list(self.server.pending or [])
        pdir = self._proj()
        if not (pend and pdir and os.path.isdir(pdir)):
            return pend
        known = set()
        known_sig = set()
        known_wild = set()
        try:
            sk = pcore.load_skeleton(pdir) if pcore else None
            for m in (((sk or {}).get("project") or {}).get("materials") or []):
                if isinstance(m, dict):
                    name = (m.get("name") or os.path.basename(m.get("file") or "")).lower()
                    if name:
                        known.add(name)
                        if m.get("size") is None:
                            known_wild.add(name)       # 老数据没体积 → 只能按名字兜底
                        else:
                            try:
                                known_sig.add((name, int(m.get("size") or 0)))
                            except (TypeError, ValueError):
                                known_wild.add(name)
        except Exception:                                        # noqa: BLE001
            pass
        for sub in ("素材", "文案"):
            d = os.path.join(pdir, sub)
            if os.path.isdir(d):
                try:
                    for fn in os.listdir(d):
                        known.add(fn.lower())
                        try:
                            known_sig.add((fn.lower(), os.path.getsize(os.path.join(d, fn))))
                        except OSError:
                            pass
                except OSError:
                    pass

        def _seen(p):
            name = os.path.basename(p).lower()
            try:
                size = os.path.getsize(p)
            except OSError:
                size = -1
            return name in known_wild or (name, size) in known_sig

        out = [p for p in pend if not _seen(p)
               and not is_output_name(os.path.basename(p))]   # 产物/文稿不进②栏
        if len(out) != len(pend):        # 顺手把服务端那份也清干净，别再出现第二遍
            try:
                self.server.pending[:] = out
            except Exception:                                    # noqa: BLE001
                pass
        return out


    def onboard_check(self):
        """首次配置汇总：**只读**——查环境 / 通道 / 项目库，不安装、不登录、不生成。

        环境项复用 `环境检查.py` 的 probe()（它本来就是"只检查不安装"）；豆包只做只读探测
        （不拉起客户端）；即梦查 CLI 与登录态（user_credit，无费用）；项目库检查存在与可写。
        """
        out = {"env": {"ok": False, "items": []}, "doubao": {"ok": False, "detail": ""},
               "doubao_cli": {"ok": False, "detail": "未检测", "version": ""},
               "skills": {"ok": False, "complete": False, "items": [], "roots": []},
               "dreamina": {"ok": False, "detail": ""}, "agents": [],
               "project": {"ok": False, "path": "", "detail": ""},
