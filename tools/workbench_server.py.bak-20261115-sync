    _sess_map = st.get("agentSessions") if isinstance(st.get("agentSessions"), dict) else {}
    _sess_of = st.get("agentSessionOf") or ""
    _switched = ""
    sid = (_sess_map.get(_k) or "") if _k else ""
    if sid:
