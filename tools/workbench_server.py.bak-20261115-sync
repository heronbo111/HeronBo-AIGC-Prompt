def smtp_send_feedback(cfg, to, subject, body):
    """SMTP_SSL 直发一封反馈邮件。成功返回 (True, msgid)；失败返回 (False, 错误串)。"""
    import smtplib
    import ssl
    from email.mime.text import MIMEText
    from email.utils import formataddr
    try:
        msg = MIMEText(body, "plain", "utf-8")
        msg["Subject"] = subject
        msg["From"] = formataddr(("HeronBo 创作台", cfg["user"]))
        msg["To"] = to
        ctx = ssl.create_default_context()
        port = int(cfg.get("port") or 465)
        with smtplib.SMTP_SSL(cfg["host"], port, timeout=20, context=ctx) as s:
            s.login(cfg["user"], cfg["code"])
            s.sendmail(cfg["user"], [to], msg.as_string())
        return True, ""
    except Exception as e:                                        # noqa: BLE001
        return False, "%s: %s" % (type(e).__name__, e)


