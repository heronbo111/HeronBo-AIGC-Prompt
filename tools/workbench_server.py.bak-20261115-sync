        except Exception as e:                                   # noqa: BLE001
            return {"ok": False, "error": "写待办失败：%s" % e}
        # 反馈也进信箱：这样"下一轮"不管是哪一类任务，开头都会先读到它
        try:
            inbox_append(pdir, "反馈", text)
        except Exception:                                        # noqa: BLE001
            log_exc(pdir, "写信箱（反馈）")
        out = {"ok": True, "round": n}
        if b.get("callAgent"):
            out["agent"] = start_agent(pdir, "feedback", text)
        else:
