WIN_TITLE = "HeronBo · AI 视频创作台"     # 网页创作台的窗口标题（经典界面会带「（经典界面）」后缀）
WIN_TITLE_LEGACY = "HeronBo · AI 视频工作台"   # 改名前的窗口标题：老实例还开着时也要能认出来


def _http_json(port, path, body=None, timeout=0.8):
    """跟本机已开的实例说一句话（复用/切项目用）。"""
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request("http://127.0.0.1:%d%s" % (port, path), data=data,
                                headers={"Content-Type": "application/json"} if data else {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def find_window(title=WIN_TITLE, visible_only=True):
    """按标题找我们自己那个窗口（返回句柄，没有就 0）。

    **只认完全同名**：经典界面是「…（经典界面）」，不能被当成网页创作台复用。
    `visible_only=False` 也给「最小化到后台」用：窗口 hide 了但仍活着，
    重开创作台要能把它叫回来，而不是当成没开过、另起一个实例。
    """
    if os.name != "nt":
        return 0
    try:
        import ctypes
        from ctypes import wintypes
    except ImportError:
        return 0
    u = ctypes.windll.user32
    hit = []
    titles = {title}
    if title == WIN_TITLE:                 # 改名过渡期：旧标题也要能匹配，避免重开时另起实例
        titles.add(WIN_TITLE_LEGACY)

    @ctypes.WINFUNCTYPE(ctypes.c_bool, wintypes.HWND, wintypes.LPARAM)
    def _cb(hwnd, _l):
        if visible_only and not u.IsWindowVisible(hwnd):
            return True
        n = u.GetWindowTextLengthW(hwnd)
        if n:
            buf = ctypes.create_unicode_buffer(n + 1)
            u.GetWindowTextW(hwnd, buf, n + 1)
            if buf.value.strip() in titles:
                hit.append(hwnd)
                return False
        return True

    u.EnumWindows(_cb, 0)
    return hit[0] if hit else 0


def focus_window(hwnd):
    """把已开着的窗口叫到前面（最小化了就先还原）。

    Windows 有前台锁：SetForegroundWindow 可能被拒（那就任务栏闪一下，用户点一下即可），
    但最小化还原（ShowWindow SW_RESTORE）是稳的。
    """
    if not hwnd:
        return False
    try:
        import ctypes
        u = ctypes.windll.user32
        if not u.IsWindowVisible(hwnd):
            u.ShowWindow(hwnd, 5)          # SW_SHOW：从「最小化到后台」的 hide 恢复
        if u.IsIconic(hwnd):
            u.ShowWindow(hwnd, 9)          # SW_RESTORE
        u.SetForegroundWindow(hwnd)
        return True
    except (OSError, AttributeError, ImportError):
        return False


def existing_instance():
    """已经开着的那个实例：(窗口句柄, 端口)；都没有就 (0, 0)。

    以 `%TEMP%` 里记的端口为主：端口能应答 `/api/state` 且版本指纹一致，才算
    "已经开着"；窗口句柄只在端口也活着时返回。**不能只凭标题找窗口**——旧版
    残留窗口、服务已经退出的空壳窗口都会把新 exe 挡在旧界面前面。

    **版本不同不再复用**（2026-11-03 晚补）：只认窗口/端口会把旧 exe 或旧源码实例
    当成当前实例，点新 exe 反而把旧前端叫到前面来。这里比对 /api/state 的
    build.format=2、build.stamp 与 build.size；对不上就返回 (0, 0)，让新进程自己起
    （端口被占时 serve 会自动退随机端口）。
    """
    hwnd = find_window(visible_only=False)
    port = 0
    try:
        with open(_proj_file(), encoding="utf-8") as f:
            port = int((json.load(f) or {}).get("port") or 0)
    except (ValueError, OSError, TypeError):
        port = 0
    if port:
        try:
            st = _http_json(port, "/api/state")
            if not (isinstance(st, dict) and "build" in st and "agent" in st):
                port = 0
            else:
                old_build = st.get("build") or {}
                if not isinstance(old_build, dict):
                    port = 0
                # 旧版本没有 format=2 指纹，即使 exe 文件已被同名覆盖也要拒绝复用
                elif old_build.get("format") != 2:
                    port = 0
                    hwnd = 0
                else:
                    cur_stamp = (build_info() or {}).get("stamp") or ""
                    old_stamp = old_build.get("stamp") or ""
                    cur_size = (build_info() or {}).get("size") or 0
                    old_size = old_build.get("size") or 0
                    if cur_stamp and old_stamp and (
                            cur_stamp != old_stamp
                            or (cur_size and old_size and cur_size != old_size)):
                        # 旧 exe / 旧源码实例：不要把旧前端叫到前面来
                        port = 0
                        hwnd = 0
        except (OSError, ValueError):
            port = 0
        if not port:
            # 端口不可用就别再信窗口句柄：很可能是旧版残留窗口（甚至没有服务），
            # 新 exe 应该自己起，而不是把旧窗口叫到前面来。
            hwnd = 0
    return hwnd, port


def _winlog(msg):
