def _stage_weights(what, n):
    """各段权重，归一化到 100；没配比的任务按 15/65/15/5。"""
    w = list(_STAGE_W_BY_WHAT.get(what or "", [15, 65, 15, 5]))
    if n > len(w):
        w += [max(4, (100 - sum(w)) // max(1, n - len(w)))] * (n - len(w))
    w = w[:n]
    s = sum(w) or 1
    return [x * 100.0 / s for x in w]


