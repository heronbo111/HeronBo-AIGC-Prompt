def project_flags(pdir):
    """项目级开关（②栏「素材加工」面板等）：从 框架.json→project 读出来。

    为什么单独做一个：这类开关是**每次都顶到 agent 指令最前面的硬约束**，
    散在页面里会丢；落盘在项目里，换 agent、换机器、隔几天再来都还在。
    allowExtra＝用户勾了哪些加工项（rules 55 清单制，2026-10-06）；空列表＝
    一律不加工（与旧版 forbidExtra=True 同义；旧字段继续维护，老脚本还认它）。
    """
    out = {"forbidExtra": False, "allowExtra": []}
    if not (pcore and pdir):
        return out
    try:
        sk = pcore.load_skeleton(pdir) or {}
        pj = sk.get("project") or {}
        out["forbidExtra"] = bool(pj.get("forbidExtra"))
        raw = pj.get("allowExtra")
        if isinstance(raw, list):
            out["allowExtra"] = [k for k in raw if k in _EXTRA_KEYS]
        else:
            # 从没配置过 → 默认放行「抽帧拼图 + OCR」（识别归类的基本动作，2026-10-07 用户裁定）
