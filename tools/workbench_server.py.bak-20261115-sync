def _compute_build_info():
    src = sys.executable if getattr(sys, "frozen", False) else os.path.abspath(__file__)
    size = 0
    try:
        stat = os.stat(src)
        stamp = datetime.datetime.fromtimestamp(stat.st_mtime).strftime("%m-%d %H:%M")
        size = stat.st_size
    except OSError:
        stamp = "?"
    return {"path": src, "stamp": stamp, "size": size,
            "format": 2, "frozen": bool(getattr(sys, "frozen", False))}


