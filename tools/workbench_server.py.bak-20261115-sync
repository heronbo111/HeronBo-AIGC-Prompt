               "video_bridge": {"mode": "cli", "cdp_ready": False, "cdp_why": ""},
               "onboarded": bool((read_ui() or {}).get("onboarded"))}
        # 1) 运行环境（只检查）
        try:
            items = wenvchk.probe() if wenvchk else []
            bad = [x for x in items if x.get("级别") == "必需" and x.get("状态") != "OK"]
            out["env"] = {"ok": not bad, "items": items}
        except Exception as e:                                   # noqa: BLE001
            out["env"] = {"ok": False, "items": [], "error": str(e)[:200]}
        # 2) 豆包通道（只读探测：客户端在不在、桥跑不跑得动）
        try:
