# ── 豆包画布（挂在工作台同端口 /canvas/，2026-11-04）────────────────────────
# 以前画布单开 9190、前端写死 http://127.0.0.1:9190；换机后画布工程没进安装包、
# 也没有自带的 node，画布根本起不来。现在：
#   · 画布仍是独立 node 进程（浏览器里跑原生 canvas，不塞进 Python），但只监听 127.0.0.1；
#   · 工作台用 /canvas/* 前缀反代到它，页面里不再出现第二个端口；
#   · 画布跟工作台用同一份 doubao_cdp.mjs / 同一个 9333 调试端口（不是两套桥）；
#   · 启动工作台时先异步拉起画布，另开窗口/无头模式也会拉；起不来不挡工作台。
CANVAS_PORT = int(os.environ.get("HERONBO_CANVAS_PORT") or 9190)
CANVAS_URL = "http://127.0.0.1:%d/" % CANVAS_PORT
CANVAS_EXTERNAL_DIR = r"D:\ZCode工作区\doubao-canvas"
CANVAS_DIR = ""                       # 延迟解析：先看环境变量，再看随包 canvas，再看作者机旧目录
_CANVAS_LOCK = threading.Lock()
_CANVAS_PROC = None


def _canvas_candidates():
    out = []
    env = os.environ.get("HERONBO_CANVAS_DIR")
    if env:
        out.append(os.path.normpath(env))
    out.append(os.path.join(HERE, "canvas"))       # 打包后：_internal\canvas
    out.append(CANVAS_EXTERNAL_DIR)                # 开发机/老用户机器上的独立工程
    return out


def canvas_dir():
    """找画布工程：有 server.js 才算。找不到也返回候选路径，报错时能说清找过哪儿。"""
    global CANVAS_DIR
    if CANVAS_DIR and os.path.isfile(os.path.join(CANVAS_DIR, "server.js")):
        return CANVAS_DIR
    for d in _canvas_candidates():
        if os.path.isfile(os.path.join(d, "server.js")):
            CANVAS_DIR = d
            return d
    CANVAS_DIR = _canvas_candidates()[0]
    return CANVAS_DIR


def _canvas_prepare_data(root):
    """预先建好画布将要 mkdir 的目录，再把它当 CANVAS_ROOT 交出去。

    为什么要在 Python 侧先建：store.js 会 mkdir(<CANVAS_ROOT>/data/canvases) 与
    .../media；这台机器上 node 在 C: 下新建目录会被拦成 EPERM（D: 正常），
    但目录**已存在**时 mkdir(recursive) 能正常返回。先建好就绕开这个坑，
    也避免 node 冷启动时把失败写进日志、被误判成画布工程坏了。
    """
    root = os.path.abspath(root)
    for rel in ("", "data", os.path.join("data", "canvases"), os.path.join("data", "media")):
        try:
            os.makedirs(os.path.join(root, rel) if rel else root, exist_ok=True)
        except OSError:
            pass
    return root


def _canvas_data_dir(cdir):
    """画布数据根目录（注意：不是 data 本身，store.js 会在它下面再建 data）。

    优先级：HERONBO_CANVAS_DATA → 老工程自带的 <canvas>/data → 开发机工程旁 →
    %LOCALAPPDATA%\\HeronBoScoreTool\\canvas-data。返回前把 store.js 要建的
    子目录预建好，避免 node 在受保护盘符上 mkdir 被 EPERM 拦下。
    """
    env = os.environ.get("HERONBO_CANVAS_DATA")
    if env:
        return _canvas_prepare_data(env)
    if os.path.isdir(os.path.join(cdir, "data")):
        # 老工程的数据本来就在 <canvas>/data；CANVAS_ROOT 要传 cdir，不能再套一层 data。
        return _canvas_prepare_data(cdir)
    if os.path.normcase(os.path.dirname(os.path.abspath(cdir))) != os.path.normcase(
            os.path.abspath(HERE)):
        try:
            os.makedirs(os.path.join(cdir, "data"), exist_ok=True)
            return _canvas_prepare_data(cdir)
        except OSError:
            pass
    out = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"),
                       "HeronBoScoreTool", "canvas-data")
    return _canvas_prepare_data(out)


def _canvas_port_alive(port):
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=0.5):
            return True
    except OSError:
        return False


def _canvas_free_port(start=9190, end=9200):
    """9190 被别的程序占了（不是我们的画布）时，换一个空闲端口起。

    之前写死 9190：用户手动开的别的画布/旧实例占着端口，工作台拉的新实例
    直接 “端口 9190 被占用了” 退出，前端就一直报画布超时。
    """
    for p in range(start, end + 1):
        if not _canvas_port_alive(p):
            return p
    return 0


def _canvas_adopt_or_rebase():
    """返回 True 表示当前 CANVAS_PORT 上有健康画布；否则必要时换端口。"""
    global CANVAS_PORT, CANVAS_URL
    if _canvas_health(2.0):
        return True
    if _canvas_port_alive(CANVAS_PORT):
        old = CANVAS_PORT
        p = _canvas_free_port(old + 1, old + 10)
        if p:
            CANVAS_PORT = p
            CANVAS_URL = "http://127.0.0.1:%d/" % p
            print("[工作台] 画布端口 %d 被别的程序占用，改用 %d" % (old, p), flush=True)
            return False
    return False


def _canvas_health(timeout=2.0):
    """画布自己的探活接口：/api/health 返回 {"ok":true,...}。"""
    try:
        r = urllib.request.urlopen(CANVAS_URL + "api/health", timeout=timeout)
        body = r.read(400).decode("utf-8", "ignore")
        return '"ok":true' in body.replace(" ", "")
    except Exception:                                            # noqa: BLE001
        return False


def ensure_canvas(wait=6.0):
    """画布没在跑就用 node 拉起；最多等 wait 秒。返回是否可用。"""
    global _CANVAS_PROC
    if os.environ.get("HERONBO_NO_CANVAS") == "1":
        return False
    if _canvas_health(2.0):
        return True
    _canvas_adopt_or_rebase()
    cdir = canvas_dir()
    if not os.path.isfile(os.path.join(cdir, "server.js")):
        print("[工作台] 画布工程不存在（找过：%s）" % " / ".join(_canvas_candidates()), flush=True)
        return False
    node = (_tool_paths() or {}).get("node") or shutil.which("node")
    if not node or not os.path.isfile(node):
        print("[工作台] 没找到 node（随包 runtime\\node 与 PATH 都没有），画布起不来", flush=True)
        return False
    logdir = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"),
                          "HeronBoScoreTool")
    try:
        os.makedirs(logdir, exist_ok=True)
    except OSError:
        pass
    logp = os.path.join(logdir, "canvas.log")
    env = os.environ.copy()
    env["PORT"] = str(CANVAS_PORT)
    env["HOST"] = "127.0.0.1"
    env["CANVAS_ROOT"] = _canvas_data_dir(cdir)
    env["DOUBAO_CDP_PORT"] = str(int(os.environ.get("HERONBO_DOUBAO_CDP_PORT") or 9333))
    _bridge = os.path.join(cdir, "vendor", "doubao_cdp.mjs") if os.path.isfile(os.path.join(cdir, "vendor", "doubao_cdp.mjs")) else os.path.join(HERE, "doubao_cdp.mjs")
    if os.path.isfile(_bridge):
        env["HERONBO_DOUBAO_CDP"] = _bridge
    with _CANVAS_LOCK:
        if _canvas_health(2.0):
            return True
        if _CANVAS_PROC is not None and _CANVAS_PROC.poll() is None:
            print("[工作台] 画布进程已在启动/运行中（pid %s）" % _CANVAS_PROC.pid, flush=True)
        else:
            lf = None
            try:
                lf = open(logp, "ab")
            except OSError:
                # canvas.log 偶尔被别的实例/杀软短暂锁住 → 不能因为写不了日志就放弃拉起画布
                try:
                    lf = open(os.path.join(os.environ.get("TEMP") or os.path.expanduser("~"),
                                           "HeronBoCanvas-%d.log" % os.getpid()), "ab")
                except OSError:
                    lf = None
            try:
                _CANVAS_PROC = subprocess.Popen(
                    [node, "server.js"], cwd=cdir, env=env,
                    stdout=(lf if lf is not None else subprocess.DEVNULL),
                    stderr=(lf if lf is not None else subprocess.DEVNULL),
                    creationflags=0x08000000 if os.name == "nt" else 0)
                print("[工作台] 拉起画布：%s（node=%s，data=%s）"
                      % (cdir, node, env["CANVAS_ROOT"]), flush=True)
            except Exception as e:                               # noqa: BLE001
                print("[工作台] 画布启动失败：%s" % e, flush=True)
                return False
            finally:
                try:
                    if lf is not None:
                        lf.close()
                except OSError:
                    pass
    t0 = time.time()
    while time.time() - t0 < wait:
        if _canvas_health(1.0):
            print("[工作台] 画布已起：%s（对外统一 /canvas/）" % CANVAS_URL, flush=True)
            return True
        time.sleep(0.6)
    print("[工作台] 画布没起来（日志 %s）" % logp, flush=True)
    return False


def _start_canvas_async():
    """启动工作台时异步拉画布。放线程里，别让 node 冷启动/杀软扫描挡住窗口。"""
    if os.environ.get("HERONBO_NO_CANVAS") == "1":
        return

    def _run():
        try:
            ensure_canvas(wait=15.0)
        except Exception:                                        # noqa: BLE001
            pass

    threading.Thread(target=_run, daemon=True).start()


def launch_web(root="", project="", hint="", port=0, wait=True, backend=None):
    """起服务 + 开界面窗口。

    窗口优先级（2026-09-15 起）：
      1. **pywebview 独立窗口**（内嵌 WebView2）——自己的窗口，不依赖用户的 Edge 浏览器；
      2. Edge 的 `--app=` 窗口——退路（独立窗口起不来时）；
      3. 默认浏览器打开 URL——最后的退路（至少能用）。
    `backend="edge"` 可强制走退路（排查用）。

    **已经开着一个就不开第二个**（2026-09-15 晚补）：两个实例会抢同一个 WebView2 数据目录
    （`%LOCALAPPDATA%\\HeronBoScoreTool\\webview`），第二个的 pywebview 报
    `0x8007139F 组或资源的状态不是执行请求操作的正确状态` 起不来 —— 双击两次快捷方式就会撞上
    （表现为"没反应"或另开一个 Edge 窗口）。所以动手前先看有没有活着的实例：有就把它的窗口
    叫到前面来（带了 --project 就顺手让它切过去），本进程直接退出。
    `HERONBO_NO_REUSE=1` 可强制另起一个（验证/排查用）。
    """
    import webbrowser
    _start_canvas_async()          # 画布跟工作台一起起；不挡窗口、失败也不影响工作台
    prev_hwnd, prev_port = (0, 0)
    if not os.environ.get("HERONBO_NO_REUSE"):
        prev_hwnd, prev_port = existing_instance()
    if prev_hwnd or prev_port:
        if project and os.path.isdir(project) and prev_port:
            try:
                _http_json(prev_port, "/api/project", {"dir": project})
            except (OSError, ValueError):
                pass
        if prev_hwnd and focus_window(prev_hwnd):
            print("[创作台] 已经开着一个了，把它叫到前面来（端口 %s）" % (prev_port or "?"),
                  flush=True)
        elif prev_port:
            webbrowser.open("http://127.0.0.1:%d/" % prev_port)
            print("[创作台] 已经开着一个了，用浏览器打开它（端口 %d）" % prev_port, flush=True)
        else:
            focus_window(prev_hwnd)
            print("[创作台] 已经开着一个了（没找到窗口句柄）", flush=True)
        return None, ("http://127.0.0.1:%d/" % prev_port if prev_port else ""), "reuse"
    if project and os.path.isdir(project):
        write_proj(project)
    elif hint:
        r = root or detect_root()
        for s_ in _samples(r):
            if hint in s_["name"]:
                write_proj(s_["dir"])
                break
    srv = serve(root=root or "", port=port or DEFAULT_PORT)   # 平时固定端口：偏好才留得住；--port 显式指定时不覆盖
    url = "http://127.0.0.1:%d/" % srv.server_address[1]
    write_proj(read_proj(), port=srv.server_address[1])
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    Handler.last_ping = time.time()
    print("[创作台] %s" % url, flush=True)
    # 只要服务、不要窗口（给"别的程序用 API 驱动创作台"与自动化验证用）
    if os.environ.get("HERONBO_NO_WINDOW"):
        print("[创作台] HERONBO_NO_WINDOW=1：只起服务、不开窗口", flush=True)
        if wait:
            wait_and_exit(srv, idle=24 * 3600)      # 没人点页面也不退，等调用方喊停
        return srv, url, "headless"
    ok_wv2, wv2ver, wv2why = webview2_state() if backend != "edge" else (True, "", "指定走 Edge")
    if backend != "edge":
        _wv2_report(ok_wv2, wv2ver, wv2why)
    # 预检不过就**根本不试**独立窗口：坏的运行库只会给你一个白窗，不如直接退 Edge（2026-09-16）
    if backend != "edge" and ok_wv2 and native_window(WIN_TITLE, url):
        srv.shutdown()                 # 窗口关了 → 收摊（不用再靠心跳判断）
        return srv, url, "native"
    # 窗口起不来、而起之前就已经有一个在跑 → 就是它占着 WebView2 的数据目录：别再开 Edge 窗口
    if prev_hwnd or prev_port:
        srv.shutdown()
        if prev_hwnd:
            focus_window(prev_hwnd)
        print("[创作台] 第二个窗口起不来（已有一个在跑），已把它叫到前面来", flush=True)
        return srv, url, "reuse"
    # 退路：Edge app 窗口
    exe = find_edge()
    proc = None
    if exe:
        prof = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"),
                            "HeronBoScoreTool", "webprofile")
        try:
            os.makedirs(prof, exist_ok=True)
        except OSError:
            pass
        try:
            import subprocess as _sp
            proc = _sp.Popen(
                [exe, "--app=" + url, "--user-data-dir=" + prof,
                 "--window-size=1520,940", "--no-first-run",
                 "--no-default-browser-check", "--disable-features=Translate,msEdgeSidebarV2",
                 "--disable-session-crashed-bubble"],
                **({"creationflags": 0x08000000} if os.name == "nt" else {}))
        except OSError:
            proc = None
    if proc is None:
        try:
            webbrowser.open(url)
        except Exception:                                        # noqa: BLE001
            pass
    if wait:
        wait_and_exit(srv)
        try:
            if proc is not None and proc.poll() is None:
                proc.terminate()
        except OSError:
            pass
    return srv, url, "edge" if proc is not None else "browser"


