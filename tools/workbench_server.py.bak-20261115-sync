# 这里把"这一轮是谁、在哪个项目、agent 进程 PID、从什么时候开始"写进 TEMP，
# 新进程启动时先读回：agent 还活着就接回状态（并挡住新任务），死了才清掉。
def _job_file():
    return os.path.join(os.environ.get("TEMP") or os.environ.get("TMP") or ".", "heronbo_job.json")


def _read_job():
    try:
        with open(_job_file(), encoding="utf-8") as f:
            obj = json.load(f)
        return obj if isinstance(obj, dict) else {}
    except (OSError, ValueError):
        return {}


def _write_job(obj):
    try:
        p = _job_file()
        tmp = p + ".part"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(obj, f, ensure_ascii=False)
        os.replace(tmp, p)
    except OSError:
        pass


def _clear_job(job_id=None, force=False):
    """清掉任务文件；默认只清自己的那一轮，避免两个实例互删。"""
    cur = _read_job()
    if not cur:
        return
    if not force:
        if cur.get("owner_pid") not in (0, os.getpid()):
            return
        if job_id is not None and cur.get("job") not in (None, job_id):
            return
    try:
        os.remove(_job_file())
    except OSError:
        pass


def _set_job_agent(pid):
    cur = _read_job()
    if cur.get("owner_pid") != os.getpid():
        return
    cur["agent_pid"] = int(pid or 0)
    _write_job(cur)


def _job_snapshot():
    """返回仍在跑/仍被占用的上一轮任务；已经死透的就顺手清掉。"""
    j = _read_job()
    if not j:
        return None
    agent_pid = int(j.get("agent_pid") or 0)
    owner_pid = int(j.get("owner_pid") or 0)
    if agent_pid and _pid_alive(agent_pid):
        return j
    if owner_pid and owner_pid != os.getpid() and _pid_alive(owner_pid):
        return j                          # 另一个还活着的创作台实例占着这一轮
    _clear_job(force=True)
    return None


def _kill_job_process(pid):
    pid = int(pid or 0)
    if pid <= 0:
        return False
    try:
        if os.name == "nt":
            r = subprocess.run(["taskkill", "/PID", str(pid), "/T", "/F"],
                               capture_output=True, text=True, errors="replace",
                               timeout=20, creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
            return r.returncode == 0
        os.kill(pid, 9)
        return True
    except (OSError, subprocess.SubprocessError):
        return False


def _recover_job(port=None):
    """新服务启动时接回上一轮仍在后台跑的 agent。"""
    j = _job_snapshot()
    if not j:
        return
    if port and j.get("port") and int(j.get("port") or 0) != int(port):
        return                                  # 这份任务属于另一个端口/实例，别接错
    pid = int(j.get("agent_pid") or 0)
    if not pid:
        return
    with _PROG_LOCK:
        _PROG.update({"job": 1, "stage": 0, "pct": 0,
                      "lines": ["· 接回上一轮：创作台关掉时任务还在后台跑（PID %d），"
                                "没有重新拉起，等它跑完或点「暂停」" % pid],
                      "done": False, "ok": None, "text": "",
                      "t0": float(j.get("t0") or time.time()), "running": True,
                      "pdir": j.get("pdir") or "", "what": j.get("what") or "absorb",
                      "trigger": "接回", "active": [], "warn": "", "chan": "",
                      "events": [], "stages": STAGE_NAMES.get(j.get("what") or "absorb"),
                      "detached_pid": pid})

    def _watch():
        while _pid_alive(pid):
            time.sleep(2)
        with _PROG_LOCK:
            if _PROG.get("detached_pid") == pid:
                _PROG.update({"running": False, "done": True, "ok": None,
                              "text": "上一轮已在后台结束（创作台关着的时候跑完的）",
                              "lines": (_PROG.get("lines") or []) + ["· 上一轮已结束，状态已接回"]})
                _PROG.pop("detached_pid", None)
        _clear_job(force=True)

    threading.Thread(target=_watch, daemon=True).start()
