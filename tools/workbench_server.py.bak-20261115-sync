# ── 安全边界：所有"按客户端给的路径动文件"的入口共用这一组判断 ─────────────
# 2026-11 QA 实测：delete_project / new_project / heal_skeleton / open_file /
# serve_video_file 各自只看 isdir/isfile，跨站 POST 就能删库外目录、建库外项目、
# 打开/读取库外文件。这里统一成"项目库根 / 项目根"两级白名单，别再各写一套 startswith。
def _norm_path(p):
    try:
        return os.path.normcase(os.path.normpath(os.path.realpath(os.path.abspath(str(p or "")))))
    except OSError:
        return os.path.normcase(os.path.normpath(os.path.abspath(str(p or ""))))


def _inside(root, path):
    """path 是否等于 root 或位于 root 之下（不允许用 `..\\` 或软链接绕出去）。"""
    r, p = _norm_path(root), _norm_path(path)
    return bool(r and p and (p == r or p.startswith(r + os.sep)))


def _safe_project_name(name):
    """单层目录名；带 /、\\ 或 Windows 非法字符的候选名一律拒绝。"""
    s = str(name or "").strip().replace("\\", "/")
    if "/" in s:
        return ""
    s = re.sub(r'[<>:"|?*\x00-\x1f]', "", s).strip(" ._-")
    if s in ("", ".", ".."):
        return ""
    return s[:80]


