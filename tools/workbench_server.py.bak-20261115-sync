        if not video:
            return {"ok": False, "error": "先选一条成片再打分（空项目/没点片子不能生成评价）"}
        if not os.path.isdir(os.path.join(pdir, "成片")) or not os.listdir(os.path.join(pdir, "成片")):
            return {"ok": False, "error": "这个项目还没有成片，先收成片再打分"}
        try:
            p = score.save(root, sample, video, rev.get("六维") or {},
                           rev.get("违禁项") or {}, rev.get("整体评分") or 4,
                           rev.get("结论") or "可改", rev.get("备注") or "")
        except Exception as e:                                   # noqa: BLE001
            log_exc(pdir, "保存评分")
            return {"ok": False, "error": str(e)}
        # 打分＝一条要读的提交：进信箱 + 立刻叫 agent 去读（2026-09-17 用户要求）
        try:
            flags = [k for k, v in (rev.get("违禁项") or {}).items() if v and v != "无"]
            inbox_append(pdir, "评分",
                         "%s · 整体 %s 星 · 结论 %s%s%s" % (
                             video or "（未点名片子）", rev.get("整体评分") or "?",
                             rev.get("结论") or "?", ("，违禁项：" + "、".join(flags)) if flags else "",
                             ("，备注：" + rev["备注"]) if rev.get("备注") else ""),
                         extra="六维 " + "、".join("%s=%s" % (k, v) for k, v in
                                                 (rev.get("六维") or {}).items() if v))
        except Exception as e:                                   # noqa: BLE001
            log_exc(pdir, "写信箱（评分）")
            _invalidate_samples(root)
            return {"ok": True, "file": p, "inbox": {"queued": False, "n": 0, "why": str(e)}}
        _invalidate_samples(root)
        return {"ok": True, "file": p, "inbox": pump_inbox(pdir, "评分")}

    def sse(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        since = 0
        try:
            while True:
                snap = progress_snapshot(since)
                since = snap["n"]
                payload = json.dumps(snap, ensure_ascii=False)
                self.wfile.write(("data: %s\n\n" % payload).encode("utf-8"))
                self.wfile.flush()
                Handler.last_ping = time.time()
                if snap["done"] and not snap["running"]:
                    time.sleep(0.6)
                    self.wfile.write(b"data: {\"bye\": true}\n\n")
                    self.wfile.flush()
                    break
                time.sleep(0.7)
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass


