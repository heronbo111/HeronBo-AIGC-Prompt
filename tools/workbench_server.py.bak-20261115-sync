def _same_origin(req):
    """挡住浏览器里的跨站 POST（CSRF）。

    创作台只监听 127.0.0.1，但任意网页都能向它发 POST；原实现完全不看来源，
    `/api/project/delete` 这类动作就能被跨站触发。带 Origin 的请求必须与 Host 同源；
    没有 Origin 的 curl / 自动化脚本不受影响（本机调试仍可用）。
    """
    origin = (req.headers.get("Origin") or "").strip()
    if origin:
        try:
            o = urllib.parse.urlparse(origin)
            if (o.netloc or "").lower() != (req.headers.get("Host") or "").lower():
                return False
        except ValueError:
            return False
    site = (req.headers.get("Sec-Fetch-Site") or "").strip().lower()
    if site and site not in ("same-origin", "none"):
        return False
    return True


