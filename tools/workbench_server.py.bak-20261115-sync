    def wb_feedback(self, b):
        """给**创作台本身**提意见（借鉴文影AI 的"用户反馈"：类型/紧急度/联系方式）。

        落到 `<项目库>/_工作台反馈/<时间>-<类型>.md`——不进项目、不进 git。
        **并且要投递到维护者**（2026-09-17 用户要求：反馈是版本迭代的输入，
        不能留在每个用户的本机）：配了发信账号就直发；没配就写一条 pending 投递记录，
        等 agent 代发（`_工作台反馈/_投递.jsonl`，SKILL.md 里写了 agent 的义务）。
        """
        kind = (b.get("kind") or "产品建议").strip()
        urgent = (b.get("urgent") or "普通建议").strip()
        text = (b.get("text") or "").strip()
        contact = (b.get("contact") or "").strip()
        if not text:
            return {"ok": False, "error": "还没写内容"}
        root = Handler.root or detect_root() or os.path.expanduser("~")
        d = os.path.join(root, "_工作台反馈")
        # 类型里可能带 / 这种文件名非法字符（"不好用/出错"实测会写盘失败）→ 换成 _ 再拼文件名
        safe = re.sub(r'[\\/:*?"<>|\s]+', "_", kind).strip("_") or "反馈"
        stamp = time.strftime("%Y-%m-%d %H:%M")
        ver = (build_info() or {}).get("stamp", "")
        to = feedback_mail_to()
        subject = "[创作台反馈] %s · %s" % (kind, urgent)
        body = ("类型：%s\n紧急度：%s\n联系：%s\n时间：%s\n版本：%s\n创作台：%s\n\n%s\n"
                % (kind, urgent, contact or "（未填）", stamp, ver,
                   (build_info() or {}).get("path", ""), text))
        try:
            os.makedirs(d, exist_ok=True)
            fn = os.path.join(d, "%s-%s.md" % (time.strftime("%Y%m%d-%H%M%S"), safe))
            with open(fn, "w", encoding="utf-8", newline="\n") as f:
                f.write("# 创作台反馈 · %s\n\n"
                        "- 类型：%s\n"
                        "- 紧急度：%s\n"
                        "- 联系：%s\n"
                        "- 时间：%s\n"
                        "- 版本：%s\n"
                        "- 投递：%s\n\n"
                        "%s\n"
                        % (kind, kind, urgent, contact or "（未填）", stamp, ver, to, text))
        except OSError as e:
            return {"ok": False, "error": "写不进：%s" % e}
        # 投递（2026-10-07 用户裁定）：配了 feedback.local.json 就服务端 SMTP 直发，
        # 不再弹浏览器投递页；没配/发失败才退回老的投递页（mailto 手动发）兜底。
        # 2026-10-09 改成**后台线程发**：SMTP 直发实测要十几秒（126/465 慢），
        # 原先同步发卡在 HTTP 处理线程里，前端连接被掐断、响应丢了——用户看到
        # 「提交按钮点不动」，实际邮件每次都发出去了（一秒一点就发一封）。
        # 现在文件落盘后立刻返回，邮件在后台慢慢发；发没发成写进 _投递.jsonl 可查。
        cfg = read_feedback_local()
        if cfg:
            to_addr = cfg.get("to") or to
            rec = {"time": stamp, "file": os.path.basename(fn), "to": to_addr,
                   "subject": subject, "sent": False, "error": ""}
            def _deliver():
                ok2, err2 = smtp_send_feedback(cfg, to_addr, subject, body)
                rec["sent"], rec["error"] = ok2, (err2 or "")
                try:
                    with open(os.path.join(d, "_投递.jsonl"), "a", encoding="utf-8") as f:
                        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
                except OSError:
                    pass
            threading.Thread(target=_deliver, daemon=True).start()
            return {"ok": True, "file": fn, "to": to_addr, "sent": True,
                    "queued": True, "subject": subject}
        # 老兜底：打开本机投递页（浏览器）：页面上有正文 + 一键 mailto + 一键复制，
        # 用户在浏览器里手动点发送——不依赖任何发信凭据，也不依赖 agent 有没有邮箱。
        url = ""
        try:
            url = feedback_send_url(self.server.server_address[1], fn)
            webbrowser.open(url)
        except Exception:                                         # noqa: BLE001
            url = ""
        return {"ok": True, "file": fn, "to": to, "url": url, "subject": subject,
                "body": body, "sent": False}

    def feedback_send_page(self, qs):
        """投递页：渲染成「点一下就发邮件」的页面（只认 <项目库>/_工作台反馈/ 下的文件）。"""
        f = (qs.get("f") or [""])[0]
        root = Handler.root or detect_root() or ""
        d = os.path.join(root, "_工作台反馈")
        text = ""
        try:
            real = os.path.realpath(f)
            if os.path.isfile(real) and os.path.realpath(d) == os.path.dirname(real):
                with open(real, encoding="utf-8-sig") as fh:
                    text = fh.read()
        except (OSError, ValueError):
            text = ""
        if not text:
            return ("<!DOCTYPE html><meta charset='utf-8'><body style='font:14px/1.7 "
                    "sans-serif;padding:40px'>找不到这条反馈（可能已被移走）。"
                    "<a href='/'>回到创作台</a></body>").encode("utf-8"), \
                   "text/html; charset=utf-8"
        to = feedback_mail_to()
        body = text
        subject = "[创作台反馈]"
        if text.startswith("# "):
            first, _sep, rest = text.partition("\n\n")
            subject = first.strip()
            body = rest or text
        from urllib.parse import quote as _q
        mailto = ("mailto:%s?subject=%s&body=%s"
                  % (to, _q(subject), _q(body[:1800])))
        page = (FEEDBACK_SEND_PAGE.replace("__MAILTO__", mailto).replace("__TO__", to)
                .replace("__FILE__", f).replace("__BODY__", body))
        return page.encode("utf-8"), "text/html; charset=utf-8"

    def save_need(self, b):
        """用户的「简单需求」：写进 框架.json→project.need 与 备注/需求.txt。

        为什么要落盘：agent 出提示词/复核归类时都读 框架.json 与 备注/，需求必须跟项目在一起，
