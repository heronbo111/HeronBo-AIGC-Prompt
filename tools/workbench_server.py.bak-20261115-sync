            except Exception:                                    # noqa: BLE001
                pass
    if sid and _sess_of and _k and _sess_of != _k:
        _switched = "%s → %s" % ((abridge.ADAPTERS.get(_sess_of) or {}).get("label", _sess_of),
                                 (abridge.ADAPTERS.get(_k) or {}).get("label", _k))
        sid = ""
    if (read_ui() or {}).get("sessionMode") == "fresh":
