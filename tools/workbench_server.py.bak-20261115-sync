            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)
            return
        # 静态文件
        rel = "index.html" if path in ("/", "") else path.lstrip("/")
        # React 路由页没有实体文件（如侧栏「流程指挥台」打开 /flow-board）：回落 SPA 首页，
        # 由前端路由（app.tsx 里的 flow-board / flow-board/index.html）渲染，避免整页 404。
        if rel.rstrip("/") in ("flow-board", "flow-board/index.html"):
