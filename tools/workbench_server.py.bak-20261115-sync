    # ---- POST ----
    def do_POST(self):
        if not _same_origin(self):
            return self._json({"ok": False, "error": "跨站请求已拒绝（Origin 与服务不同源）"}, 403)
        if self._proxy_canvas():
            return
        path = urllib.parse.urlparse(self.path).path
        if path == "/api/_dbg/eval":
            # 与 do_GET 里那个同款（调试专用，仅 HERONBO_DRAG_DEBUG=1 时启用）
            if not os.environ.get("HERONBO_DRAG_DEBUG"):
                self.send_error(404)
                return False
            try:
                n = int(self.headers.get("Content-Length") or 0)
                code = json.loads(self.rfile.read(n).decode("utf-8")).get("code") or ""
                r = _WIN.evaluate_js(code) if _WIN is not None else None
                self._json({"ok": True, "result": r})
            except Exception as e:                                   # noqa: BLE001
                self._json({"ok": False, "error": repr(e)})
            return False
        if path == "/api/ping":
            Handler.last_ping = time.time()
            # agent 的「待确认问题」指纹（2026-10-09 用户报"提问不能实时传达、很多是延后的"）：
            # 心跳顺带把它捎回去，前端一发现变了就立刻弹窗。
            # 为什么必须放在心跳里：原来只有 SSE 活着时（＝agent 正在跑）才每 6 秒查一次问题，
            # 而 agent 恰恰是**收尾时**才写 `_会话/待确认.json`——那时 SSE 已经关掉、轮询停了，
            # 问题只能干等下一次切项目/点刷新才弹出来。心跳是常驻的，拿它当触发器就实时了。
            qk = ""
            try:
                _pd = self._proj()
                if _pd and os.path.isdir(_pd):
                    _its = (read_questions(_pd).get("items") or [])
                    if _its:
                        qk = "|".join(str(x.get("q") or "") for x in _its)[:200]
            except Exception:                                        # noqa: BLE001
                qk = ""
            # 常驻显示（2026-09-21 用户要求）：心跳顺带带回「agent 在不在跑、正在干什么」。
            # 前端把它写进 body 的 data-*，底部状态条以它为准——进度区没亮（后端自动起的轮、
            # 页面刚开、SSE 没接上）底部条也照样显示，不再漏报。
            s = progress_snapshot()
            if s.get("running") and not s.get("done"):
                evs = s.get("events") or []
                now = ""
                if evs:
                    e = evs[-1]
                    now = ((e.get("icon") or "") + " " + (e.get("label") or "") + " "
                           + str(e.get("text") or "")[:96]).strip()
                return self._json({"ok": True, "qk": qk, "job": {
                    "running": True, "what": s.get("what") or "",
                    "stageName": s.get("stageName") or "",
                    "now": now or s.get("warn") or "",
                    "pct": s.get("pct") or 0, "elapsed": s.get("elapsed") or 0}})
            return self._json({"ok": True, "qk": qk, "job": {"running": False}})
        if path == "/api/project":
            b = self._body()
            d = b.get("dir") or ""
            root0 = Handler.root or detect_root()
            if d and os.path.isdir(d) and root0 and _inside(root0, d) \
                    and os.path.normcase(_norm_path(d)) != os.path.normcase(_norm_path(root0)):
                self._set_proj(d)
                return self._json({"ok": True, "project": _scan_project(d),
                                   "healed": self.heal_skeleton(d)})
            return self._json({"ok": False, "error": "目录不存在或不在当前项目库下：%s" % d}, 400)
        if path == "/api/project/new":
            return self._json(self.new_project(self._body()))
        if path == "/api/canvas/import":
            # 2026-11-06 第1步：把选中的画布素材复制进当前项目，画布存储不动。
            return self._json(self.canvas_import(self._body()))
        if path == "/api/project/delete":
            return self._json(self.delete_project(self._body()))
        if path == "/api/fields":
