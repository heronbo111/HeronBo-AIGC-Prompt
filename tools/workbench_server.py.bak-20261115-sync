        sk.setdefault("project", {})["allowExtra"] = allowed
        sk["project"]["forbidExtra"] = not allowed          # 兼容旧字段的语义：清单空＝全禁
        pcore.save_skeleton(pdir, sk)
        try:
            d = os.path.join(pdir, "备注")
