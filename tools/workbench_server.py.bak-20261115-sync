            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            return self._json(read_record(self._proj(), (q.get("name") or [""])[0]))
        if path.startswith("/api/upload/") and path.endswith("/open"):
            return self._json({"skip": True})
        if path == "/favicon.ico":
            # 2026-11-03：原来这里返回 204，浏览器标签页一直没有图标。
            # 现在直接回 tools/工作台.ico，和安装包/快捷方式/任务栏用同一张图。
            fav = os.path.join(HERE, "工作台.ico")
            try:
                with open(fav, "rb") as fh:
