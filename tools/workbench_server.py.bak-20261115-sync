    # 组名带「素材/」前缀区分；没有原始夹时行为与以前完全一样。
    def _list_up_dir(up, prefix=""):
        if not os.path.isdir(up):
            return
        for fn in sorted(os.listdir(up)):
            p = os.path.join(up, fn)
            if os.path.isfile(p):
                try:
                    out["uploads"].append({"name": prefix + fn, "size": os.path.getsize(p)})
                except OSError:
                    out["uploads"].append({"name": prefix + fn, "size": 0})
            elif os.path.isdir(p):
                group = {"ver": prefix + fn, "dir": p, "files": [], "size": 0}
                for f2 in sorted(os.listdir(p)):
                    fp = os.path.join(p, f2)
                    if os.path.isfile(fp):
                        try:
                            sz = os.path.getsize(fp)
                        except OSError:
                            sz = 0
                        group["files"].append({"name": f2, "size": sz})
                        group["size"] += sz
                out["uploadGroups"].append(group)
    _list_up_dir(pcore.upload_dir(pdir) if pcore else os.path.join(pdir, "平台上传"))
    _src = pcore.upload_src_dir(pdir) if pcore else os.path.join(pdir, "素材", "平台上传")
    if _src and os.path.isdir(_src):
        _list_up_dir(_src, prefix="素材/")
    out["uploadGroups"].sort(key=lambda g: g["ver"])
    return out


# ── 产物 ≠ 素材（2026-09-19 用户要求）────────────────────────────────────
# 「提示词 / 口播稿 / 上传说明 / 需求」这些是**产出与文稿**，不是素材——它们出现在
# ②栏「素材识别」里，用户会以为要拿去当参考图，而且"产物和素材混一块"本身就不对。
# 这里只按文件名挡掉这一类（文件本身不动，只是不进素材/待投放列表）。
_OUTPUT_NAME_RE = re.compile(
    r"^(提示词|提示词正文|口播稿|文案稿|上传说明|需求|备注|框架|状态)"
    r"([._-].*)?\.(txt|md|json)$", re.IGNORECASE)


def is_output_name(name):
    return bool(_OUTPUT_NAME_RE.match((name or "").strip()))


_HASH_IDX = {"at": 0.0, "map": {}}


def _hash_index(root):
    """跨项目「同源」索引：hash 前缀 → 出现过的项目名。120 秒缓存（别每轮重扫全库）。"""
    if root and (time.time() - _HASH_IDX["at"]) < 120 and _HASH_IDX["map"]:
        return _HASH_IDX["map"]
    m = {}
    try:
        for d in sorted(os.listdir(root)):
            p = os.path.join(root, d, "框架.json")
            if not os.path.isfile(p):
                continue
            try:
                proj = (json.load(open(p, encoding="utf-8-sig")) or {}).get("project") or {}
            except Exception:                                    # noqa: BLE001
                continue
            for mm in (proj.get("materials") or []):
                h = (mm.get("hash") or "")[:20]
                if h:
                    m.setdefault(h, set()).add(d)
    except Exception:                                            # noqa: BLE001
        pass
    _HASH_IDX["at"] = time.time()
    _HASH_IDX["map"] = m
    return m


def materials_brief(pdir, limit=14):
    """给 agent 的**素材速览**（程序按入库信息算好）。

    为什么要它：agent 每轮为弄清"这是哪件、多长、跟别处是不是同一个文件"，会自己跑
    `md5sum`、`ffprobe`、列目录——实测一轮 2–4 次工具调用，而 框架.json 入库时**已经算好**
    hash / 时长 / 分辨率。这里直接递给它。
    """
    fp = os.path.join(pdir, "框架.json")
    if not os.path.isfile(fp):
        return ""
    try:
        json.load(open(fp, encoding="utf-8-sig"))     # 这里只验文件能读，素材从 cur_materials 取
    except Exception:                                            # noqa: BLE001
        return ""
    # **只给当前版的素材**（rules 71）：@编号在本版内独立算——绝不把别的版本的素材递给 agent，
    # 否则它会把两版的原片都摆出来、或拿错驱动片（2026-09-21 实测青海摇两版就是这个问题）。
    mats = cur_materials(pdir)
    if not mats:
        return ""
    try:
        root = pcore.detect_root(None) or ""
    except Exception:                                            # noqa: BLE001
        root = ""
    hidx = _hash_index(root) if root else {}
    me = os.path.basename(os.path.normpath(pdir))
    lines = []
    _cnt = {}
    for m in mats[:limit]:
        # 2026-09-21：这里必须写 @编号 —— 今天新加的速览块按文件名列出，agent 就照写成"图片1"、
        # 正文里一个 @ 都没有（用户实测："生成的提示词没有 @ 符号了"）。@图片1 是平台认的引用语法。
        _kind = {"image": "图片", "video": "视频", "audio": "音频", "text": "文本"}.get(m.get("type"))
        if _kind:
            _cnt[_kind] = _cnt.get(_kind, 0) + 1
        _at = "@%s%d" % (_kind, _cnt[_kind]) if _kind else ""
        bits = [("%s = " % _at if _at else "") + (m.get("name") or m.get("file") or "?")]
        bits.append({"image": "图片", "video": "视频", "audio": "音频", "text": "文本"}
                    .get(m.get("type"), m.get("type") or "?"))
        sz = m.get("size")
        bits.append("%.1fMB" % (int(sz) / 1048576.0) if str(sz or "").isdigit() else "?")
        dur, w, h = m.get("duration"), m.get("width"), m.get("height")
        if dur:
            bits.append("%ss" % dur)
        if w and h:
            bits.append("%sx%s" % (w, h))
        if m.get("role"):
            bits.append("role=%s" % m["role"])
        # 文件不在原位（rules 78）：说清实体在哪——记录永不自动删，agent 也不许当它不存在
        _rel = (m.get("file") or "").replace("\\", "/")
        if _rel and not os.path.isfile(os.path.join(pdir, _rel.replace("/", os.sep))):
            _mv = ""
            try:
                _mv = pcore.find_elsewhere(pdir, _rel) if pcore else ""
            except Exception:                                    # noqa: BLE001
                _mv = ""
            bits.append("⚠ 不在原位" + (("（实体在 `%s`）" % _mv) if _mv else "（项目里找不到同名）"))
        others = sorted((hidx.get((m.get("hash") or "")[:20]) or set()) - {me})
        if others:
            bits.append("**与 %d 个项目同源**（%s）" % (len(others), "、".join(others[:3])))
        lines.append("  · " + " ｜ ".join(str(b) for b in bits))
    if len(mats) > limit:
        lines.append("  · …还有 %d 件" % (len(mats) - limit))
    return "\n".join(lines)


# ── 版本：一套完整快照（2026-09-21 用户构想，见 rules 第 71 条）──────────────────
# 「③栏新建一个版本 → ②栏同步开出这一版的素材夹接收素材 → 照旧归类 → ③栏出新提示词」。
# 关键：**@引用编号在本版素材内独立计算**——两版各有素材夹，就不会再出现
# 「同一个 @视频1 在两版指不同文件」「同类型有两条素材、编号只够表达一条」。
#
# 兼容（老项目零迁移）：`project.versions` 缺省 ⇒ 只有「默认版」——素材在 `素材/` 根下
# （它的 dir 记空串＝不单独分夹）、正文在 `文案/`。老项目、以及没建过版本的项目都是它。
#
# 谁是权威：**`project.materials` 永远等于「当前版」的素材清单** —— 所以下面十几处读取点
# 一行都不用改；`versions[i].materials` 是各版快照，切版/排序/删除时与它同步。
# 正文同理：`文案/提示词*.txt` 是当前版，历史每版一条留在 `project.prompts[]`（带版本名）。
VER_DEFAULT = ""          # 默认版的 dir：素材不分子目录（就在 素材/ 下）
_VER_BAD = '\\/:*?"<>|'   # 版本名里不许出现的字符（它要当目录名）


def _load_proj(pdir):
    """读 框架.json → (sk, project)；读不到给 (None, {})。"""
    if not (pcore and pdir):
        return None, {}
    try:
        sk = pcore.load_skeleton(pdir)
    except Exception:                                            # noqa: BLE001
        return None, {}
    if not isinstance(sk, dict):
        return None, {}
    return sk, (sk.get("project") or {})


def versions_of(pdir):
    """版本清单（老项目没建过 ⇒ 空列表 ＝ 只有默认版）。"""
    _sk, proj = _load_proj(pdir)
    vs = proj.get("versions")
    return [v for v in vs if isinstance(v, dict)] if isinstance(vs, list) else []


def cur_ver_name(pdir):
    """当前版名；没建过版本 ⇒ 空串（＝默认版）。名字对不上就退回清单最后一项。"""
    vs = versions_of(pdir)
    if not vs:
        return ""
    _sk, proj = _load_proj(pdir)
    names = [v.get("name") or "" for v in vs]
    cur = (proj.get("current") or "").strip()
    return cur if cur in names else names[-1]


def cur_ver(pdir):
    """当前版的版本记录（默认版 ⇒ None）。"""
    n = cur_ver_name(pdir)
    if not n:
        return None
    for v in versions_of(pdir):
        if (v.get("name") or "") == n:
            return v
    return None


def cur_mats_sub(pdir):
    """当前版素材夹（相对项目根、正斜杠）。**新素材落这里。**"""
    v = cur_ver(pdir)
    if v is None:
        return "素材"
    d = v.get("dir")
    if d == VER_DEFAULT:
        return "素材"                                   # 默认版：不分子目录
    return "素材/" + (d or v.get("name") or "")


def cur_mats_dir(pdir):
    """当前版素材夹的绝对路径。"""
    return os.path.join(pdir, cur_mats_sub(pdir).replace("/", os.sep))


def cur_materials(pdir):
    """当前版的素材清单。默认版＝`project.materials`，命名版本＝该版自己的那份。"""
    if not (pdir and os.path.isdir(pdir)):
        return []
    v = cur_ver(pdir)
    if v is None:
        _sk, proj = _load_proj(pdir)
        src = proj.get("materials")
    else:
        src = v.get("materials")
    return [m for m in src if isinstance(m, dict)] if isinstance(src, list) else []


def _sync_cur_mats(sk, mats):
    """把「当前版」的素材清单写进 sk：`project.materials` ＋ `versions[]` 里同名那条。

    两处必须一致（前者是 19 处读取点认的权威、后者是版本快照），否则切版会丢改动。
    """
    proj = sk.setdefault("project", {})
    proj["materials"] = mats
    vs = proj.get("versions")
    if not isinstance(vs, list) or not vs:
        return                                          # 还没建过版本 → 只有一处要写
    names = [v.get("name") or "" for v in vs if isinstance(v, dict)]
    cur = (proj.get("current") or "").strip()
    if cur not in names:
        cur = names[-1] if names else ""
        proj["current"] = cur
    for v in vs:
        if isinstance(v, dict) and (v.get("name") or "") == cur:
            v["materials"] = mats


_DROP_TYPE_EXT = {}
for _e in ("png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff", "heic"):
    _DROP_TYPE_EXT[_e] = "image"
for _e in ("mp4", "mov", "mkv", "avi", "webm", "flv", "m4v", "wmv", "mpg", "mpeg"):
    _DROP_TYPE_EXT[_e] = "video"
for _e in ("mp3", "wav", "m4a", "aac", "flac", "ogg", "wma"):
    _DROP_TYPE_EXT[_e] = "audio"
for _e in ("txt", "md", "markdown", "csv", "srt", "ass", "json"):
    _DROP_TYPE_EXT[_e] = "text"        # 文本也入册：②栏能列、能定 role、能 @文本N


def register_dropped(pdir, fp):
    """拖进来的文件落盘后**立刻入册**（2026-11-10）：不然后端算 @编号时根本没这件。

    用户原话「对话框还是不能 @ 引用拖进去的素材」——真因就在这里：`/api/upload` 把字节
    写进了当前素材夹、也记进了待投递清单，但**没写进 框架.json 的 materials**，而 ②栏的
    @ 选择器与 `materials_brief` 的 @编号都只认 materials。结果拖完素材打 @ 一片空白，
    非得先跑一轮「建框架 + 识别」才挑得到。

    角色先写「待识别」：识别那一轮由 agent 按内容改名/定角色时覆盖，不会挡它干活。
    """
    if not (pcore and pdir and fp and os.path.isfile(fp)):
        return False
    ext = os.path.splitext(fp)[1].lower().lstrip(".")
    typ = _DROP_TYPE_EXT.get(ext, "")
    if not typ:
        return False                     # 文本/文档不进 @编号（与 brief 口径一致）
    try:
        sk, _proj = _load_proj(pdir)
    except Exception:                    # noqa: BLE001
        return False
    if not isinstance(sk, dict):
        return False
    mats = list(cur_materials(pdir))
    rel = os.path.relpath(fp, pdir).replace("\\", "/")
    for m in mats:
        if str(m.get("file") or "").replace("\\", "/") == rel:
            return False                 # 已经在册
    used = {str(m.get("id") or "") for m in mats}
    i = len(mats) + 1
    while ("M%d" % i) in used:
        i += 1
    try:
        sz = os.path.getsize(fp)
    except OSError:
        sz = 0
    mats.append({
        "id": "M%d" % i, "file": rel, "name": os.path.basename(fp), "type": typ,
        "srcPath": "", "role": "待识别",
        "addedAt": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "tags": [], "note": "", "size": sz,
    })
    _sync_cur_mats(sk, mats)
    try:
        pcore.save_skeleton(pdir, sk)
    except Exception:                    # noqa: BLE001
        return False
    return True


def _ver_no(name):
    """从版本名里取版本序号（`v2 换服装` / `版本2·xx` / `V2` → "2"）；取不到给空串。

    为什么要它：交付时「版本名 + refs + 正文」是 agent 写进 `prompts[]` 的，而版本记录在
    `versions[]`——两边名字不会逐字相同（一边「v2 换服装」、一边「版本2 · 换服装」），
    靠序号才能对上，③栏的「引用对照」才显示得出来。
    """
    m = re.search(r"(?:^|[^0-9A-Za-z])(?:v|ver|version|版本)\s*(\d+)", str(name or ""), re.I)
    return m.group(1) if m else ""


_REFFILE = re.compile(r"[^\s，。、（）()\[\]【】\"']+\.(?:mp4|mov|mkv|avi|png|jpe?g|webp|mp3|wav|m4a|txt|md)", re.I)


def _ref_missing(refs, files):
    """refs 里**点名了文件**、但本版素材里没这个文件 → 列出来（提示"这一版指不到实物"）。

    只认带扩展名的文件名：`refs` 是自由文字，像「原片人声 8s 整条」「参考它那条」这种纯描述
    不算缺——太宽松会满屏黄条，反而没人看。实测这条规则正好抓出青海摇那种真问题：
    refs 写 `青海摇_静音.mp4` / `参考音频9_5s.mp3`，而素材夹里只有原片与未裁剪的音频
    （加工件只在上传夹里）→ 下一轮改这一版 agent 就找不到它们了。
    """
    base = {os.path.basename(f).lower() for f in (files or []) if f}
    out = []
    for k, v in (refs or {}).items():
        toks = _REFFILE.findall(str(v or ""))
        if not toks:
            continue
        if not any(os.path.basename(t.replace("\\", "/")).lower() in base for t in toks):
            out.append(k)
    return out


def versions_payload(pdir):
    """③栏「版本」区的数据：每版的名字、差异说明、素材件数、是否当前、引用缺不缺。"""
    _sk, proj = _load_proj(pdir)
    prs = [x for x in (proj.get("prompts") or []) if isinstance(x, dict)]
    out = []
    for v in versions_of(pdir):
        mats = [m for m in (v.get("materials") or []) if isinstance(m, dict)]
        files = [(m.get("file") or "").replace("\\", "/") for m in mats]
        refs = v.get("refs") if isinstance(v.get("refs"), dict) else {}
        if not refs:                                    # 回退：去 prompts[] 找同序号那条
            _n = _ver_no(v.get("name"))
            if _n:
                for pr in prs:
                    if _ver_no(pr.get("name")) == _n and isinstance(pr.get("refs"), dict):
                        refs = pr["refs"]
                        break
        missing = _ref_missing(refs, files)
        out.append({"name": v.get("name") or "", "dir": v.get("dir") or "",
                    "note": v.get("note") or "", "ratio": v.get("ratio") or "",
                    "type": v.get("type") or "", "createdAt": v.get("createdAt") or "",
                    "n": len(mats), "files": files, "refs": refs,
                    "missingRefs": missing, "isDefault": False})
    if not out:                       # 老项目：把默认版也显示出来，用户才知道自己在第几版
        mats = [m for m in (proj.get("materials") or []) if isinstance(m, dict)]
        # 老项目没有 versions[]，refs 只能取 `prompts[]` 最后一条（＝最近交付的那一版）
        _lr = next((x.get("refs") for x in reversed(prs)
                    if isinstance(x.get("refs"), dict) and x.get("refs")), {}) or {}
        _files = [(m.get("file") or "") for m in mats]
        _miss = _ref_missing(_lr, _files)
        out.append({"name": "默认版", "dir": VER_DEFAULT, "note": "还没建过版本",
                    "n": len(mats), "files": _files,
                    "refs": _lr, "missingRefs": _miss, "isDefault": True})
    cur = cur_ver_name(pdir) or ""
    for v in out:
        v["cur"] = bool(v.get("isDefault")) if not cur else (v.get("name") == cur)
    return out


def _resolve_upload_pick(pdir, base, it):
    """把"沿用的加工件"标识解析成项目内相对路径（找不到返回 ""）。

    接受三种写法：项目内相对路径（`平台上传/v1 主推/x.mp4`）、版本子目录内相对
    （`v1 主推/x.mp4`）、纯文件名（在该版上传夹、再在夹根里找）。
    """
    it = str(it or "").replace("\\", "/").strip().strip("/")
    if not it:
        return ""
    if os.path.isfile(os.path.join(pdir, it.replace("/", os.sep))):
        return it
    up = os.path.join(pdir, "平台上传")
    if not os.path.isdir(up):
        up = os.path.join(pdir, "即梦上传")
    cands = []
    if base:
        cands.append(os.path.join(up, base, it))
    cands.append(os.path.join(up, it))
    cands.append(os.path.join(pdir, "素材", "平台上传", it))
    for c in cands:
        if os.path.isfile(c):
            return os.path.relpath(c, pdir).replace(os.sep, "/")
    return ""


def version_new(pdir, name, carry=None, base_name="", carry_upload=None):
    """③栏「新建版本」：开本版素材夹 → 把勾选沿用的素材**复制**进来 → 切到新版。

    - name        ：新版本名（要带一句差异，rules 70/273）。它同时当素材夹名。
    - carry       ：要沿用的素材（上一版里的 file 列表）；**None ＝ 全部沿用**（默认）。
    - base_name   ：项目还没建过版本时，顺手给"现有这一版"起的名字（缺省 v1 主推）。
    - carry_upload：上一版**上传夹里已加工好的件**（2026-10-16 用户提议：原话「也可以
                    直接把平台上传的加工后的素材当做新版本能复用的素材来用」）——
                    rules 59「先看有没有现成的、别重复加工」：静音片/裁剪件/音色参考
                    直接复制进本版素材夹就能 @引用，不必再加工一遍。
    """
    sk, proj = _load_proj(pdir)
    if sk is None:
        return {"ok": False, "error": "读不到 框架.json"}
    name = (name or "").strip()
    if not name:
        return {"ok": False, "error": "版本名不能空"}
    if any(ch in name for ch in _VER_BAD):
        return {"ok": False, "error": "版本名不能含这些字符：\\ / : * ? \" < > |"}
    vs = proj.get("versions")
    if not isinstance(vs, list):
        vs = []
        proj["versions"] = vs
    if any((v.get("name") or "") == name for v in vs if isinstance(v, dict)):
        return {"ok": False, "error": "已经有叫「%s」的版本了" % name}
    if vs:                                            # 已有版本 → 从"当前版"沿用
        base = cur_ver_name(pdir) or (vs[-1].get("name") or "")
    else:                                             # 第一次建版本 → 先把现有这版补登
        base = (base_name or "v1 主推").strip() or "v1 主推"
        if any(ch in base for ch in _VER_BAD):
            base = "v1 主推"
        if base == name:
            base = "v1 主推"
        vs.append({"name": base, "dir": VER_DEFAULT, "note": "原有素材（默认版）",
                   "materials": [m for m in (proj.get("materials") or [])
                                 if isinstance(m, dict)],
                   "createdAt": time.strftime("%Y-%m-%dT%H:%M:%S")})
    bv = next((v for v in vs if isinstance(v, dict) and (v.get("name") or "") == base), None)
    bsrc = (bv or {}).get("materials") if bv else proj.get("materials")
    bmats = [m for m in (bsrc or []) if isinstance(m, dict)]
    want = None if carry is None else {str(x).replace("\\", "/") for x in carry}
    picked = [m for m in bmats
              if want is None or (m.get("file") or "").replace("\\", "/") in want]
    msub = "素材/" + name
    md = os.path.join(pdir, msub.replace("/", os.sep))
    updir = (pcore.upload_dir(pdir, create=True) if pcore
             else os.path.join(pdir, "平台上传"))
    try:
        os.makedirs(md, exist_ok=True)
        os.makedirs(os.path.join(updir, name), exist_ok=True)
    except OSError as e:
        return {"ok": False, "error": "建目录失败：%s" % e}
    new_mats, ncarry = [], 0
    for m in picked:                                  # 沿用即复制（rules 71）
        rel = (m.get("file") or "").replace("\\", "/")
        src = os.path.join(pdir, rel.replace("/", os.sep)) if rel else ""
        # 原件不在原位但知道实体在哪（rescan 写的 movedTo，省空间迁移的常见形态）→ 用实体
        if src and not os.path.isfile(src) and m.get("movedTo"):
            _alt = os.path.join(pdir, str(m.get("movedTo")).replace("/", os.sep))
            if os.path.isfile(_alt):
                src = _alt
        nm = os.path.basename(rel) or (m.get("name") or "")
        if not nm:
            continue
        dst = os.path.join(md, nm)
        try:
            if src and os.path.isfile(src):
                if os.path.normcase(src) != os.path.normcase(dst):
                    shutil.copy2(src, dst)
            elif not os.path.isfile(dst):
                continue                              # 源没了、目标也没有 → 不登记
        except OSError as e:
            return {"ok": False, "error": "复制素材失败（%s）：%s" % (nm, e)}
        rec = dict(m)
        rec["file"] = "%s/%s" % (msub, nm)
        rec["id"] = ""
        rec["note"] = ("%s ｜沿用自 %s" % (m.get("note") or "", base)).strip(" ｜")
        new_mats.append(rec)
        ncarry += 1
    nup = 0
    for it in (carry_upload or []):                   # 沿用上一版上传夹的加工件（2026-10-16）
        rel = _resolve_upload_pick(pdir, base or "", it)
        if not rel:
            continue
        src = os.path.join(pdir, rel.replace("/", os.sep))
        nm = os.path.basename(rel)
        if not nm:
            continue
        dst = os.path.join(md, nm)
        try:
            if os.path.normcase(src) != os.path.normcase(dst) and not os.path.isfile(dst):
                shutil.copy2(src, dst)
        except OSError as e:
            return {"ok": False, "error": "复制加工件失败（%s）：%s" % (nm, e)}
        try:
            sz = os.path.getsize(dst)
        except OSError:
            sz = 0
        role = ""
        if pcore:
            try:
                role = pcore.detect_role(dst, {"size": sz})
            except Exception:                                     # noqa: BLE001
                role = ""
        new_mats.append({"id": "", "file": "%s/%s" % (msub, nm), "name": nm,
                         "type": pcore.kind_of(rel) if pcore else "",
                         "size": sz, "srcPath": "", "role": role,
                         "addedAt": time.strftime("%Y-%m-%dT%H:%M:%S"), "tags": [],
                         "note": "沿用自 %s 上传夹（已加工）" % (base or "默认版")})
        nup += 1
    vs.append({"name": name, "dir": name, "note": "新建版本",
               "materials": new_mats, "createdAt": time.strftime("%Y-%m-%dT%H:%M:%S")})
    proj["current"] = name
    _sync_cur_mats(sk, new_mats)
    pcore.save_skeleton(pdir, sk)
    return {"ok": True, "current": name, "base": base, "carried": ncarry,
            "carriedUpload": nup,
            "matsDir": cur_mats_sub(pdir), "versions": versions_payload(pdir),
            "materials": materials_payload(pdir)}


def version_switch(pdir, name=""):
    """切当前版：`project.materials` 换成该版的，②③栏跟着换（正文由 prompts[] 认版本）。"""
    sk, proj = _load_proj(pdir)
    if sk is None:
        return {"ok": False, "error": "读不到 框架.json"}
    vs = [v for v in (proj.get("versions") or []) if isinstance(v, dict)]
    if not vs:
        return {"ok": False, "error": "这个项目还没建过版本"}
    name = (name or "").strip()
    if name and not any((v.get("name") or "") == name for v in vs):
        return {"ok": False, "error": "没有叫「%s」的版本" % name}
    proj["current"] = name or (vs[-1].get("name") or "")
    hit = next((v for v in vs if (v.get("name") or "") == proj["current"]), None)
    proj["materials"] = [m for m in ((hit or {}).get("materials") or [])
                         if isinstance(m, dict)]
    pcore.save_skeleton(pdir, sk)
    return {"ok": True, "current": proj["current"], "matsDir": cur_mats_sub(pdir),
            "versions": versions_payload(pdir), "materials": materials_payload(pdir)}


def _series_ref_brief(pdir, limit=10, body_chars=700):
    """「系列参考」速览：**上一版**的素材（只给名字、**不给 @编号**）＋ 它正文的开头。

    rules 71：用户要的「和上一版是同一个系列，拿进去参考」就是这份东西——用途只有
    形象/道具/场景/台词风格口径一致、以及改版时知道上一版怎么写的；**它绝不是本版素材**。
    """
    vs = versions_of(pdir)
    if len(vs) < 2:
        return ""
    cur = cur_ver_name(pdir)
    prev = None
    for i, v in enumerate(vs):
        if (v.get("name") or "") == cur and i > 0:
            prev = vs[i - 1]
            break
    if prev is None and (vs[0].get("name") or "") != cur:
        prev = vs[0]
    if prev is None:
        return ""
    _kind = {"image": "图片", "video": "视频", "audio": "音频"}
    lines = ["上一版：%s" % (prev.get("name") or "")]
    mats = [m for m in (prev.get("materials") or []) if isinstance(m, dict)]
    for m in mats[:limit]:
        rel = (m.get("file") or "").replace("\\", "/")
        nm = m.get("name") or os.path.basename(rel) or "?"
        role = ("，role=" + str(m.get("role"))) if m.get("role") else ""
        lines.append("  · %s（%s%s）" % (nm, _kind.get(m.get("type"), m.get("type") or "?"), role))
    if len(mats) > limit:
        lines.append("  · …还有 %d 件" % (len(mats) - limit))
    # 上一版的正文：先按版本名去 prompts[] 里找，找不到且上一版就是默认版 → 读 `文案/`
    pname = prev.get("name") or ""
    txt = ""
    _sk, proj = _load_proj(pdir)
    for pr in (proj.get("prompts") or []):
        if not isinstance(pr, dict):
            continue
        nm = pr.get("name") or ""
        if pname and (pname in nm or nm in pname) and (pr.get("text") or "").strip():
            txt = pr["text"]
            break
    if not txt and prev.get("dir") == VER_DEFAULT:
        for cand in ("文案/提示词正文.txt", "文案/提示词.txt"):
            fp = os.path.join(pdir, cand.replace("/", os.sep))
            if os.path.isfile(fp):
                try:
                    txt = open(fp, encoding="utf-8-sig").read().strip()
                except OSError:
                    txt = ""
                if txt:
                    break
    if txt:
        lines.append("它的正文开头（**看口径用，别照抄**）：")
        lines.append("  " + txt[:body_chars].replace("\n", " "))
    return "\n".join(lines)


def materials_payload(pdir):
    """②栏「文案/素材识别」的清单——**只列「当前版」的素材**（rules 71）。

    来源是当前版的 `materials`（＝`框架.json → project.materials`，切版时它跟着换）：
    **这份数组的顺序就是引用编号的顺序**（agent 按它排 @图片1 / @音频1），
    所以②栏里拖动排序改的就是它。
    另外兜底扫描 `文案/` 与**当前版素材夹**里没登记进框架的文件（agent 或人手拷进去的）——
    注意**只扫当前版**：别的版本的素材不许混进②栏（否则又变回"两版素材串台"）。
    """
    rows = []
    seen = set()
    for m in cur_materials(pdir):
        if not isinstance(m, dict):
            continue
        rel = (m.get("file") or "").replace("\\", "/")
        name = m.get("name") or os.path.basename(rel)
        if is_output_name(name):          # 产物/文稿不是素材，别混进②栏
            continue
        fp = os.path.join(pdir, rel.replace("/", os.sep)) if rel else ""
        size = m.get("size") or 0
        exists = bool(fp) and os.path.isfile(fp)
        if exists:
            try:
                size = os.path.getsize(fp)
            except OSError:
                pass
        seen.add(name)
        moved = ""
        if rel and not exists:            # 文件不在 → 看实体被搬到哪儿了（只提示，不改记录）
            try:
                moved = pcore.find_elsewhere(pdir, rel) if pcore else ""
            except Exception:                                # noqa: BLE001
                moved = ""
        # 老记录/手工登记的素材可能没有 type；前端 @ 引用只认 image/video/audio，
        # 空 type 会让整份素材清单“一个都 @ 不到”。这里按扩展名兜底推断，不改盘上记录。
        _typ = m.get("type") or ""
        if _typ not in ("image", "video", "audio", "text", "other"):
            _typ = pcore.kind_of(name or rel) if pcore else ""
        rows.append({"id": m.get("id") or "", "file": rel, "name": name,
                     "role": m.get("role") or "", "size": size,
                     "type": _typ, "note": m.get("note") or "",
                     "missing": bool(rel) and not exists, "movedTo": moved})
    subs = []                              # 兜底扫描只看「当前版素材夹」＋文案/
    for s in ("文案", cur_mats_sub(pdir)):
        if s and s not in subs:
            subs.append(s)
    for sub in subs:
        d = os.path.join(pdir, sub.replace("/", os.sep))
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            fp = os.path.join(d, fn)
            # ⚠️ 产物/文稿（口播稿·提示词·提示词正文·需求·备注…）**不是素材**，一律不进②栏。
            # 2026-09-21 用户截图：`文案/` 里那三份文稿被当成「待识别」混进素材清单了 ——
            # 原因是**上面登记表那条挡了产物、这条兜底扫描漏了**（它只挡 seen）；
            # 而兜底扫描偏偏连 `文案/` 一起扫，于是文稿全被当素材捞进来。
            if not os.path.isfile(fp) or fn in seen or is_output_name(fn):
                continue
            try:
                sz = os.path.getsize(fp)
            except OSError:
                sz = 0
            rows.append({"id": "", "file": "%s/%s" % (sub, fn), "name": fn, "role": "",
                         "size": sz, "type": (pcore.kind_of(fn) if pcore else ""),
                         "note": "还没登记进框架", "missing": False})
    return rows


def register_intake_materials(pdir, files, roles=None, on_log=None):
    """把一批「待识别」素材登记进当前项目（agent 起跑前也要先做这一步）。

    为什么单独抽成模块函数（2026-11-04 实机 bug）：`start_agent` 的 intake 轮
    原来直接拿 `materials_payload(pdir)` 给 agent 看，但用户拖进来的文件还只在
    `pending` 里、没进项目 —— agent 看到的是「程序没扫到素材」，于是不做需求识别，
    整个框架走不到下一步。现在在叫 agent **之前**先登记，agent 一定能看到清单；
    agent 的归类结论回来后再按文件名回填 role（`roles` 可以只传、不传 files）。

    返回新登记件数；`files` 为空但 `roles` 有值时返回 0（只回填角色）。
    """
    log = on_log or (lambda _s: None)
    if not (pcore and pdir and os.path.isdir(pdir)):
        return 0
    roles = dict(roles or {})
    files = list(files or [])
    if not files and not roles:
        return 0

    def _within(root, path):
        try:
            r = os.path.normcase(os.path.realpath(os.path.abspath(str(root or ""))))
            p = os.path.normcase(os.path.realpath(os.path.abspath(str(path or ""))))
        except OSError:
            return False
        return bool(r and p and (p == r or p.startswith(r + os.sep)))

    if not os.path.isfile(os.path.join(pdir, "框架.json")):
        try:
            base = pdir.rstrip("\\/")
            pcore.build_skeleton(os.path.dirname(base), os.path.basename(base),
                                 project_dir=pdir, register=False)
        except Exception:                                        # noqa: BLE001
            pass
    try:
        expanded = pcore.collect_files(files) if files else []
    except Exception:                                            # noqa: BLE001
        expanded = [f for f in files if os.path.isfile(f)]
    for f in expanded:
        roles.setdefault(os.path.basename(f), pcore.detect_role(f, {}))
    try:
        cur_sub = cur_mats_sub(pdir)
    except Exception:                                            # noqa: BLE001
        cur_sub = "素材"
    buckets = {}
    for f in expanded:
        role = roles.get(os.path.basename(f)) or pcore.detect_role(f, {})
        sub = "文案" if role == "文案" else cur_sub
        buckets.setdefault(sub, []).append(f)
    total = 0
    for sub, srcs in buckets.items():
        d = os.path.join(pdir, sub.replace("/", os.sep))
        try:
            os.makedirs(d, exist_ok=True)
        except OSError as e:
            log("建目录失败 %s：%s" % (sub, e))
            continue
        keep = []
        for f in srcs:
            try:
                if os.path.normcase(os.path.dirname(os.path.abspath(f))) == \
                        os.path.normcase(os.path.abspath(d)):
                    keep.append(f)
                    continue
                dst = os.path.join(d, os.path.basename(f))
                if os.path.normcase(os.path.abspath(f)) == os.path.normcase(os.path.abspath(dst)):
                    keep.append(f)
                    continue
                # 外部路径（别人发来的 C:\ 目录等）只复制、不搬走原文件；
                # 项目内/素材根内的文件才 move（与 2026-11 QA 的安全边界一致）。
                mat_root = ""
                try:
                    mat_root = (pcore.read_local() or {}).get("MATERIALS_ROOT") or ""
                except Exception:                                # noqa: BLE001
                    mat_root = ""
                if (not _within(pdir, f)) and (not (mat_root and _within(mat_root, f))):
                    shutil.copy2(f, dst)
                    log("外部素材已复制到项目（原文件保留）：%s" % os.path.basename(f))
                else:
                    shutil.move(f, dst)
                    log("搬进 %s/：%s" % (sub, os.path.basename(f)))
                keep.append(dst)
            except (OSError, shutil.Error) as e:
                log("搬移失败 %s（%s），仍按原位登记" % (os.path.basename(f), e))
                keep.append(f)
        try:
            added, skipped, _ = pcore.add_materials(pdir, keep, copy=False,
                                                    note="", on_log=log, into=sub)
            total += len(added)
            for s in skipped:
                log("跳过 %s（%s）" % (os.path.basename(s.get("src") or ""), s.get("why") or ""))
        except Exception as e:                                   # noqa: BLE001
            log("登记 %s/ 失败：%s" % (sub, e))
    # 角色回填：不管这批是“新登记”还是“之前已登记、agent 现在才给结论”，都要写。
    if total or roles:
        try:
            sk = pcore.load_skeleton(pdir) or {}
            proj = sk.get("project") or {}
            mats = proj.get("materials") or []
            for m in mats:
                if not isinstance(m, dict):
                    continue
                name = m.get("name") or os.path.basename(str(m.get("file") or "").replace("\\", "/"))
                r = roles.get(name)
                if r:
                    m["role"] = r
            _sync_cur_mats(sk, mats)
            pcore.save_skeleton(pdir, sk)
            if total:
                log("归类落框架：%d 件登记进素材清单" % total)
        except Exception as e:                                   # noqa: BLE001
            log("角色回填失败：%s" % e)
    return total


def proj_need(pdir):
    """用户填的「简单需求」（框架.json → project.need）：agent 出提示词时必须按它来。"""
    if not pcore or not pdir:
        return ""
    try:
        sk = pcore.load_skeleton(pdir)
    except Exception:                                            # noqa: BLE001
        return ""
    return (((sk or {}).get("project") or {}).get("need") or "").strip()


def settled_brief(pdir):
    """本项目**已经定过**的生成参数（画幅 / 模型档位 / 单条时长上限）——一行一句。

    为什么要有（2026-09-21 用户实测踩到）：**「归类」轮为了省时间不带 head**
    （不读 SKILL.md 35KB + references 341KB，见 start_agent 里 intake 分支的注释），
    结果把「用户需求」这条通道也一起切掉了 —— 用户 18:29:33 刚把 V3 的台词填进需求框，
    18:29:43 起跑的归类轮看不到，于是问「这条的台词是什么？」「用哪个档位？」，
    用户当场回「我不是放进需求里面了吗」「不要每次都问了」（rules 第 65 条：
    拿不准按最稳的做，别拿不准就问）。这里只抽这几行给归类轮，仍然不读技能文档。
    """
    _sk, proj = _load_proj(pdir)
    vals = {}
    for v in list(proj.get("versions") or []) + list(proj.get("prompts") or []):
        if not isinstance(v, dict):
            continue
        for k in ("ratio", "model", "duration"):
            if v.get(k) in (None, "", 0):
                continue
            vals.setdefault(k, []).append((v.get("name") or "(默认版)", v[k]))
    if not vals:
        return ""
    same, diff = [], []
    for k, lbl in (("ratio", "画幅"), ("model", "档位"), ("duration", "单条上限")):
        seen = vals.get(k) or []
        uniq = []
        for _n, x in seen:
            if x not in uniq:
                uniq.append(x)
        if not uniq:
            continue
        if len(uniq) == 1:
            same.append("%s=%s%s" % (lbl, uniq[0], "s" if k == "duration" else ""))
        else:
            # 各版不一致时**按时间列出**（versions 在前、prompts 在后＝从旧到新），让 agent 自己判
            diff.append("  · %s 各版不同：%s"
                        % (lbl, "、".join("%s=%s" % (n, x) for n, x in seen[:6])))
    out = []
    if same:
        out.append("  · %s（各版一致，照用）" % "、".join(same))
    out += diff
    return "\n".join(out)


# ── 待投放素材的**持久化**（2026-10-08 修"偶现素材无法识别、归类什么也没有"）────────
# srv.pending 原来是纯内存列表：归类 agent 轮是异步线程，创作台中途重启/崩溃（或那次
# 启动崩溃）线程死了，pending 也没了 → 用户重开界面②栏空空，素材"消失"。
# 现在落到项目级 `<项目>/_会话/待投放.json`，启动时按当前项目恢复。
def pending_file(pdir):
    return os.path.join(pdir, "_会话", "待投放.json") if pdir else ""


def save_pending(pdir, items):
    if not pdir:
        return
    try:
        os.makedirs(os.path.join(pdir, "_会话"), exist_ok=True)
        with open(pending_file(pdir), "w", encoding="utf-8", newline="\n") as f:
            json.dump(list(items or []), f, ensure_ascii=False, indent=1)
    except OSError:
        pass


def load_pending(pdir):
    if not pdir:
        return []
    try:
        with open(pending_file(pdir), encoding="utf-8-sig") as f:
            d = json.load(f)
        return [str(x) for x in d if isinstance(x, str) and x] if isinstance(d, list) else []
    except (OSError, ValueError):
        return []


# ── 本机界面偏好（项目列表排序、主题、栏宽）：gitignored 的 workbench.local.json ────
