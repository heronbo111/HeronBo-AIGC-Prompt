            info["sessionRecover"] = (not si["id"]) and bool(recover_session(pdir, _k2))
            info["sessionMode"] = (read_ui() or {}).get("sessionMode", "resume")
            info["compactMB"] = COMPACT_MB
            info["summaryFile"] = summary_path(pdir) if os.path.isfile(summary_path(pdir)) else ""
            # 项目↔通道绑定（rules 80）：当前项目绑的是哪条通道——界面据此拦住"同项目换通道"
            try:
