def _agent_error_text(res):
    """认出"rc=0 但其实是报错"的返回（2026-09-17 实测：No conversation found with session ID）。

    返回可读的错误文本；不是错误就返回空串。覆盖两种长相：
    ① 纯 JSON 事件（`{"type":"error","error":"…"}`）；② 文本里带 "No conversation found" 之类。
    """
    txt = (res.get("text") or "").strip()
    err = (res.get("error") or "").strip()
    blob = txt or err
    if not blob:
        return ""
    for cand in (blob.splitlines()[-1] if blob.count("\n") < 40 else blob, blob):
        s = cand.strip()
        if s.startswith("{") and s.endswith("}"):
            try:
                o = json.loads(s)
            except ValueError:
                continue
            if isinstance(o, dict) and (o.get("error") or o.get("is_error")):
                return str(o.get("error") or o.get("message") or "agent 报错")[:300]
    low = blob.lower()
    for pat in ("no conversation found", "session not found", "could not find session",
                "会话不存在", "找不到会话", "无效的会话"):
        if pat in low:
            i = low.find(pat)
            return blob[max(0, i - 40): i + 140].strip()[:300]
    if err and not res.get("ok"):
        return err[:300]
    return ""


