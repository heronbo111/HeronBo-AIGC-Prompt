        return 0.0, 0
    vals.sort()
    return vals[len(vals) // 2], len(vals)


def _stage_eta_secs(pdir, what, idx, n, total_eta):
    """本段预计：段历史中位数，没有就整轮估时 × 权重。"""
    hist, _n = _stage_hist_median(pdir, what, idx)
    if hist:
        return hist
    w = _stage_weights(what, n)[idx]
    return max(10.0, float(total_eta or 180) * w / 100.0)


def _record_stage_eta(pdir, what, idx, seconds):
    if not (1 < seconds < 3600):
        return
    d = os.path.join(pdir, "_会话") if pdir else ""
    if not d:
        return
    try:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "阶段耗时.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"at": datetime.datetime.now().isoformat(timespec="seconds"),
                                "what": what or "", "stage": int(idx),
                                "seconds": round(seconds, 1)}, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _stage_from_line(line, cur):
    """把 agent 的一行输出映射到阶段。工具名/文件路径是最可靠的信号。"""
    low = line.lower()
    if "receipt" in low or "回执" in line:
        return 3
    if ("平台上传" in line) or ("即梦上传" in line):      # 老项目的阶段行也认
        return max(cur, 2)
    if "正文" in line or "prompt.txt" in low:
        # 提示词**正文**出来了（2026-09-17 用户要求：先让用户能复制）→
        # 进度直接顶到 80%+，条与"正文已出"这个事实对齐，别让用户看着 30% 干等
        try:
            _PROG["pct"] = max(int(_PROG.get("pct") or 0), 80)
        except Exception:                                         # noqa: BLE001
            pass
        return max(cur, 2)
    if "框架.json" in line or "提示词" in line or "prompt" in low:
        return max(cur, 1)
    if "skill.md" in low or "读" in line and cur == 0:
        return 0
    return cur


def _tool_paths_brief():
    """把随包工具的绝对路径写进任务书（2026-10-28）。

    豆包工作这类通道的 agent 不是我们的子进程：_augment_path() 改的是本进程 PATH，
    到不了它那儿，它执行 shell 时还是找不到 ffmpeg，就去下载安装（用户实测白等半天）。
    任务书里直接给绝对路径，它照抄就能用；路径按每台机器的实际安装位置算出来。
    """
    t = _tool_paths()
    lines = []
    for key, label in (("ffmpeg", "ffmpeg  "), ("ffprobe", "ffprobe "),
                       ("python", "python  "), ("node", "node    ")):
        if t.get(key):
            lines.append("  %s: %s" % (label, t[key]))
    if not lines:
        return ""
    NL = chr(10)
    return ("【本机工具绝对路径——直接用完整路径调用，不要自己下载/安装/升级】" + NL
            + NL.join(lines) + NL
            + "（抽帧示例：用上面 ffmpeg 那行的路径，-ss 0 -i <视频> -frames:v 1 -y <输出.png>）" + NL + NL)


def start_agent(pdir, what, feedback="", trigger=""):
    """起一个 agent 任务（后台线程），进度写进 _PROG，页面用 SSE 读。

    `trigger`＝这一轮为什么起的（"反馈"/"评分"/"成片"/"废片"/"手动"…）。
    为什么要它（2026-09-19 用户要求）：④栏那条精简进度条**只在"提交完反馈让 agent 读"时显示**，
    界面得知道这一轮的来源，不能只看 what（absorb 有五种触发）。

    **先查通道再起任务**：没有 agent（或本机没一个可用）时直接返回原因，
    别起一个注定失败的"假进度"——界面上按钮本来就是灰的，这里是第二道闸。
    """
    if os.environ.get("HERONBO_NO_AGENT"):
        # 只给验证用（`HERONBO_NO_AGENT=1`，2026-09-17）：自检界面/接口时别真起 agent（那要花额度）
        return {"error": "验证模式（HERONBO_NO_AGENT=1）：不叫 agent"}
    if not abridge:
        return {"error": "agent 通道不可用：缺 agent_bridge.py"}
    try:
        ok, why = abridge.available()
    except Exception as e:                                       # noqa: BLE001
        return {"error": "agent 通道探测失败：%s" % e}
    if not ok:
        return {"error": "agent 通道不可用：%s" % why}
    # 上一轮如果还在后台跑（窗口关掉但 agent 没死），这里先挡住：重开创作台不等于
    # 可以再拉起一轮豆包工作，否则两个 agent 会同时改同一个项目。
    if not _PROG.get("running") or _PROG.get("detached_pid"):
        prev = _job_snapshot()
        if prev:
            who = {"prompt": "出提示词", "feedback": "按反馈重出", "intake": "素材与需求识别",
                   "learn": "评价反哺", "absorb": "读你刚提交的东西",
                   "compact": "压缩上下文"}.get(prev.get("what") or "", "任务")
            proj = os.path.basename((prev.get("pdir") or "").rstrip("\\/")) or "?"
            return {"error": "上一轮「%s / %s」还在后台跑（PID %s）——没有重新拉起它；"
                             "等它跑完，或在进度条那行点「暂停」再开新任务"
                             % (proj, who, prev.get("agent_pid") or "?"),
                    "running": True, "detached": True,
                    "what": prev.get("what") or "", "pdir": prev.get("pdir") or ""}
    with _PROG_LOCK:
        if _PROG["running"]:
            # 判活（2026-09-19 用户截图：新任务被「已经有一个任务在跑」挡住，界面却找不到那个任务）——
            # 上一轮可能早就没了（窗口关掉 / agent 崩 / 机器睡过 / 被 kill），但内存里的 running 还挂着。
            alive = agent_proc_alive()
            el = time.time() - (_PROG.get("t0") or 0)
            stale = (not alive) or el > max(900.0, (_PROG.get("eta") or 300) * 5)
            if stale:
                _PROG.update({"running": False, "done": True, "ok": False,
                              "text": "上一轮已中断", "seconds": round(el, 1)})
                # ⚠️ 这里**不能调 _push_line**：它内部还会取 _PROG_LOCK，锁内取锁＝死锁
                # （整台创作台都会卡住）。只往内存里追加这一行就够，界面立刻能看到。
                note = ("· 上一轮其实已经不在跑了（%s），状态已自动清掉，这一轮照常开始"
                        % ("agent 进程不在了" if not alive else "已用 %s 远超合理时长" % _fmt_dur(el)))
                lines = _PROG.setdefault("lines", [])
                lines.append(note)
                del lines[:-400]
            else:
                names = _PROG.get("stages") or [n for n, _w in STAGES]
                st = names[min(_PROG.get("stage") or 0, len(names) - 1)]
                who = {"prompt": "出提示词", "feedback": "按反馈重出", "intake": "素材与需求识别",
                       "learn": "评价反哺", "absorb": "读你刚提交的评分/反馈",
                       "compact": "压缩上下文"}.get(_PROG.get("what") or "", "任务")
                proj = os.path.basename((_PROG.get("pdir") or "").rstrip("\\/")) or "?"
                return {"error": "上一个项目「%s」的「%s」还在跑（%s · 已用 %s）——"
                                 "它不是卡住，跑完就能起这一轮；要立刻停就在进度条那行点「暂停」"
                                 % (proj, who, st, _fmt_dur(el)),
                        "running": True, "job": _PROG["job"], "elapsed": round(el),
                        "stage": _PROG.get("stage") or 0, "what": _PROG.get("what") or "",
                        "pdir": _PROG.get("pdir") or ""}
        _PROG.update({"job": _PROG["job"] + 1, "stage": 0, "pct": 0, "lines": [],
                      "done": False, "ok": None, "text": "", "t0": time.time(),
                      "tStage": time.time(), "stageEta": 0, "stageEtaN": 0,
                      "eta_n": 0, "running": True, "pdir": pdir, "what": what,
                      "active": [], "warn": "", "chan": "",
                      "events": [],          # 动作流（任务可视化，2026-09-18）每轮清空
                      "_ck_stage": -1,       # 步骤锚点游标（2026-09-21：每轮从-1起，阶段推进才记"第N步"）
                      "trigger": trigger,    # 这一轮怎么来的（反馈/评分/成片/废片/手动…）
                      "queuedInbox": 0,       # 起新任务＝信箱会被读到 → 清掉"排队"提示
                      # 不同任务的四段名字不一样（读信箱/压缩上下文那两类按它们的活写，别串台）
                      "stages": STAGE_NAMES.get(what)})
        if what == "intake":
            # 2026-10-26 用户要求：素材识别这一轮不弹问答。上一轮遗留的问题文件先归档，
            # 免得识别跑到一半弹出旧问题、用户以为卡住（豆包明明答了，创作台却在等答案）。
            try:
                _q = questions_path(pdir)
                if os.path.isfile(_q):
                    os.replace(_q, _q.replace(".json", ".old-%d.json" % int(time.time())))
            except OSError:
                pass
        _STOPPED["flag"] = False          # 每轮开始先清掉"手动停止"标记，别串到下一轮
        _PAUSED["flag"] = False           # 起新轮 = 用户有动作了 → 解除暂停闩（自动读信箱恢复）
        eta, n = _hist_eta(pdir, what)
        _PROG["eta"] = eta
        _PROG["eta_n"] = n
        # 开局就把"这一段预计多久"算出来（历史中位数 / 权重折算），界面第一帧就有数
        try:
            _n_st = len(STAGE_NAMES.get(what) or STAGES)
            _PROG["stageEta"] = _stage_eta_secs(pdir, what, 0, _n_st, eta)
            _PROG["stageEtaN"] = _stage_hist_median(pdir, what, 0)[1]
        except Exception:                                        # noqa: BLE001
            _PROG["stageEta"] = max(10.0, eta * 0.15)
        job = _PROG["job"]
    _write_job({"owner_pid": os.getpid(), "agent_pid": 0, "job": job,
                "pdir": pdir, "what": what, "trigger": trigger,
                "port": int(getattr(Handler, "port", 0) or 0),
                "t0": _PROG.get("t0") or time.time()})
    st = _proj_state(pdir)
    # 技能根：**打包后 HERE 在 _MEIxxxx 临时目录**，dirname(HERE) 会给出一个不存在的路径
    # （2026-09-16 实测：ZCode 收到 "本机临时路径的 SKILL.md 不存在"，自己绕路去已装技能包里找——
    #  白花时间还有读错版本的风险）。统一走 pcore.find_skill_root()。
    try:
        _root = pcore.find_skill_root() if pcore else os.path.dirname(HERE)
    except Exception:                                            # noqa: BLE001
        _root = os.path.dirname(HERE)
    skill_md = os.path.join(_root, "SKILL.md")
    # 先认一下这一轮用哪个 agent（会话、记录、压缩判断都要用它）
    try:
        _k, _why = abridge.pick_agent()
        agent_label = (_why or "")[:80]
    except Exception:                                            # noqa: BLE001
        _k, agent_label = "", ""
    # ── 项目↔通道 绑定与接续（rules 80，2026-10-16 用户要求）────────────────────
    # 一个项目开工用哪条通道就**绑哪条**：同项目中途不换（会话与上下文接不上）；
    # 只有绑定通道"接不通"时才轮到别的通道接手——接手方要把上一个通道做完的工作读一遍再接续。
    _bind_sk, _bind_proj, _handoff = None, {}, None
    if pcore:
        try:
            _bind_sk = pcore.load_skeleton(pdir)
            _bind_proj = (_bind_sk or {}).get("project") or {}
            _handoff = _bind_proj.get("agentHandoff") or None
            if _bind_sk is not None and _k and not (_bind_proj.get("agentChannel") or ""):
                _bind_proj["agentChannel"] = _k           # 首次开工：这一轮用的通道就是这个项目的绑定
                pcore.save_skeleton(pdir, _bind_sk)
        except Exception:                                        # noqa: BLE001
            _bind_sk, _bind_proj, _handoff = None, {}, None
    # 会话：**默认续用同一个对话**（2026-09-17 用户要求"对话默认采用一次相同对话来缩短生成时间"）——
    # 存着的 id 优先，丢了就从本项目 agent 记录里捞回来；偏好里选了"每轮新开"就不续。
