# ── agent 记录：创作台自己给每一轮落一份（跟哪个 agent 无关，翻起来最省事）─────
def agent_records_dir(pdir):
    return os.path.join(pdir, "_会话", "agent记录")


def list_records(pdir):
    """本项目跑过的 agent 轮次（新的在前）。"""
    d = agent_records_dir(pdir)
    out = []
    if os.path.isdir(d):
        for fn in sorted(os.listdir(d), reverse=True):
            if not fn.endswith(".jsonl"):
                continue
            p = os.path.join(d, fn)
            try:
                st = os.stat(p)
            except OSError:
                continue
            out.append({"name": fn, "size": st.st_size, "mtime": st.st_mtime,
                        "path": p})
    return out


def read_record(pdir, name, limit=4000):
    """读一份记录：返回 {meta, lines:[{t,kind,text}]}（名字要防目录穿越）。"""
    name = os.path.basename(name or "")
    p = os.path.join(agent_records_dir(pdir), name)
    if not (name and os.path.isfile(p)):
        return {"ok": False, "error": "没有这份记录：%s" % name}
    rows, meta = [], {}
    try:
        with open(p, encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f):
                if i >= limit:
                    rows.append({"kind": "line", "text": "…（记录太长，只显示前 %d 行）" % limit})
                    break
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                if o.get("kind") == "start" or o.get("kind") == "end":
                    meta.update(o)
                rows.append(o)
    except OSError as e:
        return {"ok": False, "error": "读不了：%s" % e}
    return {"ok": True, "name": name, "path": p, "meta": meta, "lines": rows}


def _push_raw_ev(raw, label=""):
    """agent stdout 的一行（`--output-format stream-json`）→ 动作流事件，追加进 `_PROG["events"]`。

    为什么这是**首选**来源（2026-09-21 实测踩到）：创作台拉起的 harness 有的**不落会话正文
    文件**（WorkBuddy 实测：40 分钟内一个新文件都没建）。旧的"全机找最新会话文件"于是读到
    **同时开着的另一个对话**——用户截图里看到的思考与工具调用全是别人的。
    stdout 是本轮独有的，所以以它为准；会话文件只在能按**会话 id 精确命中**时才用。
    """
    if not (_trace and raw):
        return
    try:
        evs = _trace.events_from_line(raw)
    except Exception:                                            # noqa: BLE001
        return
    if not evs:
        return
    with _PROG_LOCK:
        buf = _PROG.setdefault("events", [])
        buf.extend(evs)
        del buf[:-200]                       # 只留最近 200 条
        if label:
            _PROG["chan"] = label            # 界面显示"动作流来自哪个工具"


def _watch_agent_trace(stop_evt):
    """边跑边把 agent 的动作流读进 `_PROG["events"]`（任务可视化，2026-09-18/19）。

    数据源＝**本机探测到的所有 harness 的会话正文**（ZCode、WorkBuddy、Claude Code…）——
    通道表（去哪找 + 什么格式）与解析见 agent_trace.py。换机器 / 换工具**不用改代码**：
    在 exe 旁边或 `~/.heronbo/` 放一份 `agent_channels.local.json` 指路即可
    （2026-09-21 用户：有的机子只装了 WorkBuddy、有的只装了别的工具，要各自适配）。
    **只读，不改调用方式**，所以不会影响已经跑通的 stdout 解析路径。

    ⚠️ 两个坑（2026-09-19 补）：
      · 只认**本轮开始之后**被写过的正文文件——否则会把别的会话（比如同时在跑的另一个
        对话）当成这一轮的正文，界面显示的是别人的动作；
      · 换了通道（ZCode↔WorkBuddy）时正文文件也会变 → 每轮重新挑最新那个。
    """
    if not _trace:
        return
    try:
        # 配置文件跟着「源码＝tools/、打包＝exe 旁边」走（沿用 workbench.local.json 的目录规则）
        if hasattr(_trace, "set_cfg_dir"):
            _trace.set_cfg_dir(prefs_dir())
    except Exception:                                            # noqa: BLE001
        pass
    last = {}
    while not stop_evt.is_set():
        try:
            # **只用「本轮这个 agent 的会话」**：按会话 id 精确命中（agent_bridge.transcript_path）。
            # 找不到就什么都不做——宁可动作流空着、退回 agent 自己的输出行，也**不能**再去读
            # "全机最新的那个会话文件"：那会把同时开着的**另一个对话**当成本轮的过程
            # （2026-09-21 实测：界面里显示的思考与工具调用全是另一个对话的，用户当场看出来）。
            # 注意：多数情况下这一轮的事件其实来自 stdout（见 `_push_raw_ev`），这里是补充。
            sid = _PROG.get("traceSid") or ""
            akey = _PROG.get("traceAgent") or ""
            p = ""
            if sid and abridge and hasattr(abridge, "transcript_path"):
                try:
                    p = abridge.transcript_path(akey, _PROG.get("pdir") or "", sid) or ""
                except Exception:                                # noqa: BLE001
                    p = ""
            if p and p != (last.get("path") or ""):
                last = {"path": p, "off": 0}          # 换了会话文件 → 从头读
            if p:
                last["fmt"] = (_trace.fmt_of(p) if hasattr(_trace, "fmt_of") else "auto")
                last["label"] = ((abridge.ADAPTERS.get(akey) or {}).get("label") or akey) \
                    if (abridge and akey) else ""
            if last.get("path"):
                evs, off = _trace.events_since(last["path"], last.get("off") or 0,
                                               fmt=last.get("fmt"))
                last["off"] = off
                if last.get("label"):
                    with _PROG_LOCK:
                        _PROG["chan"] = last["label"]     # 界面显示"动作流来自哪个工具"
                if evs:
                    with _PROG_LOCK:
                        buf = _PROG.setdefault("events", [])
                        buf.extend(evs)
                        del buf[:-200]                   # 只留最近 200 条
        except Exception:                                        # noqa: BLE001
            pass
        time.sleep(2.0)


def _watch_project_files(pdir, rec, stop_evt):
    """盯项目里的文件动静当进度：**跟 agent 通道无关**。

    2026-09-16 用户实测：ZCode 那条通道 8 分钟零输出（它把过程都写进自己的会话文件，不进 stdout），
    界面上条不动、也不知道有没有在干活。可"它写了什么文件"是最诚实的进度信号：
    文案/ → 框架.json → 平台上传/ → _会话/回执.jsonl 就是出提示词的四步。
    变了就报一行（顺带让阶段前进），没变就每 45 秒报一句"还在跑"（**进程真活着才报**）。

    **2026-09-17 加两样（用户："进程要可视化 + 能及时制止它做无用的东西"）**：
    ① 每轮顺便扫一眼 agent 拉起来的子进程（ffmpeg/python 深度视频…）→ 写进 `_PROG["active"]`，
       界面显示"现在在做：X（已 3:20）"；
    ② 出现**额外加工类产物**（深度片/静音/裁剪/转写/拼图/水印…）时，推一条醒目警告并置
       `_PROG["warn"]`，把「暂停」按钮点亮——用户不想要就当场叫停。
    """
    # 额外加工的产物/目录特征（rules 47/49 说的"都不是默认步骤"那些）。
    # 元组第 4 位＝rules 55「素材加工」清单里的 key（2026-10-06 加）：
    # 用户勾了哪项，那项就**不再报警**；清单外的照旧报警并点亮「暂停」。
    EXTRA_HITS = [
        ("深度", "深度片（把素材转成深度图再生成）", "视频", "depth"),
        ("depth", "深度片（把素材转成深度图再生成）", "视频", "depth"),
        ("静音", "给素材静音", "视频", "mute"),
        ("_mute", "给素材静音", "视频", "mute"),
        ("裁剪", "裁时长／裁画面", "视频", "cut"),
        ("_cut", "裁时长／裁画面", "视频", "cut"),
        ("转写", "转写（听写字幕稿）", "文本", "transcript"),
        ("transcript", "转写（听写字幕稿）", "文本", "transcript"),
        ("ocr", "OCR 识别画面文字", "文本", "ocr"),
        ("拼图", "抽帧拼图（做联系表）", "图片", "grid"),
        ("水印", "去水印", "视频", "watermark"),
        ("_遮脸", "遮脸（图片盖住人脸）", "图片", "mask_face"),
        ("masked", "人物遮罩片（视频糊脸）", "视频", "matte"),
    ]
    # 本轮的允许清单：线程起来时读一次就够（rules 55；改了勾选下一轮生效）
    _allowed_extra = set(project_flags(pdir).get("allowExtra") or [])

    def snap():
        out = {}
        for pat in ("文案/*", "素材/*", "框架.json", "框架.md", "平台上传/*", "即梦上传/*",
                    "_会话/回执.jsonl", "备注/*", "**_depth*", "**/*深度*", "**/*静音*",
                    "**/*转写*", "**/*拼图*", "**/*_遮脸*", "**/*masked*"):
            for f in glob.glob(os.path.join(pdir, pat), recursive=True):
                try:
                    out[f] = (os.path.getmtime(f), os.path.getsize(f))
                except OSError:
                    pass
        return out

    prev = snap()
    beat = time.time()
    with _PROG_LOCK:
        ev_n = len(_PROG.get("events") or [])   # 动作流事件数（2026-09-21：事件在进就不算"静默"）
    while not stop_evt.is_set():
        time.sleep(2)
        cur = snap()
        for f, v in sorted(cur.items()):
            if prev.get(f) != v:
                rel = os.path.relpath(f, pdir).replace("\\", "/")
                _push_line("· 写了 %s（%.1f KB）" % (rel, v[1] / 1024.0), rec)
                low = rel.lower()
                for key, what, _kind, ex_key in EXTRA_HITS:
                    if key in low:
                        if ex_key in _allowed_extra:
                            break          # rules 55：用户勾了这项，不算"额外"
                        with _PROG_LOCK:
                            _PROG["warn"] = what
                        _push_line("⚠ 它在做「%s」——不在②栏「素材加工」的允许清单里；"
                                   "不想要就点「暂停」停下来（按钮已点亮）" % what, rec)
                        break
        # 子进程可视化：agent 自己拉起来的长任务（ffmpeg / python 脚本）
        try:
            if abridge and abridge.current_alive():
                act = abridge.heavy_children()
                with _PROG_LOCK:
                    _PROG["active"] = act
        except Exception:                                        # noqa: BLE001
            pass
        if cur != prev:
            prev, beat = cur, time.time()
        elif time.time() - beat > 45 and abridge and abridge.current_alive():
            # 2026-09-21 用户截图："归类的工作流没有展现"——实况是事件在进、只是没写文件，
            # 旧判定只看文件变化 → 误报"没动静"，还把 WorkBuddy 通道也说成"不吐过程输出"。
            with _PROG_LOCK:
                now_ev = len(_PROG.get("events") or [])
            if now_ev != ev_n:
                ev_n, beat = now_ev, time.time()      # 动作流还在进 → 不算静默，别打扰
            else:
                el = round(time.time() - _PROG["t0"]) if _PROG["t0"] else 0
                if ev_n:
                    _push_line("…（还在跑，已用 %d:%02d，agent 暂时没有新动作——"
                               "长思考时它不吐事件，不是卡住；它留了问题会弹「待确认」找你）"
                               % (el // 60, el % 60), rec)
                else:
                    _push_line("…（还在跑，已用 %d:%02d，暂时没有新动静——"
                               "这条通道不吐过程输出，进度按时间估）"
                               % (el // 60, el % 60), rec)
                beat = time.time()


