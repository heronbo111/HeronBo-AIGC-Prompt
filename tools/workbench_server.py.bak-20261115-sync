            out["doubao"] = {"ok": bool(ok0), "detail": str(why0)[:240]}
        except Exception as e:                                   # noqa: BLE001
            out["doubao"] = {"ok": False, "detail": str(e)[:200]}
        # 2a) 生成通道：默认 CLI；CDP 必须由用户在首次配置页手动切换。
        #     这里只显示当前模式与 CDP 条件，不连接、不拉起客户端，避免首次启动被调试端口拖慢。
        try:
            out["video_bridge"] = {
                "mode": wvideo.bridge_mode() if wvideo else "cli",
                "cdp_ready": bool(out["doubao"].get("ok")),
                "cdp_why": str(out["doubao"].get("detail") or "")[:200],
            }
        except Exception as e:                                   # noqa: BLE001
            out["video_bridge"] = {"mode": "cli", "cdp_ready": False,
                                   "cdp_why": str(e)[:200]}
        # 2b) 豆包 CLI（主通道）：装没装、登没登录；首次配置页据此显示扫码登录
        try:
            if wcli:
                okc, whyc = wcli.available(force=True)
