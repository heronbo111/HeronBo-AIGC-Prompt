    sid = sid or None
    inbox_items = inbox_pending(pdir)                            # 用户还没被读到的新提交
    inbox_n = (inbox_items[-1]["n"] if inbox_items else 0)
    need = proj_need(pdir)
    rec = os.path.join(agent_records_dir(pdir),
                       "%s-%s.jsonl" % (time.strftime("%Y-%m-%d-%H%M%S"), what or "prompt"))
