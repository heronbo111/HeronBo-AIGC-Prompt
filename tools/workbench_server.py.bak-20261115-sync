        pass


class WinCtl:
    """给页面里的**自绘标题栏**用：最小化 / 最大化还原 / 关闭。

    独立窗口用 frameless=True 开（系统标题栏收进页面内），页面上那三个按钮通过
    pywebview 的 JS 桥调这里：`window.pywebview.api.win_min()`。
    不在独立窗口里（Edge 窗口 / 浏览器）页面自己会把按钮藏起来，所以这里不会被调到。
    """

    _max = False

    def win_min(self):
        try:
            _WIN.minimize()
        except Exception:                                         # noqa: BLE001
            return False
        return True

    def win_max(self):
        """最大化 / 还原（2026-11-14 重做）。

        为什么不用 pywebview 的 maximize()：frameless=True 的窗口没有
        WS_MAXIMIZEBOX / WS_THICKFRAME，SW_MAXIMIZE 会被当成"铺满整个屏幕"，
        结果把 Windows 任务栏（状态栏）一起盖掉——用户原话"全屏会遮住状态栏"。
        这里改成把窗口精确 SetWindowPos 到**当前显示器的工作区**（rcWork 本身
        就不含任务栏），还原时按之前记下的矩形放回去，行为等同系统标题栏。
        返回值给页面切图标用：{"ok": bool, "max": bool}。
        """
        h = self._hwnd()
        if not h:
            return {"ok": False, "max": bool(self._max)}
        try:
            import ctypes

            class RECT(ctypes.Structure):
                _fields_ = [("left", ctypes.c_long), ("top", ctypes.c_long),
                            ("right", ctypes.c_long), ("bottom", ctypes.c_long)]

            class MONITORINFO(ctypes.Structure):
                _fields_ = [("cbSize", ctypes.c_ulong), ("rcMonitor", RECT),
                            ("rcWork", RECT), ("dwFlags", ctypes.c_ulong)]

            u = ctypes.windll.user32
            if not self._max:
                r = RECT()
                u.GetWindowRect(h, ctypes.byref(r))
                self._restore = (r.left, r.top, r.right - r.left, r.bottom - r.top)
                mon = u.MonitorFromWindow(h, 2)          # MONITOR_DEFAULTTONEAREST
                mi = MONITORINFO()
                mi.cbSize = ctypes.sizeof(MONITORINFO)
                u.GetMonitorInfoW(mon, ctypes.byref(mi))
                wk = mi.rcWork                           # 工作区：任务栏已扣掉
                u.SetWindowPos(h, 0, wk.left, wk.top,
                               wk.right - wk.left, wk.bottom - wk.top, 0x0004 | 0x0020)
                self._max = True
            else:
                x, y, w0, h0 = getattr(self, "_restore", None) or (100, 100, 1500, 900)
                u.SetWindowPos(h, 0, int(x), int(y), int(w0), int(h0), 0x0004 | 0x0020)
                self._max = False
            return {"ok": True, "max": bool(self._max)}
        except Exception:                                         # noqa: BLE001
            return {"ok": False, "max": bool(self._max)}

    def win_state(self):
        """页面用：现在是不是最大化。用矩形几何核对，不用 IsZoomed。

        为什么改（2026-11-14 实测）：这里的"最大化"是把窗口 SetWindowPos 到
        工作区，不是系统 SW_MAXIMIZE，所以 `IsZoomed()` 恒为 False。原来拿它
        回写 `self._max`，等于把自己刚设的状态清成 False —— 页面图标永远不切
        成双框，还原也失效，就是用户说的"没有按钮形态变化"。改成按矩形比对
        工作区（±2px 容差），用户手动拖动/系统快捷键改过都能正确同步。
        """
        h = self._hwnd()
        if not h:
            _winlog("win_state hwnd=0 max=%s" % self._max)
            return {"max": bool(self._max)}
        try:
            import ctypes

            class RECT(ctypes.Structure):
                _fields_ = [("left", ctypes.c_long), ("top", ctypes.c_long),
                            ("right", ctypes.c_long), ("bottom", ctypes.c_long)]

            class MONITORINFO(ctypes.Structure):
                _fields_ = [("cbSize", ctypes.c_ulong), ("rcMonitor", RECT),
                            ("rcWork", RECT), ("dwFlags", ctypes.c_ulong)]

            u = ctypes.windll.user32
            r = RECT()
            u.GetWindowRect(h, ctypes.byref(r))
            mon = u.MonitorFromWindow(h, 2)          # MONITOR_DEFAULTTONEAREST
            mi = MONITORINFO()
            mi.cbSize = ctypes.sizeof(MONITORINFO)
            u.GetMonitorInfoW(mon, ctypes.byref(mi))
            wk = mi.rcWork
            self._max = (abs(r.left - wk.left) <= 2 and abs(r.top - wk.top) <= 2
                         and abs(r.right - wk.right) <= 2 and abs(r.bottom - wk.bottom) <= 2)
            _winlog("win_state rect=%s work=%s max=%s" % (
                (r.left, r.top, r.right, r.bottom),
                (wk.left, wk.top, wk.right, wk.bottom), self._max))
        except Exception as e:                                    # noqa: BLE001
            _winlog("win_state err %s" % e)
        return {"max": bool(self._max)}

    def _hwnd(self):
        try:
            return find_window(WIN_TITLE, visible_only=False) or 0
        except Exception:                                         # noqa: BLE001
            return 0

    def win_move(self, dx=0, dy=0):
        """拖动无边框窗口（页面标题栏按住拖动时由 shell.js 调）。

        ⚠️ **坐标系坑（2026-09-17 用户实测踩到）**：pywebview 的 `move(x, y)` 是
        **绝对坐标**（内部 `SetWindowPos(hwnd, None, x, y, …)`），不是增量！
        第一版直接把页面的增量传进去，结果窗口每动一下就跳到接近 (0,0) 的位置——
        用户看到的现象是"能拖了，但锁死在屏幕左上角"。
        所以这里必须自己做 **当前位置 + 增量**，并夹在屏幕范围内（别拖出屏幕找不回来）。
        """
        w = _WIN
        if w is None:
            return False
        try:
            cur_x, cur_y = int(w.x), int(w.y)
            tx, ty = cur_x + int(dx), cur_y + int(dy)
            # 夹取：至少留 60px 在屏幕内（不然窗口能被拖到看不见的地方）
            try:
                u32 = ctypes.windll.user32
                vx = u32.GetSystemMetrics(76)      # SM_XVIRTUALSCREEN
                vy = u32.GetSystemMetrics(77)      # SM_YVIRTUALSCREEN
                vw = u32.GetSystemMetrics(78)      # SM_CXVIRTUALSCREEN
                vh = u32.GetSystemMetrics(79)      # SM_CYVIRTUALSCREEN
                keep = 60
                tx = max(vx - 0, min(tx, vx + vw - keep))
                ty = max(vy - 0, min(ty, vy + vh - keep))
            except Exception:                                     # noqa: BLE001
                pass
            w.move(tx, ty)
        except Exception as e:                                    # noqa: BLE001
            if os.environ.get("HERONBO_DRAG_DEBUG"):
                try:
                    with open(os.path.join(os.environ.get("TEMP") or ".", "heronbo_drag.log"),
                              "a", encoding="utf-8") as f:
                        f.write("  !! move 失败(cur=%s,%s d=%s,%s)：%s\n"
                                % (cur_x, cur_y, dx, dy, e))
                except Exception:                                 # noqa: BLE001
                    pass
            return False
        if os.environ.get("HERONBO_DRAG_DEBUG"):
            try:
                with open(os.path.join(os.environ.get("TEMP") or ".", "heronbo_drag.log"),
                          "a", encoding="utf-8") as f:
                    f.write("win_move (%s,%s)+(%s,%s) -> (%s,%s)\n"
                            % (cur_x, cur_y, dx, dy, tx, ty))
            except Exception:                                     # noqa: BLE001
                pass
        return True

    def _native_hwnd(self):
        """主窗体的 Win32 句柄（win.native ＝ pywebview 的 BrowserForm）。"""
        try:
            return int(_WIN.native.Handle.ToInt64())     # pythonnet 3 的 IntPtr 不吃 int()
        except Exception:                                         # noqa: BLE001
            return 0

    def _native_drag(self, hit_code):
        """把移动/缩放**交给 Windows 原生循环**（2026-10-06 加，修拖动残影）。

        为什么不用 JS 流式驱动（老做法：每次 mousemove 从桥线程 SetWindowPos）：
        无边框窗口被外部线程一步一步挪，DWM 不知道这是一次"原生拖动"，
        旧位置的重绘跟不上 → 屏幕上留下一串窗口残影（用户 18:06 的录屏就是它）。

        ⚠️ 线程前提（2026-10-06 二修，用户实测"彻底拖不动"）：经典配方
        ReleaseCapture + SendMessage(WM_NCLBUTTONDOWN, HT*) 必须在**拥有窗口的
        GUI 线程**上执行——捕获是按线程记的，WebView2 的捕获在 GUI 线程手里，
        从 JS 桥的后台线程放捕获是空放，模态循环起不来 = 纹丝不动；而且这版把
        标题栏的流式拖动删了，没有兜底就成了"彻底拖不动"。
        修法：整段动作 **Form.BeginInvoke 投递到 GUI 线程**（SendMessage 会阻塞
        GUI 线程直到拖完——那正是模态循环在泵消息，窗口照样活着）。
        起不动原生循环就如实返回 False，让页面退回流式兜底。
        """
        w = _WIN
        form = getattr(w, "native", None) if w is not None else None
        if form is None:
            return False
        if self._max:
            return False                                   # 最大化时不拖不拉
        try:
            from System import Action                      # pythonnet（pywebview 已加载）
        except Exception:                                  # noqa: BLE001
            Action = None

        def _go():
            try:
                u32 = ctypes.windll.user32
                # ⚠️ pythonnet 3 的 System.IntPtr 不吃 int()——必须 ToInt64()
                #（2026-10-06 实测：int(form.Handle) 抛 TypeError，原生循环永远起不来，
                #  而 BeginInvoke 已返回 true，页面的流式兜底也就永远不触发 → "彻底拖不动"）
                hwnd = int(form.Handle.ToInt64())
                u32.ReleaseCapture()                       # 必须在 GUI 线程：放掉 WebView2 的捕获
                u32.SendMessageW(hwnd, 0x00A1, hit_code, 0)   # WM_NCLBUTTONDOWN
                if os.environ.get("HERONBO_DRAG_DEBUG"):
                    try:
                        with open(os.path.join(os.environ.get("TEMP") or ".",
                                               "heronbo_drag.log"), "a", encoding="utf-8") as f:
                            f.write("_go ran: hwnd=%s hit=%s cap_after=%s\n"
                                    % (hwnd, hit_code, u32.GetCapture()))
                    except Exception:                      # noqa: BLE001
                        pass
            except Exception as e:                         # noqa: BLE001
                if os.environ.get("HERONBO_DRAG_DEBUG"):
                    try:
                        with open(os.path.join(os.environ.get("TEMP") or ".",
                                               "heronbo_drag.log"), "a", encoding="utf-8") as f:
                            f.write("_go FAILED: %r\n" % (e,))
                    except Exception:                      # noqa: BLE001
                        pass

        if Action is not None:
            try:
                form.BeginInvoke(Action(_go))
                if os.environ.get("HERONBO_DRAG_DEBUG"):
                    try:
                        with open(os.path.join(os.environ.get("TEMP") or ".",
                                               "heronbo_drag.log"), "a", encoding="utf-8") as f:
                            f.write("win_drag_native: begininvoked hit=%s\n" % hit_code)
                    except Exception:                      # noqa: BLE001
                        pass
                return True
            except Exception as e:                         # noqa: BLE001
                if os.environ.get("HERONBO_DRAG_DEBUG"):
                    try:
                        with open(os.path.join(os.environ.get("TEMP") or ".",
                                               "heronbo_drag.log"), "a", encoding="utf-8") as f:
                            f.write("BeginInvoke FAILED: %r\n" % (e,))
                    except Exception:                      # noqa: BLE001
                        pass
        return False                                       # 起不动原生循环 → 页面走流式兜底

    def win_drag_native(self):
        """标题栏按住 → 原生移动循环（HTCAPTION）。"""
        return self._native_drag(2)                        # HTCAPTION

    def win_resize_native(self, anchor="se"):
        """边缘热区按住 → 原生缩放循环（HTLEFT/HTRIGHT/…）。"""
        ht = {"n": 12, "s": 15, "w": 10, "e": 11,
              "nw": 13, "ne": 14, "sw": 16, "se": 17}.get((anchor or "se").lower(), 17)
        return self._native_drag(ht)

    def win_resize(self, dx=0, dy=0, anchor="se"):
        """拉伸无边框窗口（页面边缘的隐形热区按住时由 shell.js 调；2026-10-06 加）。

        为什么要有：frameless=True 之后 Windows 不给边缘拖拽把手，用户"不能调整大小"
        ——pywebview 6 没有现成的边缘 resize，所以在页面四周放 8 条隐形热区（shell.js），
        鼠标按住拖动时把**增量 + 从哪条边拖**发到这里。

        ⚠️ 方向坑（2026-10-06 第一版实测翻车：新机上"拖小反而放大"）：
        宽度变化的方向**取决于抓的是哪条边**——抓东（右）缘，右移 = 变宽（tw=cur+dx）；
        抓西（左）缘，右移 = 变窄（tw=cur-dx，左缘往右走）。北/南缘同理管高度。
        第一版对四条边一律 cur+dx/cur+dy，西/北两条边方向全反。
        另外只算抓的那条轴（抓 n/s 缘时 dx 不参与，反之亦然）。
        单位：pywebview 的 width/resize/screenX 全是逻辑像素，不需要再乘 DPI
        （winforms.py：resize 入参乘 scale 转物理，get_size 除 scale 回逻辑，一致）。
        `anchor`＝用户抓住的那条边/角（n/s/e/w/ne/nw/se/sw）——resize 时固定**对侧**。
        最大化状态下不接受拉伸（要先还原），与 win_max 的 `_max` 状态对齐。
        """
        w = _WIN
        if w is None:
            return False
        if self._max:
            return False                                   # 最大化时先还原再拉
        try:
            from webview.window import FixPoint
            a = (anchor or "se").lower()
            cur_w, cur_h = int(w.width), int(w.height)
            dx, dy = int(dx), int(dy)
            tw, th = cur_w, cur_h
            if "e" in a:                                   # e / ne / se / Corner 带东
                tw = cur_w + dx
            elif "w" in a:                                 # w / nw / sw：反号
                tw = cur_w - dx
            if "s" in a:                                   # s / se / sw
                th = cur_h + dy
            elif "n" in a:                                 # n / ne / nw：反号
                th = cur_h - dy
            try:
                u32 = ctypes.windll.user32
                vw = u32.GetSystemMetrics(78)              # SM_CXVIRTUALSCREEN
                vh = u32.GetSystemMetrics(79)              # SM_CYVIRTUALSCREEN
                tw, th = min(tw, vw or tw), min(th, vh or th)
            except Exception:                              # noqa: BLE001
                pass
            tw = max(getattr(WinCtl, "_min", (1180, 700))[0], min(tw, 12000))
            th = max(getattr(WinCtl, "_min", (1180, 700))[1], min(th, 12000))
            if tw == cur_w and th == cur_h:
                return True
            # 固定对侧：抓哪条边/角，对面就钉住（往右缘拉钉左上、往左缘拉钉右上…）
            _FIX = {
                "e":  FixPoint.WEST | FixPoint.NORTH,
                "w":  FixPoint.EAST | FixPoint.NORTH,
                "s":  FixPoint.WEST | FixPoint.NORTH,
                "n":  FixPoint.WEST | FixPoint.SOUTH,
                "se": FixPoint.WEST | FixPoint.NORTH,
                "sw": FixPoint.EAST | FixPoint.NORTH,
                "ne": FixPoint.WEST | FixPoint.SOUTH,
                "nw": FixPoint.EAST | FixPoint.SOUTH,
            }
            w.resize(tw, th, _FIX.get(a, FixPoint.WEST | FixPoint.NORTH))
            return True
        except Exception:
            return False

    def win_close(self):
        """叉号：有任务在跑时先问「后台继续 / 停止退出 / 不关」。

        2026-11 用户实测：点叉号＝直接 destroy 进程，agent 却可能还活着，重开创作台
        又拉起一轮豆包工作。现在三选一：
          是   = 隐藏窗口，服务与 agent 继续跑（再点创作台图标会恢复这个窗口）
          否   = 停掉这一轮（连子进程）再退出
          取消 = 什么都不做
        没有任务在跑时保持原来的「直接关」。
        """
        running = bool(_PROG.get("running") and not _PROG.get("done"))
        if not running:
            # 没有任务直接关：把"后台隐藏"标记清掉，否则 wait_and_exit 会一直以为
            # 窗口还在后台跑，进程永远不退。
            _PROG["windowHidden"] = False
        if running and os.name == "nt":
            try:
                import ctypes
                r = ctypes.windll.user32.MessageBoxW(
                    0,
                    "创作台里还有任务在跑。\n\n"
                    "是：最小化到后台，任务继续跑（再点创作台图标会恢复）\n"
                    "否：停止这一轮任务并退出\n"
                    "取消：不关，继续用",
                    "HeronBo 创作台",
                    0x00000003 | 0x00000020 | 0x00040000)   # YESNOCANCEL | QUESTION | TOPMOST
                if r == 2:                                   # 取消
                    return False
                if r == 6:                                   # 是：隐藏，不 destroy
                    try:
                        _WIN.hide()
                        with _PROG_LOCK:
                            _PROG["windowHidden"] = True
                            _PROG.setdefault("lines", []).append(
                                "· 窗口已最小化到后台；任务继续跑，重开创作台会接回这个窗口")
                        return True
                    except Exception:                        # noqa: BLE001
                        return False
                # 否：先停 agent，再 destroy（不能只关窗口把 agent 留成孤儿）
                _STOPPED["flag"] = True
                try:
                    if abridge:
                        abridge.stop_current()
                except Exception:                            # noqa: BLE001
                    pass
                prev = _job_snapshot()
                pid = int((prev or {}).get("agent_pid") or 0)
                if pid:
                    _kill_job_process(pid)
                _clear_job(force=True)
                _PROG["windowHidden"] = False
            except Exception:                                # noqa: BLE001
                pass
        try:
            _WIN.destroy()
        except Exception:                                     # noqa: BLE001
            return False
        return True


def _workarea_logical():
    """主屏工作区（任务栏以外的可用区域），**逻辑像素**（96-DPI 基准）。

    为什么要有：默认窗体 1520x940 是按大屏设计的——小屏/高 DPI 的机器上
    （比如 1366 物理 × 150% ＝ 911 逻辑宽）窗口直接比屏幕还大，右半截出屏、
    可见部分挤成一团（2026-10-06 新机实测）。SystemParametersInfoW 拿到的 RECT
    在 DPI-aware 进程里是物理像素，除以系统 DPI 回逻辑；不感知 DPI 的进程里
    它本来就是 96 基准，除以 96 不变——两种情况这套除法都成立。
    """
    try:
        import ctypes.wintypes as wt
        u32 = ctypes.windll.user32
        rect = wt.RECT()
        if u32.SystemParametersInfoW(0x0030, 0, ctypes.byref(rect), 0):   # SPI_GETWORKAREA
            try:
                dpi = u32.GetDpiForSystem() or 96
            except Exception:                                          # noqa: BLE001
                dpi = 96
            s = dpi / 96.0
            return (max(400, int((rect.right - rect.left) / s)),
                    max(320, int((rect.bottom - rect.top) / s)))
    except Exception:                                                  # noqa: BLE001
        pass
    return 1520, 900


def native_window(title, url, width=1520, height=940):
    """用 pywebview 开一个**独立窗口**（内嵌 WebView2），返回 True 表示"界面真的出来了"。

    这是首选路径：窗口属于本程序自己——自己的标题、图标、任务栏条目，没有地址栏；
    也不用借用户正在用的 Edge 浏览器（2026-09-15 用户明确要求"变成独立程序而不是
    依赖 Edge"）。WebView2 **运行时**是系统组件（Win10/11 自带，Teams/微信都在用），
    不是用户的浏览器进程，关掉浏览器不影响它。

    **白窗看门狗（2026-09-16 加）**：窗口开出来 ≠ 界面出来了。WebView2 坏掉时是
    "标题有、里面一片空白"，而 pywebview 的报错发生在 GUI 线程里、程序自己吞掉，
    调用方完全看不出来（别的机器就这么白屏了）。所以这里盯**页面有没有真连上来**
    （静态页被拉取 / 心跳到达都算）：25 秒还没有 → 认定白窗，关掉它并返回 False，
    让调用方退到 Edge 窗口 / 默认浏览器，并留下体检结论与修复步骤。
    """
    try:
        import webview
    except ImportError:
        return False
    store = os.path.join(os.environ.get("LOCALAPPDATA") or os.path.expanduser("~"),
                         "HeronBoScoreTool", "webview")
    try:
        os.makedirs(store, exist_ok=True)
    except OSError:
        store = None
    Handler.loaded_at = 0.0            # 页面真被拉取的时刻（看门狗与调用方都看它）
    t0 = time.time()
    state = {"ok": False, "blank": False}
    # 屏幕适配（2026-10-06 新机实测：小屏/高 DPI 机器上默认 1520x940 比屏幕还大，
    # 可见部分挤成一团）：初始尺寸与 min_size 都**夹进工作区**；前端再按屏幕比例
    # zoom（shell.js 的 fitZoom），内容整体等比缩放、不挤不裁。
    avail_w, avail_h = _workarea_logical()
    width = max(960, min(width, avail_w - 16))
    height = max(600, min(height, avail_h - 16))
    min_size = (min(1180, max(720, avail_w - 16)), min(700, max(480, avail_h - 16)))
    WinCtl._min = min_size            # win_resize 的下限跟它走（别写死，小屏上会顶死）
    try:
        # 无边框（2026-09-17 用户要求，照钉钉那种客户端）：系统标题栏收进页面内，
        # 页面里那一条自绘标题栏才是唯一的顶栏。
        #   frameless=True     去掉系统边框/标题栏
        #   easy_drag=False    只有带 .pywebview-drag-region 的区域能拖窗口 ——
        #                      否则整窗可拖，会跟页面里的滑块/素材列表拖动打架
        #   js_api=WinCtl()    页面上的最小化/最大化/关闭按钮走这个桥
        # 老版本 pywebview 不认这些参数就退回有边框窗口（宁可有边框，也别起不来）。
        try:
            win = webview.create_window(title, url, width=width, height=height,
                                        min_size=min_size, text_select=True,
                                        frameless=True, easy_drag=False,
                                        js_api=WinCtl())
        except TypeError:
            win = webview.create_window(title, url, width=width, height=height,
                                        min_size=min_size, text_select=True)
        global _WIN
        _WIN = win

        def _show():
            """显式 show/restore：实测（2026-09-15）打包后窗口会以**最小化**状态起来
            （任务栏上只有 160x28 一条），不还原的话用户以为程序没打开。"""
            time.sleep(1.2)
            for fn in ("show", "restore", "on_top"):
                try:
                    getattr(win, fn)()
                except Exception:                                # noqa: BLE001
                    pass

        def _watch():
            """等页面连上来；等不到就是白窗——关掉它，让调用方走退路。"""
            # 默认 25 秒；验证/排查时可以调小（HERONBO_WV2_TIMEOUT 秒）
            try:
                budget = float(os.environ.get("HERONBO_WV2_TIMEOUT") or 25)
            except ValueError:
                budget = 25.0
            for _ in range(max(2, int(budget * 2))):
                time.sleep(0.5)
                if Handler.loaded_at > t0 or Handler.last_ping > t0:
                    state["ok"] = True
                    return
                if not _win_alive():
                    return                                       # 窗口已被用户关掉
            state["blank"] = True
            try:
                with open(os.path.join(os.environ.get("TEMP", "."),
                                       "heronbo_webview2.txt"), "w", encoding="utf-8") as f:
                    f.write("独立窗口开出来了，但 25 秒内界面一直是白的（页面没连上来）。\n"
                            "多半是 WebView2 运行库坏了/缺文件。已改用 Edge 窗口打开。\n\n"
                            + WEBVIEW2_HELP + "\n")
            except OSError:
                pass
            print("[创作台] 独立窗口是白窗（WebView2 没跑起来）→ 改用 Edge 窗口。\n"
                  + WEBVIEW2_HELP, flush=True)
            for fn in ("destroy", "hide"):
                try:
                    getattr(win, fn)()
                    break
                except Exception:                                # noqa: BLE001
                    pass

        def _boot():
            threading.Thread(target=_show, daemon=True).start()
            threading.Thread(target=_watch, daemon=True).start()

        kw = {}
        if store:
            kw["storage_path"] = store
        try:
            webview.start(_boot, **kw)       # _boot 在 GUI 起来后（另起线程）被调用
        except TypeError:             # 老版本没有 storage_path
            webview.start(_boot)
        if state["blank"]:
            return False                 # 白窗 → 让调用方退 Edge / 浏览器
        return True
    except Exception as e:                                       # noqa: BLE001
        try:
            open(os.path.join(os.environ.get("TEMP", "."), "heronbo_webview_error.log"),
                 "w", encoding="utf-8").write("pywebview 起不来：%r" % (e,))
        except OSError:
            pass
        return False


def _win_alive():
    try:
        return bool(_WIN) and not _WIN.events.closed.is_set()
    except Exception:                                            # noqa: BLE001
        return True


def find_edge():
    """找系统 Edge 的可执行文件（只在"独立窗口起不来"时当**退路**用）。"""
    import glob as _glob
    cands = [r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
             r"C:\Program Files\Microsoft\Edge\Application\msedge.exe"]
    for c in cands:
        if os.path.isfile(c):
            return c
    hits = _glob.glob(os.path.join(os.environ.get("LOCALAPPDATA", ""),
                                   "Microsoft", "Edge", "Application", "msedge.exe"))
    return hits[0] if hits else None


# ── WebView2 运行库体检（2026-09-16 新机踩坑后加的）────────────────────────────
# 别的机器上遇到的现象：双击创作台，**窗口开出来一片空白**（标题有、里面什么都没有），
# 因为 WebView2 运行库"注册表说有、实际上缺文件"：
# 注册表指向 ...\EdgeWebView\Application\134.0.3124.93\，而该目录里 msedgewebview2.exe
# 不见了（284MB 的 msedge.dll 还在）→ pywebview 报
# "Couldn't find a compatible Webview2 Runtime installation to host WebViews"（0x80070002）。
# **只查注册表会误判成"装了"**，所以这里既看注册表、也看那个版本目录里宿主 exe 在不在；
# 注册表指的那个坏了、但别的版本是完整的，就报"可疑"（让它试，白窗兜底在后面）。
WEBVIEW2_GUID = "{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
WEBVIEW2_HELP = ("修法：装微软官方运行库（一次就好，之后所有用 WebView2 的程序都不再白屏）\n"
                 "       下载 https://go.microsoft.com/fwlink/p/?LinkId=2124703 （Evergreen "
                 "Bootstrapper，MicrosoftEdgeWebview2Setup.exe）\n"
                 "       或跑：python tools\\部署.py fix-webview2 --yes")


def _wv2_dirs(version):
    out = []
    for base in (r"C:\Program Files (x86)\Microsoft\EdgeWebView\Application",
                 r"C:\Program Files\Microsoft\EdgeWebView\Application",
                 os.path.join(os.environ.get("LOCALAPPDATA", ""),
                              "Microsoft", "EdgeWebView", "Application")):
        if version:
            out.append(os.path.join(base, version, "msedgewebview2.exe"))
        out.append(base)
    return out


def webview2_versions():
    """磁盘上装了哪些 WebView2 版本（目录名），以及哪个是完整的（宿主 exe 在）。"""
    import glob as _glob
    good, allv = [], []
    base = r"C:\Program Files (x86)\Microsoft\EdgeWebView\Application"
    bases = [base, r"C:\Program Files\Microsoft\EdgeWebView\Application",
             os.path.join(os.environ.get("LOCALAPPDATA", ""),
                          "Microsoft", "EdgeWebView", "Application")]
    for b in bases:
        for d in _glob.glob(os.path.join(b, "*")):
            if not os.path.isdir(d):
                continue
            v = os.path.basename(d)
            if not re.match(r"^\d+\.", v):
                continue
            allv.append(v)
            if os.path.isfile(os.path.join(d, "msedgewebview2.exe")):
                good.append(v)
    return sorted(set(allv)), sorted(set(good))


def webview2_registered():
    """注册表里"当前生效"的 WebView2 版本（per-user 优先，再 per-machine）。"""
    try:
        import winreg
    except ImportError:
        return ""
    for hive, key in ((winreg.HKEY_CURRENT_USER, r"SOFTWARE\Microsoft\EdgeUpdate\Clients"),
                      (winreg.HKEY_LOCAL_MACHINE,
                       r"SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients"),
                      (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\EdgeUpdate\Clients")):
        try:
            with winreg.OpenKey(hive, key + "\\" + WEBVIEW2_GUID) as k:
                v = winreg.QueryValueEx(k, "pv")[0]
                if v and v != "0.0.0.0":
                    return str(v)
        except OSError:
            continue
    return ""


def webview2_state():
    """WebView2 到底能不能用 → `(ok, 版本, 说明)`。

    - `ok=True`：注册表版本目录里有宿主 exe（pywebview 有戏）
    - `ok=False`：一个完整版本都没有 / 注册表指的那个缺文件且没有别的可用版本
      （此时**不要**开 pywebview 窗口，直接退 Edge，免得用户对着白窗发呆）
    """
    if os.name != "nt":
        return True, "", "非 Windows，交给 pywebview 自己判断"
    reg = webview2_registered()
    allv, good = webview2_versions()
    if reg:
        ok_reg = os.path.isfile(_wv2_dirs(reg)[0])
        if ok_reg:
            return True, reg, "注册表版本 %s 完整" % reg
        if good:
            return True, good[-1], ("注册表指的 %s 缺 msedgewebview2.exe，但磁盘上还有完整的 %s"
                                    "（可能仍会白屏）" % (reg, good[-1]))
        return False, reg, ("注册表写着装了 %s，但那个目录里**没有 msedgewebview2.exe**"
                            "（运行库坏了）" % reg)
    if good:
        return True, good[-1], "磁盘上有 %s（注册表没记）" % good[-1]
    return False, "", "本机没装 WebView2 运行库（Win10/11 一般自带；缺了就装一下）"


def _wv2_report(ok, ver, why):
    log_p = os.path.join(os.environ.get("TEMP", "."), "heronbo_webview2.txt")
    try:
        with open(log_p, "w", encoding="utf-8") as f:
            f.write("WebView2 体检：%s\n版本：%s\n说明：%s\n\n%s\n"
                    % ("可用" if ok else "不可用", ver or "（未检出）", why, WEBVIEW2_HELP))
    except OSError:
        pass
    print("[创作台] WebView2 体检：%s（%s）" % ("可用" if ok else "**不可用**", why), flush=True)
    if not ok:
        print("[创作台] 独立窗口用不了，改用 Edge 窗口打开。\n" + WEBVIEW2_HELP, flush=True)


DEFAULT_PORT = 17979   # 固定默认端口：localStorage 按「协议+主机+端口」隔离，端口一变
                       # 主题/侧栏/提示音开关这些偏好就全丢（跨重启保留 UI 偏好用）


def _port_listening(port, host="127.0.0.1"):
    """这个端口上有没有人真的在听。**不能靠 bind 报错判断**：http.server 自带
    allow_reuse_address=1，Windows 下同一端口 bind 两次都「成功」（第二次悄悄顶掉第一次），
    测试实踩过（2026-09-21）。"""
    sck = socket.socket()
    try:
        sck.settimeout(0.3)
        sck.connect((host, port))
        return True
    except OSError:
        return False
    finally:
        sck.close()


def serve(root="", port=0, host="127.0.0.1"):
    Handler.root = root or ""
    if port:
        busy = _port_listening(port, host)
        if busy and port == DEFAULT_PORT:
            port = 0          # 默认端口已有人听着（多半是另一个创作台）→ 退随机：
                              # 功能不受影响，只是这一轮偏好存不住
        elif busy:
            raise OSError("端口 %d 已被占用（--port 显式指定的自动化端口不退让）" % port)
    # 更新相关（2026-09-22）：① 旧 exe 备份只留最近 2 个（自更新的助手只认 ASCII 名，
    # 与 换exe.py 的中文名两套都要收）；② 开窗 5 秒后静默查一次远端，有新版本就在
    # 标题条「检查更新」上点个小圆点——**不阻塞开窗、离线也不报错**。
    try:
        tidy_backups()
    except Exception:                                            # noqa: BLE001
        pass
    try:
        threading.Thread(target=_peek_once, args=(5.0,), daemon=True).start()
    except Exception:                                            # noqa: BLE001
        pass
    srv = ThreadingHTTPServer((host, port or 0), Handler)
    srv.pending = []
    srv.need = ""            # 用户填的「简单需求」（还没建项目时先记在这，建框架时带进去）
    srv.daemon_threads = True
    Handler.port = srv.server_address[1]
    try:
        _recover_job(Handler.port)  # 重开创作台时接回上一轮还在后台跑的 agent，避免重复拉起
    except Exception:                                        # noqa: BLE001
        pass
    return srv


def wait_and_exit(srv, idle=25, total=None):
    """页面关了（心跳停了）就自己退，别留个孤儿进程。

    但**任务还在跑时不能退**：退了就只剩一个没人管的 agent 子进程，重开创作台
    还会被当成"没有实例"再拉起一轮。等这一轮跑完再收摊。
    """
    t0 = time.time()
    while True:
        time.sleep(2)
        busy = bool((_PROG.get("running") and not _PROG.get("done")
                     and (agent_proc_alive() or _PROG.get("detached_pid")))
                    or _PROG.get("windowHidden"))
        if time.time() - Handler.last_ping > idle and time.time() - t0 > 12 and not busy:
            break
        if total and time.time() - t0 > total and not busy:
            break
    srv.shutdown()


