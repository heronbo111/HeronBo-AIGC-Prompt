def _hist_eta(pdir, what=""):
    """整轮历史耗时中位数；同类任务优先，样本不足退回全体。"""
    p = os.path.join(pdir, "_会话", "耗时.jsonl") if pdir else ""
    vals, vals_all, has_kind = [], [], False
    if p and os.path.isfile(p):
        for line in open(p, encoding="utf-8", errors="replace"):
            try:
                o = json.loads(line)
                v = float(o.get("seconds") or 0)
                k = o.get("what") or ""
            except (ValueError, TypeError):
                continue
            if not (5 < v < 3600):
                continue
            vals_all.append(v)
            if k:
                has_kind = True
                if k == (what or ""):
                    vals.append(v)
    # 同类不足 2 次退回全体
    if len(vals) >= 2 or (vals and not vals_all):
        vals.sort()
        return vals[len(vals) // 2], len(vals)
    if vals_all:
        vals_all.sort()
        return vals_all[len(vals_all) // 2], len(vals_all)
    return 180.0, 0


