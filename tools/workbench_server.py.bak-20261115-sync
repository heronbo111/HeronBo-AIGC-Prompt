                                     "path": (wcli.resolve()[0] or "")}
            else:
                out["doubao_cli"] = {"ok": False, "detail": "缺 wb_cli.py", "version": ""}
        except Exception as e:                                   # noqa: BLE001
            out["doubao_cli"] = {"ok": False, "detail": str(e)[:200], "version": ""}
        # 2c) 工作台技能：只读扫描 CLI / agent 技能根目录，登录与技能分开判定
        try:
            out["skills"] = wcli.skill_status() if wcli else {
                "ok": False, "complete": False, "items": [], "roots": [],
                "error": "缺 wb_cli.py"}
        except Exception as e:                                   # noqa: BLE001
            out["skills"] = {"ok": False, "complete": False, "items": [], "roots": [],
                             "error": str(e)[:200]}
        # 3) 即梦 CLI（装没装 / 登没登录 / 余额）
        try:
            acc = wdreamina.account() if wdreamina else {"ok": False, "error": "缺 wb_dreamina.py"}
            if acc.get("ok"):
                out["dreamina"] = {"ok": True, "cli": acc.get("cli") or "",
                                   "detail": "余额 %s 点（%s）" % (acc.get("total_credit"),
                                                                  acc.get("vip_level") or "?")}
            else:
                out["dreamina"] = {"ok": False, "detail": str(acc.get("error") or "不可用")[:240]}
        except Exception as e:                                   # noqa: BLE001
            out["dreamina"] = {"ok": False, "detail": str(e)[:200]}
        # 4) 其它 agent 通道（扫描摘要）
        try:
            rows = abridge.list_agents() if abridge else []
            out["agents"] = [{"key": r.get("key"), "label": r.get("label") or r.get("key"),
                              "ok": bool(r.get("ok")), "why": str(r.get("why") or "")[:140]}
                             for r in rows]
        except Exception:                                        # noqa: BLE001
            out["agents"] = []
        # 5) 项目库：配了 + 目录在 = 可用；写探测只作为提示，不参与判定
        #    （2026-10-26 实踩：打包版里试写被系统/杀软拦成 Permission denied，
        #     但目录其实能写——不能因此把项目库判成不可用，把用户挡在门外）
        try:
            root = ((pcore.read_local() or {}).get("SAMPLES_ROOT") if pcore else "") or Handler.root or ""
            root = root.strip()
            okw = bool(root) and os.path.isdir(root)
            if not root:
                detail = "还没选项目库目录"
            elif not okw:
                detail = "目录不存在：%s" % root
            else:
                detail = "可写"
                try:
                    import tempfile
                    fd, t = tempfile.mkstemp(prefix=".heronbo_write_test_", dir=root)
                    os.close(fd)
                    try:
                        os.remove(t)
                    except OSError:
                        pass
                except OSError as e:
                    detail = "可读（写入探测被拦了一次：%s；真写不进去时按提示处理）" % str(e)[:80]
            out["project"] = {"ok": okw, "path": root, "detail": detail}
        except Exception as e:                                   # noqa: BLE001
            out["project"] = {"ok": False, "path": "", "detail": str(e)[:200]}
        # 2026-11-13：默认只看 CLI；只有用户手动切到 CDP 时，才把 CDP 计入生成通道。
        # 即梦 / 其它 agent 仍可作为出提示词或分镜通道，不因豆包 CDP 可用就假装“全部就绪”。
        cli_ok = bool(out["doubao_cli"]["ok"])
        cdp_mode = bool((out.get("video_bridge") or {}).get("mode") == "cdp")
        gen_ok = bool(out["doubao"]["ok"]) if cdp_mode else cli_ok
        ch_ok = bool(gen_ok or out["dreamina"]["ok"]
                     or any(x.get("ok") for x in out["agents"]))
        out["channels_ok"] = ch_ok
        out["ready"] = bool(out["env"]["ok"] and ch_ok and out["project"]["ok"])
        return out

    def set_root(self, b):
        """改项目库：写进技能仓库的 references/paths.local.md（本机取值，不进 git）。"""
        d = (b.get("dir") or "").strip()
        if not d or not os.path.isdir(d):
            return {"ok": False, "error": "目录不存在：%s" % d}
        d = os.path.abspath(d)
        if not pcore:
            return {"ok": False, "error": "缺 project_core.py"}
        try:
            pcore.write_local(SAMPLES_ROOT=d)
        except Exception as e:                                   # noqa: BLE001
            return {"ok": False, "error": "写配置失败：%s" % e}
        Handler.root = d
        return {"ok": True, "root": d,
                "samples": _samples(d), "wrote": pcore.LOCAL_MD}

    def intake(self, b):
        paths = b.get("paths") or []
        pend = self._pending()
        pdir = self._proj()
        for p in paths:
            p = os.path.normpath(p)
            if p and (os.path.isfile(p) or os.path.isdir(p)) and p not in pend:
                pend.append(p)
        if pdir:
            save_pending(pdir, pend)        # 持久化：创作台重启不丢（2026-10-08）
        plan = None
        if pcore and pend:
            try:
                plan = pcore.auto_plan(pend)
            except Exception as e:                               # noqa: BLE001
                return {"ok": False, "error": "规划失败：%s" % e, "pending": pend}
        return {"ok": True, "pending": pend, "plan": plan}

    def _intake_register(self, pdir, files, roles=None, on_log=None):
        """兼容旧调用点：登记逻辑已抽到模块级 `register_intake_materials`（agent 起跑前也要用）。"""
        return register_intake_materials(pdir, files, roles=roles, on_log=on_log)

    def intake_go(self, b):
        pend = self._pending()
        pdir0 = self._proj(b)
        # 没素材也让它干一件有用的事：**把框架建出来**（2026-09-16 用户："新建项目了点击框架"）
        # 新建的空项目还没有 框架.json，这时点「建框架归类」原本只报"还没有待投放的素材"，
        # 用户看着像"点了没反应"。这里改成：把骨架（含 框架.json/框架.md/状态.json）建出来并说明。
        if not pend:
            if pdir0 and os.path.isdir(pdir0) and self.heal_skeleton(pdir0):
                return {"ok": True, "built": True, "project": _scan_project(pdir0),
                        "note": "框架已建好（还没有素材）：把素材拖进②栏，再点一次就能按角色归类"}
            return {"ok": False, "error": "还没有待投放的素材——先把素材拖进②栏"}
        if not pcore:
            return {"ok": False, "error": "缺 project_core.py"}
        root = b.get("root") or Handler.root or detect_root()
        if not root:
            return {"ok": False, "error": "没有项目库，请先选"}
        active_root = Handler.root or detect_root()
        if active_root and os.path.normcase(_norm_path(root)) != os.path.normcase(_norm_path(active_root)):
            return {"ok": False, "error": "拒绝归类：目标项目库不是当前项目库"}
        # ★ 2026-09-30 用户裁定（新机截图：拖进 test1 的素材"没有被扔到素材框架里"）：
        # **有当前项目就归进当前项目**，绝不 auto_build 另起新项目——原行为把素材归进
        # 按文件名自动新建的「跑表p1」，用户手动建的 test1 永远空框架（counts 全 0），
        # agent 解析只看到"无素材文件"。"没建项目就拖素材"的自动建项目老路保留在下面。
        if pdir0 and os.path.isdir(pdir0):
            try:
                plan = pcore.auto_plan(list(pend), root=root,
                                       on_log=lambda s: _push_line("[归类] " + str(s)))
            except Exception as e:                               # noqa: BLE001
                return {"ok": False, "error": "规划失败：%s" % e, "pending": pend}
            roles = {it.get("name"): it.get("role") for it in (plan.get("items") or [])}
            total = self._intake_register(pdir0, list(pend), roles=roles,
                                          on_log=lambda s: _push_line("[归类] " + str(s)))
            if not total:
                # 同一批素材再点一次时 add_materials 按 hash 去重返回 0；
                # 它们其实已经在框架里，不能报“归类失败”（用户会以为素材没识别到）。
                try:
                    want = {os.path.basename(f).lower()
                            for f in pcore.collect_files(list(pend))}
                    have = {(m.get("name") or os.path.basename(str(m.get("file") or "")).lower()
                            ).lower()
                            for m in (materials_payload(pdir0) or []) if isinstance(m, dict)}
                    total = len(want & have)
                except Exception:                                # noqa: BLE001
                    total = 0
            if not total:
                return {"ok": False, "error": "归类失败：素材没能登记进当前项目",
                        "pending": pend}
            del pend[:]
            save_pending(pdir0, pend)       # 持久化同步清空（2026-10-08）
            _invalidate_samples(Handler.root or detect_root())
            return {"ok": True, "project": _scan_project(pdir0),
                    "plan": {"count": total}}
        try:
            pdir, plan, _log = pcore.auto_build(
                list(pend), root=root, name=b.get("name") or None,
                platform=b.get("platform") or "",
                # register=False：**建项目时别顺手改全局项目库**。2026-09-15/16 两次踩到——
                # 用临时目录跑这一步，SAMPLES_ROOT 就被写成临时目录，临时目录一清，界面
                # 只剩「配置里的项目库不存在」。要换根只有一处：界面「选项目库」→ /api/root。
                register=False,
                on_log=lambda s: _push_line("[归类] " + str(s)))
        except Exception as e:                                   # noqa: BLE001
            return {"ok": False, "error": "建框架失败：%s" % e}
        if pdir and os.path.isdir(pdir):
            self._set_proj(pdir)
            del pend[:]
            save_pending(pdir, pend)        # 持久化同步清空（2026-10-08）
            # 建项目前填的「简单需求」带进新项目（用户可能先写需求再丢素材）
            if (self.server.need or "").strip():
                try:
                    self.save_need({"text": self.server.need, "project": pdir})
                except Exception:                                # noqa: BLE001
                    pass
        _invalidate_samples(root)
        return {"ok": bool(pdir), "project": _scan_project(pdir) if pdir else None,
                "plan": {"final_name": (plan or {}).get("final_name"),
                         "count": (plan or {}).get("count")}}
    # ---- 画布素材取用（2026-11-06 第1步）--------------------------------
    # 只做“复制一份进当前项目”：画布 store 不写、不删、不改 id；工作台侧仍然
    # 走 project_core.add_materials，保持素材清单/版本/@引用全部按原逻辑。
    def _canvas_asset_rows(self):
        """读画布 /api/media，返回带 /canvas 前缀的资产行。失败抛 RuntimeError。"""
        if not _canvas_health(2.0):
            try:
                ensure_canvas(wait=8.0)
            except Exception:                                    # noqa: BLE001
                pass
        if not _canvas_health(2.5):
            raise RuntimeError("画布服务没起来（%s）；先在画布页打开一次，或检查 %%LOCALAPPDATA%%\\"
                               "HeronBoScoreTool\\canvas.log" % CANVAS_URL)
        try:
            with urllib.request.urlopen(CANVAS_URL + "api/media", timeout=10.0) as r:
                raw = r.read()
            data = json.loads(raw.decode("utf-8", "ignore") or "{}")
        except Exception as e:                                   # noqa: BLE001
            raise RuntimeError("读画布素材失败：%s" % e)
        rows = []
        for a in (data.get("assets") or []):
            if not isinstance(a, dict) or not a.get("id"):
                continue
            item = dict(a)
            url = str(item.get("url") or "")
            if not url:
                url = "/api/media/" + urllib.parse.quote(str(item["id"]), safe="")
            # 前端统一从工作台同端口取，不走第二个端口
            item["url"] = ("/canvas" + url) if url.startswith("/") else url
            rows.append(item)
        # 2026-11-09：保留画布「最新在前」的语义（store.js listAssets 按 createdAt 降序）。
        # 以前这里按「image 优先 + 文件名」重排，把时间序彻底抹掉，前端拿到的第一件
        # 永远不是刚生成的那条——画布成片回显就只能靠猜。createdAt 缺失时保持原顺序。
        def _ct(a):
            try:
                return float(a.get("createdAt") or 0)
            except (TypeError, ValueError):
                return 0.0
        rows.sort(key=lambda x: -_ct(x))
        return rows

    def canvas_media(self):
        try:
            rows = self._canvas_asset_rows()
        except RuntimeError as e:                                # noqa: BLE001
            return {"ok": False, "error": str(e)}
        return {"ok": True, "assets": rows, "count": len(rows)}

    @staticmethod
    def _canvas_file_name(asset):
        """把画布资产名变成安全、工作台认得的文件名（保留中文）。"""
        name = os.path.basename(str(asset.get("name") or "").replace("\\", "/")).strip()
        name = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", name).strip(" .")
        sid = str(asset.get("id") or "")
        kind = str(asset.get("kind") or "")
        default_ext = {"image": ".png", "video": ".mp4", "audio": ".mp3"}.get(kind, "")
        stem, ext = os.path.splitext(name)
        if ext.lower() not in ALLOWED_UPLOAD_EXT:
            if not default_ext:
                return ""
            stem, ext = (stem or ("画布-" + sid[:8])), default_ext
        if not stem:
            stem = "画布-" + sid[:8]
        # 画布里很多图是“内容 hash 当文件名”，落到项目里也看不懂；换成画布-xxxxxxxx。
        if re.fullmatch(r"[0-9a-fA-F]{24,}", stem):
            stem = "画布-" + sid[:8]
        if len(stem) > 100:
            stem = stem[:100]
        return stem + ext

    def canvas_import(self, b):
        """把选中的画布 media 复制进当前项目素材夹并登记（幂等，按 hash 跳过重复）。"""
        pdir = self._proj(b)
        if not (pcore and pdir and os.path.isdir(pdir)):
            return {"ok": False, "error": "先选一个项目"}
        ids = b.get("ids") or []
        if not isinstance(ids, list) or not ids:
            return {"ok": False, "error": "没选素材"}
        ids = [str(x).strip() for x in ids if str(x).strip()]
        if not ids:
            return {"ok": False, "error": "没选素材"}
        if len(ids) > 30:
            return {"ok": False, "error": "一次最多取 30 件，分批来吧"}
        if any(not re.match(r"^[A-Za-z0-9_-]{4,64}$", x) for x in ids):
            return {"ok": False, "error": "画布素材 id 不合法"}

        try:
            rows = self._canvas_asset_rows()
        except RuntimeError as e:                                # noqa: BLE001
            return {"ok": False, "error": str(e)}
        byid = {str(a.get("id")): a for a in rows}
        added, skipped = [], []
        missing = [x for x in ids if x not in byid]
        for x in missing:
            skipped.append({"id": x, "why": "画布里已经找不到这件素材"})

        import tempfile
        tmpdir = tempfile.mkdtemp(prefix="heronbo_canvas_")
        try:
            for idx, sid in enumerate(ids):
                asset = byid.get(sid)
                if not asset:
                    continue
                name = self._canvas_file_name(asset)
                if not name:
                    skipped.append({"id": sid, "name": asset.get("name") or "",
                                    "why": "文件类型工作台不收"})
                    continue
                sub = os.path.join(tmpdir, "%03d" % idx)
                os.makedirs(sub, exist_ok=True)
                tmp = os.path.join(sub, name)
                total = 0
                try:
                    url = CANVAS_URL + "api/media/" + urllib.parse.quote(sid, safe="")
                    with urllib.request.urlopen(url, timeout=60.0) as r, open(tmp, "wb") as f:
                        while True:
                            chunk = r.read(1 << 20)
                            if not chunk:
                                break
                            total += len(chunk)
                            if total > (400 << 20):
                                raise RuntimeError("单件超过 400MB，未复制")
                            f.write(chunk)
                except Exception as e:                           # noqa: BLE001
                    skipped.append({"id": sid, "name": name, "why": "下载失败：%s" % e})
                    continue
                if total <= 0:
                    skipped.append({"id": sid, "name": name, "why": "画布返回空文件"})
                    continue
                try:
                    got, sk, _ = pcore.add_materials(
                        pdir, [tmp], copy=True, note="", into=cur_mats_sub(pdir))
                    added.extend(got)
                    for s in sk:
                        skipped.append({"id": sid, "name": name,
                                        "why": s.get("why") or "跳过"})
                except Exception as e:                           # noqa: BLE001
                    skipped.append({"id": sid, "name": name, "why": "登记失败：%s" % e})
        finally:
            shutil.rmtree(tmpdir, ignore_errors=True)

        # 补角色：add_materials 只记“是什么类型”，这里按工作台的规则再判一次。
        try:
            roles = {}
            for m in added:
                fp = os.path.join(pdir, str(m.get("file") or "").replace("/", os.sep))
                nm = str(m.get("name") or "")
                if nm and os.path.isfile(fp):
                    roles[nm] = pcore.detect_role(fp, {})
            if roles:
                register_intake_materials(pdir, [], roles=roles)
        except Exception as e:                                   # noqa: BLE001
            skipped.append({"name": "", "why": "角色补写失败：%s" % e})

        try:
            mats = materials_payload(pdir)
        except Exception:                                        # noqa: BLE001
            mats = []
        return {"ok": True, "imported": len(added), "added": added, "skipped": skipped,
                "materials": mats, "dir": cur_mats_sub(pdir), "project": pdir}

    def upload(self):
        """浏览器拖进来的文件：请求体就是文件字节，名字放 X-File-Name（URL 编码）。

        两种投递方式都要认：
        - `fetch(url, {body: file})` → 带 Content-Length（常规路径）；
        - `fetch(url, {body: file.stream(), duplex:"half"})` → **分块传输、没有
          Content-Length**，这时读到 EOF 为止（2026-09-15：前端先前用流式上传
          但没给 duplex，请求直接抛错 → 界面弹"投递失败"，两处都修了）。
        """
        name = urllib.parse.unquote(self.headers.get("X-File-Name") or "")
        pdir = self._proj()
        if not (name and pdir):
            return {"ok": False, "error": "缺少文件名或项目"}
        base_name = os.path.basename(name.replace("\\", "/"))
        if base_name != name or not base_name or base_name in (".", ".."):
            return {"ok": False, "error": "文件名不合法（不能带路径分隔符）"}
        if os.path.splitext(base_name)[1].lower() not in ALLOWED_UPLOAD_EXT:
            return {"ok": False, "error": "不支持的文件类型：%s（只收视频/图片/音频/文档/文本素材）"
                                          % (os.path.splitext(base_name)[1] or "无扩展名")}
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = 0
        if n > (8 << 30):
            return {"ok": False, "error": "文件超过 8GB 上限"}
        chunked = (not n) and ("chunked" in (self.headers.get("Transfer-Encoding") or ""))
        # 落到**当前版的素材夹**（rules 71）：默认版＝`素材/`，命名版本＝`素材/<版本名>/`
        # —— 这条让「③栏新建版本 → ②栏同步开出这一版的文件夹接收素材」成立。
        dest_dir = cur_mats_dir(pdir)
        os.makedirs(dest_dir, exist_ok=True)
        target = os.path.join(dest_dir, base_name)
        base, ext = os.path.splitext(target)
        i = 1
        while os.path.exists(target):
            target = "%s(%d)%s" % (base, i, ext)
            i += 1
        left = n
        total = 0
        with open(target + ".part", "wb") as f:
            if chunked:                          # 无 Content-Length：读到 EOF
                while True:
                    chunk = self.rfile.read(1 << 20)
                    if not chunk:
                        break
                    f.write(chunk)
                    total += len(chunk)
                    if total > (8 << 30):        # 8GB 上限，防呆
                        break
            else:
                while left > 0:
                    chunk = self.rfile.read(min(1 << 20, left))
                    if not chunk:
                        break
                    f.write(chunk)
                    left -= len(chunk)
                    total += len(chunk)
        if total == 0:
            try:
                os.remove(target + ".part")
            except OSError:
                pass
            return {"ok": False, "error": "没收到文件内容（前端要带 Content-Length 或用 duplex 流式）"}
        if total > (8 << 30):
            try:
                os.remove(target + ".part")
            except OSError:
                pass
            return {"ok": False, "error": "文件超过 8GB 上限（分块上传已中止，未落盘）"}
        if not chunked and total != n:
            try:
                os.remove(target + ".part")
            except OSError:
                pass
            return {"ok": False, "error": "文件不完整：声明 %d 字节，只收到 %d 字节（已丢弃，未落盘）"
                                          % (n, total)}
        os.replace(target + ".part", target)
        pend = self._pending()
        if target not in pend:
            pend.append(target)
        if pdir:
            save_pending(pdir, pend)        # 持久化（2026-10-08）
        # 落盘即入册（2026-11-10）：拖进来的图/视频/音频立刻进 框架.json 的 materials，
        # 这样 ②栏的 @ 选择器与 agent 侧的 @编号当场就有这一件，不用等「建框架 + 识别」。
        reg = register_dropped(pdir, target) if pdir else False
        _invalidate_samples(Handler.root or detect_root())
        return {"ok": True, "saved": target, "pending": pend, "registered": bool(reg)}

    def receive(self, b):
        pdir = self._proj(b)
        paths = b.get("paths") or []
        good = bool(b.get("good"))
        if not (pcore and pdir and paths):
            return {"ok": False, "error": "需要项目 + 至少一个文件"}
        try:
            placed, _ = pcore.accept_deliverables(
                pdir, list(paths), verdict="good" if good else "bad",
                note=b.get("note") or "", on_log=lambda s: _push_line("[接收] " + s))
        except Exception as e:                                   # noqa: BLE001
            return {"ok": False, "error": str(e)}
        if not placed:
            return {"ok": False,
                    "error": "一个文件都没收进来（源文件可能不在了，或目标路径不可写）；看动作流里的「接收」日志"}
        # 收成片/废片＝一条要读的提交（废因写在文件名里，正是 rules 反哺最值钱的输入）
        try:
            names = [os.path.basename(str(x).rstrip("\\/")) for x in (placed or paths)]
            inbox_append(pdir, "成片" if good else "废片",
                         "%d 个：%s%s" % (len(names), "、".join(names[:6]),
                                        ("…" if len(names) > 6 else "")),
                         extra=(b.get("note") or ""))
        except Exception:                                        # noqa: BLE001
            log_exc(pdir, "写信箱（收片）")
        _invalidate_samples(Handler.root or detect_root())
        return {"ok": True, "placed": placed,
                "inbox": pump_inbox(pdir, "收片"),
