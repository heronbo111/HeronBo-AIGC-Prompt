# ── 全进程禁黑窗（2026-10-26 用户要求）──────────────────────────────────────
# 创作台是 GUI 程序（没有控制台）。它内部任何一处 subprocess 起控制台程序
# （tasklist / powershell / pip / node / ffmpeg / 各种 CLI），Windows 都会新建
# 一个黑窗一闪——首次配置逐项自检时尤其明显。
# 这里在进程级给 Popen 兜一层默认 CREATE_NO_WINDOW；调用方自己指定了
# creationflags 的（打开 Edge 窗口、DETACHED 之类）一律尊重原样。
# 只加 CREATE_NO_WINDOW、不碰 startupinfo：GUI 子进程的主窗口不受影响。
# ── 随包运行时进 PATH（2026-10-27）──────────────────────────────────────────
# 安装包把 ffmpeg / node 放在 skill	ools\_vendor\ 与 runtime\ 下，但没写系统 PATH。
# 结果：①自检说"缺 ffmpeg" → agent 让用户手动装；②agent 跑 ffmpeg 命令找不到。
# 这里在进程启动时把这两处塞进 PATH，本进程与所有子进程（含 agent）都能直接用。
def _tool_paths():
    r"""解析随包工具的**真实绝对路径**（每台机器自己算，不写死）。

    安装后的目录形态：
        <安装目录>\HeronBo.exe
        <安装目录>
untime\python\python.exe      ← 运行时（不在 skill 下）
        <安装目录>
untime
ode
ode.exe
        <安装目录>\skill\SKILL.md
        <安装目录>\skill	ools\_vendorfmpeginfmpeg.exe

    所以找根的顺序：HERONBO_SKILL_ROOT → project_core 算出的 SKILL_ROOT → 从本文件往上找 SKILL.md；
    runtime 则要额外看「skill 的上一级」和「exe 往上几级」——它跟 skill 是并列的。
    开发仓里没有 runtime，所以还会兜底 tools\_vendor
ode。
    """
    roots = []
    env = os.environ.get("HERONBO_SKILL_ROOT", "")
    if env and os.path.isfile(os.path.join(env, "SKILL.md")):
        roots.append(os.path.normpath(env))
    try:
        if pcore and getattr(pcore, "SKILL_ROOT", ""):
            roots.append(pcore.SKILL_ROOT)
    except Exception:                                        # noqa: BLE001
        pass
    d = HERE
    for _ in range(6):
        if os.path.isfile(os.path.join(d, "SKILL.md")):
            roots.append(d)
            break
        nd = os.path.dirname(d)
        if nd == d:
            break
        d = nd
    roots = [r for i, r in enumerate(roots) if r and r not in roots[:i]]

    # 运行时可能在：<skill 根>/runtime、<skill 根>/../runtime、exe 往上 1..5 级的 runtime
    bases = list(roots)
    for r in roots:
        bases.append(os.path.dirname(r))
    try:
        exe_dir = os.path.dirname(os.path.abspath(sys.executable))
        d = exe_dir
        for _ in range(5):
            bases.append(d)
            nd = os.path.dirname(d)
            if nd == d:
                break
            d = nd
    except Exception:                                        # noqa: BLE001
        pass

    def first_file(*cands):
        for c in cands:
            if c and os.path.isfile(c):
                return c
        return ""

    ff = first_file(*[os.path.join(r, "tools", "_vendor", "ffmpeg", "bin", "ffmpeg.exe")
                      for r in roots])
    fp = os.path.join(os.path.dirname(ff), "ffprobe.exe") if ff else ""
    py = first_file(*[os.path.join(b, "runtime", "python", "python.exe") for b in bases])
    nd = first_file(*[os.path.join(b, "runtime", "node", "node.exe") for b in bases],
                    *[os.path.join(r, "tools", "_vendor", "node", "node.exe") for r in roots])
    return {"ffmpeg": ff, "ffprobe": fp if os.path.isfile(fp) else "", "python": py, "node": nd}


def _augment_path():
    """把随包工具所在目录塞进本进程 PATH（本进程与它拉起的子进程都能直接用）。"""
    try:
        t = _tool_paths()
    except Exception:                                        # noqa: BLE001
        return
    dirs = []
    for key in ("ffmpeg", "python", "node"):
        p_ = t.get(key) or ""
        if p_:
            dirs.append(os.path.dirname(p_))
    # 开发仓/未安装时兜底：skill 根下的 _vendor 目录
    d = HERE
    for _ in range(6):
        if os.path.isfile(os.path.join(d, "SKILL.md")):
            for sub in (("tools", "_vendor", "ffmpeg", "bin"), ("tools", "_vendor", "node")):
                dirs.append(os.path.join(d, *sub))
            break
        nd = os.path.dirname(d)
        if nd == d:
            break
        d = nd
    extra = [x for i, x in enumerate(dirs) if x and os.path.isdir(x) and x not in dirs[:i]]
    if extra:
        os.environ["PATH"] = os.pathsep.join(extra + [os.environ.get("PATH", "")])


