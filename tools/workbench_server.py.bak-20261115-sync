                    # （2026-09-17 用户截图："待识别和已识别完的为什么会同时存在"）
                    try:
                        n = len(self.server.pending or [])
                        del self.server.pending[:]
                        save_pending(pdir, self.server.pending)   # 持久化同步（2026-10-08）
                        if n:
                            _push_line("· 归类已落盘，清掉 %d 件待归类（②栏只留已归类的）" % n)
                    except Exception:                            # noqa: BLE001
                        pass
                pcore.mark_todos_done(pdir)
                _push_line("✅ agent 回来了：" + (res.get("text") or "")[:400], rec)
            else:
                err = (res.get("error") or "")[:400]
                if "返回码" in err and _STOPPED["flag"]:
                    err = "已手动停止（这一轮的结果不算数，可重跑）"
                    _STOPPED["flag"] = False
                _push_line("!! agent 没跑成：" + err, rec)
        except Exception as e:                                   # noqa: BLE001
            _push_line("!! 回写失败：%s" % e, rec)
        # 收尾：把结果、耗时、以及 agent 自己那份会话正文的路径写进记录
        tpath = ""
        try:                       # 定位失败也要落"结束"这条（别把整条收尾记录一起吞掉）
            if abridge and res.get("session_id"):
                tpath = abridge.transcript_path(_k or "", pdir, res.get("session_id"))
        except Exception:                                        # noqa: BLE001
            tpath = ""
        _append_record(rec, {"kind": "end", "at": time.strftime("%Y-%m-%d %H:%M:%S"),
                             "ok": bool(res.get("ok")), "seconds": round(usec, 1),
                             "key": _k or "",          # 这条会话是哪家跑出来的（换回来时要照它捞）
                             "session": res.get("session_id") or sid or "",
                             "transcript": tpath,
                             "text": (res.get("text") or res.get("error") or "")[:4000]})
        with _PROG_LOCK:
            _PROG.update({"done": True, "ok": bool(res.get("ok")), "running": False,
                          "pct": 100 if res.get("ok") else _PROG["pct"],
                          "text": res.get("text") or res.get("error") or "",
                          "seconds": round(usec, 1),
                          "record": rec})
        _clear_job(job)                   # 这一轮真结束了，重开时不该再当成"还在后台跑"
        # 跑这一轮的时候用户又提交了东西 → 立刻接上「读信箱」那一轮（2026-09-17 用户要求）
        try:
            pump_inbox(pdir)
        except Exception:                                        # noqa: BLE001
            pass
    threading.Thread(target=run, daemon=True).start()
    return {"job": job, "eta": _PROG["eta"], "eta_n": _PROG.get("eta_n", 0), "record": rec}


ABSORB_DEBOUNCE = 90.0        # 秒：同一项目两次「读提交」至少隔这么久（把连着几次提交攒成一轮）
_LAST_ABSORB = {}             # pdir -> 上一轮「读提交」起跑时间
_PENDING_PUMP = set()         # 已排了延迟补读的项目


def _schedule_absorb(pdir, delay=None):
    """去抖用：等一下再把「读提交」补上。同一项目只排一个，别堆线程。

    为什么要去抖（2026-09-21）：用户常在几十秒内连着打分/收片/提反馈，原来每一条都各起一轮
    （实测 absorb 10 轮 / 2011 秒 = 全程 28%）。攒一下再读，「立刻读」的体感不变，
    轮数能砍掉三分之一。
    """
    if pdir in _PENDING_PUMP:
        return
    _PENDING_PUMP.add(pdir)

    def _later():
        try:
            time.sleep(delay if delay is not None else ABSORB_DEBOUNCE)
            _PENDING_PUMP.discard(pdir)
            pump_inbox(pdir, why="去抖后补读")
        except Exception:                                        # noqa: BLE001
            _PENDING_PUMP.discard(pdir)

    threading.Thread(target=_later, daemon=True).start()


def pump_inbox(pdir, why=""):
    """用户刚在界面上提交（打分/收片/反馈）→ 有机会就把「读信箱」这一轮起起来。

    空闲就立刻起；正忙就把状态记在返回值里（`queued`），当前这一轮跑完会自动接上
    （收尾那段会再调一次本函数）。**不消耗额度之外的额外开销**：只在本项目真有待读条目时才起。

    暂停闩（2026-09-22）：用户按过「暂停」后，**自动**来的调用（why 为空 = 上一轮收尾、
    「去抖后补读」）一律不起轮，只把条目留在队列里并说明原因；用户主动的调用
    （手动 / 收片 / 评分——都是用户刚点的按钮）照常，并顺手解除暂停闩。
    """
    if not (pdir and abridge):
        return {"queued": False, "n": 0, "why": "没有 agent 通道"}
    pend = inbox_pending(pdir)
    if not pend:
        return {"queued": False, "n": 0}
    user_initiated = why in ("手动", "收片", "评分")
    if _PAUSED["flag"] and not user_initiated:
        with _PROG_LOCK:
            _PROG["queuedInbox"] = len(pend)
            _PROG["queuedKinds"] = sorted({(it.get("kind") or "反馈") for it in pend})
        return {"queued": True, "n": len(pend),
                "why": "你按过「暂停」——排队的提交先不自动读，下次点按钮或提交时恢复"}
    with _PROG_LOCK:
        busy = bool(_PROG["running"])
        if busy:
            # 把"已排队"显式记下来：用户打分明明提交了、却没立刻被读，界面要能说出来
            # （2026-09-19 用户："打完分应该立刻去读提交才对，而不是下一轮再去读"）
            _PROG["queuedInbox"] = len(pend)
            _PROG["queuedKinds"] = sorted({(it.get("kind") or "反馈") for it in pend})
    if busy:
        return {"queued": True, "n": len(pend),
                "why": "agent 正在跑，这一轮完自动接着读"}
    _now = time.time()
    _idle = _now - (_LAST_ABSORB.get(pdir) or 0)
    if _idle < ABSORB_DEBOUNCE:
        # 刚读过一次 → 先攒着，等这批到点再读（原来是在这里立刻又起一轮）
        with _PROG_LOCK:
            _PROG["queuedInbox"] = len(pend)
            _PROG["queuedKinds"] = sorted({(it.get("kind") or "反馈") for it in pend})
        _schedule_absorb(pdir, ABSORB_DEBOUNCE - _idle)
        return {"queued": True, "n": len(pend),
                "why": "刚读过一次，%d 秒后把这批一起读" % int(ABSORB_DEBOUNCE - _idle)}
    kinds = sorted({(it.get("kind") or "反馈") for it in pend})
    _LAST_ABSORB[pdir] = _now
    r = start_agent(pdir, "absorb", trigger="/".join(kinds))
    if r.get("error"):
        return {"queued": True, "n": len(pend), "why": r["error"]}
    log_append(pdir, "· 你刚提交的 %d 条 → 已立刻叫 agent 去读（%s）" % (len(pend), why or "自动"),
               "agent")
    return {"started": True, "n": len(pend), "job": r.get("job")}


def _recompute_pct_locked():
    """按本段历史耗时算 pct：段内指数逼近，整轮超时继续蠕动，只增不减，封顶 94。"""
    stages = _PROG.get("stages") or [n for n, _w in STAGES]
    n = max(1, len(stages))
    idx = min(max(int(_PROG.get("stage") or 0), 0), n - 1)
    what = _PROG.get("what") or ""
    pdir = _PROG.get("pdir") or ""
    total = float(_PROG.get("eta") or 180)
    ws = _stage_weights(what, n)
    base = sum(ws[:idx])
    se, sen = _stage_hist_median(pdir, what, idx)
    if not se:
        se = max(10.0, total * ws[idx] / 100.0)
    _PROG["stageEta"] = se
    _PROG["stageEtaN"] = sen
    tS = _PROG.get("tStage") or _PROG.get("t0") or 0
    elS = max(0.0, time.time() - tS) if tS else 0.0
    if elS <= se:
        frac = 1.0 - math.exp(-1.7 * elS / max(1.0, se))   # 1×预计约 80%
    else:
        frac = 0.80 + 0.14 * (1.0 - math.exp(-(elS - se) / max(30.0, se * 1.2)))
    pct = base + ws[idx] * min(1.0, frac)
    el = time.time() - _PROG["t0"] if _PROG["t0"] else 0
    if el > total:                     # 整轮超时：往 94 蠕，不满格
        pct = max(pct, 94.0 - 22.0 * math.exp(-(el - total) / max(60.0, total * 0.8)))
    pct = min(94.0, max(pct, float(_PROG.get("pct") or 0)))   # 只许往前走，不许回退
    _PROG["pct"] = pct


def _eta_left_locked():
    """剩余 = 本段剩余 + 后续段预计；整轮超时归 0。"""
    stages = _PROG.get("stages") or [n for n, _w in STAGES]
    n = max(1, len(stages))
    idx = min(max(int(_PROG.get("stage") or 0), 0), n - 1)
    what = _PROG.get("what") or ""
    pdir = _PROG.get("pdir") or ""
    total = float(_PROG.get("eta") or 180)
    tS = _PROG.get("tStage") or 0
    elS = max(0.0, time.time() - tS) if tS else 0.0
    se = float(_PROG.get("stageEta") or 0) or _stage_eta_secs(pdir, what, idx, n, total)
    rem = max(0.0, se - elS)
    for j in range(idx + 1, n):
        rem += _stage_eta_secs(pdir, what, j, n, total)
    # 分段估算只把整轮估算拉近，不超出"整轮还剩多少"
    el = time.time() - (_PROG.get("t0") or time.time()) if _PROG.get("t0") else 0
    base_left = max(0.0, total - el)
    if rem <= 0:
        return base_left
    return (rem + base_left) / 2.0 if rem < base_left else base_left


# ── 进度行 → 动作流事件（统一入口）─────────────────────────────────────
# 动作流事件三类来源在这里汇合：
#   ① 豆包 CDP 桥打在 stderr 的 `· ` 行：固定阶段走 _BRIDGE_RULES；答复里解析出的叙述段/
#      工具步骤（桥已按完整段切好）走关键词分类 _kind_of_seg；
#   ② 本地 Python 动作（归类/接收）经 on_log 推来的 `[归类] `/`[接收] ` 行；
#   ③ 任何代码直接调 _push_event(kind, text)。
# text 通道没有 stream-json、这版豆包又不写轨迹 assistant 行——全靠这里让每个动作都进事件。

# 桥的固定阶段（规则顺序＝匹配优先级，%s 按正则捕获组依次填入）
_BRIDGE_RULES = [
    (r"正在写…（(\d+) 字）", "say", "豆包正在输出（%s 字）"),
    (r"已填入\s*(\d+)\s*字", "write", "灌入提示词（%s 字）"),
    (r"答完了（用时\s*([^）]+)）", "done", "答完了（用时 %s）"),
    (r"已等待\s*(\d+)\s*s", "think", "豆包排队/思考中（已等 %ss）"),
    (r"点了发送按钮（([^）]+)）", "say", "已发送（%s）"),
    (r"没点到发送按钮", "say", "改用回车发送"),
    (r"它开始答了", "think", "豆包开始答复"),
    (r"等它答复", "think", "等待豆包答复"),
    (r"正在接入固定会话", "tool", "接入会话"),
    (r"固定会话已就绪", "tool", "会话已就绪"),
    (r"退回当前窗口新建", "tool", "退回当前窗口新建会话"),
    (r"已接入视频会话", "tool", "会话已就绪"),
    (r"会话目录", "tool", "会话目录已确认"),
    (r"输入框", "tool", "找到输入框"),
    (r"tiptap 写入没成", "tool", "tiptap 写入失败，降级 insertText"),
    (r"超时", "think", "已超时，先取现有的"),
]

# 动态段落（豆包答复里的叙述/工具步骤）→ kind；判不出当叙述（think）
_SEG_KIND_RULES = [
    (r"已查找|已读取|读取文件|查找文件|搜索文件|检索|grep|\bfind\b", "find"),
    (r"尝试调用|调用工具|启用工具", "tool"),
    (r"已运行|已执行|运行代码|执行命令|执行代码|命令行|mkdir|ffprobe|ffmpeg|New-Item", "term"),
    (r"编辑文件|已编辑|写入文件|保存文件|写回文件", "write"),
    (r"\d{3,4}\s*[×x]\s*\d{3,4}|竖屏|横屏|分辨率|视频为|时长|带音|帧率|画面为", "say"),
]


def _kind_of_seg(body):
    for pat, kind in _SEG_KIND_RULES:
        if re.search(pat, body, re.IGNORECASE):
            return kind
    return "think"


# 本地动作（归类/接收）→ kind；事件文本直接用日志原文（剥前缀），不重写
def _kind_of_local(group, body):
    if group == "归类":
        if re.search(r"共归类|按角色写入框架", body):
            return "done"
        if re.search(r"识别.*角色|→\s*角色", body):
            return "find"
        if re.search(r"已投放|存为|落户|复制进", body):
            return "write"
        if re.search(r"跳过|重复|失败|读不到", body):
            return "think"
        return "tool"
    if group == "接收":
        if re.search(r"已接收", body):
            return "write"
        if re.search(r"跳过|失败", body):
            return "think"
        return "tool"
    return "tool"


def _ev_from_line(line):
    """任意一行进度 → 一个动作流事件；纯正文/空行返回 None。"""
    s = (line or "").strip()
    if not s:
        return None
    at = time.strftime("%H:%M:%S")
    m = re.match(r"^\[(归类|接收)\]\s*(.*)$", s)       # ② 本地动作
    if m:
        group, body = m.group(1), m.group(2).strip()
        return _trace._ev(_kind_of_local(group, body), body[:200], at=at)
    if s.startswith("✗"):                              # ① 桥错误行
        return _trace._ev("think", s[:200], at=at)
    if s.startswith("·"):                              # ① 桥进度行
        body = s.lstrip("·").strip()
        for pat, kind, tpl in _BRIDGE_RULES:
            mm = re.search(pat, body)
            if mm:
                try:
                    text = (tpl % mm.groups()) if (mm.groups() and "%s" in tpl) else tpl
                except (TypeError, ValueError):
                    text = tpl
                return _trace._ev(kind, text, at=at)
        return _trace._ev(_kind_of_seg(body), body[:200], at=at)
    return None


_bridge_ev_from_line = _ev_from_line        # 兼容旧名（_push_line 里仍在调）


def _push_event(kind, text, at=None):
    """③ 直接推一条动作流事件（任何路径都可调），带锁、留最近 200 条。"""
    ev = _trace._ev(kind, str(text or "")[:200], at=at or time.strftime("%H:%M:%S"))
    with _PROG_LOCK:
        ebuf = _PROG.setdefault("events", [])
        ebuf.append(ev)
        del ebuf[:-200]
    return ev


def _push_line(line, rec=None):
    line = (line or "").rstrip()
    if not line:
        return
    if rec:
        _append_record(rec, {"kind": "line", "at": time.strftime("%H:%M:%S"), "text": line})
    log_append(_PROG.get("pdir") or "", line, "agent")     # 落进本项目自己的执行记录
    bev = _bridge_ev_from_line(line)             # 豆包桥进度行 → 动作流事件
    with _PROG_LOCK:
        _PROG["lines"].append(line)
        if len(_PROG["lines"]) > 400:
            del _PROG["lines"][:-400]
        if bev:
            ebuf = _PROG.setdefault("events", [])
            ebuf.append(bev)
            del ebuf[:-200]
        st = _stage_from_line(line, _PROG["stage"])
        # 正文还没落盘时，别把阶段说成"写回执"（agent 开工先写建项目回执，会把条冲到 95%）
        if st >= 3 and not _body_written(_PROG.get("pdir")):
            st = min(st, 2)
        if st != _PROG["stage"]:
            # 2026-11-11：切段时把**上一段真实耗时**记下来，下一轮估时就用它（分段估算的原料）
            _tS = _PROG.get("tStage") or 0
            if _tS and st > 0:
                _record_stage_eta(_PROG.get("pdir") or "", _PROG.get("what") or "",
                                  _PROG["stage"], time.time() - _tS)
            _PROG["tStage"] = time.time()
            _PROG["stage"] = st
        _recompute_pct_locked()


def _body_written(pdir):
    """正文（能直接复制那段）落盘了没有——用来判断"写回执"这个阶段是不是真到了。

    为什么要它（2026-09-19 用户截图：进度条冲到 95%、阶段跳到"写回执"，正文却一个字没有）：
    agent 一开工就先写了一份**建项目回执**，关键字规则把"回执"当成了最后阶段 →
    整条进度看起来快完了。所以"回执"只有在正文已经在盘上时才算走到最后一段。
    """
    if not pdir:
        return False
    # 文案/ 两份是新口径的交付位置（2026-09-21：提示词只放 文案/）；项目根那两份只为兼容老项目
    for rel in (os.path.join("文案", "提示词正文.txt"), os.path.join("文案", "提示词.txt"),
                "提示词正文.txt", "提示词.txt"):
        try:
            fp = os.path.join(pdir, rel)
            if os.path.isfile(fp) and os.path.getsize(fp) > 0:
                return True
        except OSError:
            pass
    return False


def agent_proc_alive():
    """这一轮的 agent 子进程还在不在——判"它是真在跑，还是状态卡住了"。

    为什么要它（2026-09-19 用户截图：新任务被「已经有一个任务在跑」挡住，可界面上找不到那个任务）：
    窗口被关掉、agent 进程崩了、机器睡过、上一轮被 taskkill —— 这些情况下 `_PROG["running"]`
    可能还挂着 True（在内存里），用户就既跑不了新的、也看不到旧的。
    """
    try:
        p = (abridge._CURRENT or {}).get("proc") if abridge else None
        return bool(p and p.poll() is None)
    except Exception:                                            # noqa: BLE001
        return False


def _fmt_dur(sec):
    sec = int(max(0, sec or 0))
    return "%d:%02d" % (sec // 60, sec % 60)


def progress_snapshot(since=0):
    with _PROG_LOCK:
        el = time.time() - _PROG["t0"] if _PROG["t0"] else 0
        if _PROG["running"]:
            _recompute_pct_locked()          # 没日志行也要让条动（按时间估）
        # 阶段名按下标取，**必须夹进表长内**：原来写死 `min(stage, 3)`，而 intake 只有 3 段
        # （2026-09-21 修重复文案时确认）。项目里若已有「提示词.txt」，归类轮的 clamp 不生效 →
        # stage 会到 3 → 下标 3 越界 → 这个接口直接 500、界面进度整块瞎掉。
        _stages = _PROG.get("stages") or [n for n, _w in STAGES]
        _sidx = min(max(_PROG["stage"], 0), len(_stages) - 1)
        _sEta = float(_PROG.get("stageEta") or 0)
        _tS = _PROG.get("tStage") or _PROG.get("t0") or 0
        _sEl = max(0.0, time.time() - _tS) if _tS else 0.0
        _left = _eta_left_locked() if _PROG["running"] else 0.0
        _tot = float(_PROG["eta"] or 0)
        d = {"job": _PROG["job"], "stage": _PROG["stage"],
             "stageName": _stages[_sidx],            "pct": round(_PROG["pct"], 1),
             "elapsed": round(el), "eta": round(_PROG["eta"]),
             "etaLeft": round(_left), "stageEta": round(_sEta), "stageElapsed": round(_sEl),
             "stageEtaN": int(_PROG.get("stageEtaN") or 0),
             # 已超出整轮预估多少秒（>0 时前端写"已超出预计、还在跑"）
             "over": round(max(0.0, el - _tot)) if _PROG["running"] else 0,
             "etaN": int(_PROG.get("eta_n") or 0),
             "running": _PROG["running"], "done": _PROG["done"], "ok": _PROG["ok"],
             "lines": _PROG["lines"][since:], "n": len(_PROG["lines"]),
             # 这条通道不给过程输出时如实说明（否则用户看着不动的条只能瞎猜）
             "quiet": bool(_PROG["running"] and not _PROG["lines"] and el > 25),
             "text": _PROG["text"],
             # 进程可视化（2026-09-17）：agent 现在拉起来的那些长任务 + 有没有在做"额外加工"
             "active": list(_PROG.get("active") or []),
             "warn": _PROG.get("warn") or "",
             # 任务可视化（2026-09-18）：agent 的动作流（思考/终端/读写/提问），
             # 数据源是这家 CLI 的会话正文，跟它自己界面上显示的是同一份
             "events": (_PROG.get("events") or [])[-40:],
             "nEvents": len(_PROG.get("events") or []),
             # 动作流来自哪个工具（2026-09-21：一台机器可能只装了 WorkBuddy、另一台只装了别的，
             # 通道是按本机探测的，界面把来源写出来，用户才知道它读的是哪家的正文）
             "chan": _PROG.get("chan") or "",
             "what": _PROG.get("what") or "",     # 这一轮是什么任务（归类/出提示词/反馈/读信箱）
             "trigger": _PROG.get("trigger") or "",       # 这一轮怎么来的（反馈/评分/…）
             "queuedInbox": _PROG.get("queuedInbox") or 0,  # 有几条已提交、在排队等读
             "queuedKinds": _PROG.get("queuedKinds") or [],
             "stages": _PROG.get("stages") or [n for n, _w in STAGES],
             "pdir": _PROG.get("pdir") or "",     # 这一轮在哪个项目上跑（切项目时界面靠它分辨）
             "pname": os.path.basename((_PROG.get("pdir") or "").rstrip("\\/"))}
        return d


# ── 创作台更新：检查 / 下载自替换 / 回滚（2026-09-22 用户要求）────────────────────
# 用户原话：「我想要给创作台做一个更新功能，能够下载我推送的新版本」。
# 为什么必须做：界面、本地服务、流程代码**全在 exe 里**（旧 exe = 旧功能），而此前创作台里
# 没有任何「我这是哪一版、远端有没有新版」的入口，用户只能自己想起来跑命令行。
# 三块都复用仓库既有件，不另写一套：
#   版本.py   → 版本身份与比对（读打进 exe 的 _version.json；远端拉 Release 的 version.json）
#   下载器.py → 续传 / 换源 / sha256（Gitee 优先的地址由 能力包.py 给）
#   更新助手  → Windows 不能覆盖正在运行的 exe，所以由它「等进程退出 → 换位 → 重启」
_ver = _load_core("版本.py", "heronbo_version")
_dl = _load_core("下载器.py", "heronbo_dl")
_kp = _load_core("能力包.py", "heronbo_kp")

UPD_KEEP_OLD = 2                       # 只留最近 2 个旧 exe 备份（与 换exe.py 的 KEEP_OLD 对齐）
_UPD = {"phase": "idle", "pct": 0, "msg": "", "error": "", "version": "", "mb": 0.0}
_UPD_LOCK = threading.Lock()
_UPD_BUSY = {"flag": False}
_UPD_PEEK = {"at": 0.0, "need": False, "why": "", "version": "", "checked": False}


def _set_upd(**kw):
    with _UPD_LOCK:
        _UPD.update(kw)


def _exe_now():
    """当前跑的这个 exe 在哪（源码运行时＝tools\\dist\\score-tool.exe）。"""
    if _ver:
        return _ver.exe_path()
    return (sys.executable if getattr(sys, "frozen", False)
            else os.path.join(HERE, "dist", "score-tool.exe"))


def _exe_dir():
    return os.path.dirname(os.path.abspath(_exe_now()))


def _is_onedir():
    """当前是不是 onedir 布局（exe 旁边有 _internal\\）——2026-10-13 起的主形态。

    两种形态的更新/回滚路径不同：onedir 的依赖在旁边目录里，换位要连它一起换。
    """
    try:
        return os.path.isdir(os.path.join(_exe_dir(), "_internal"))
    except OSError:
        return False


def _helper_path():
    """（历史遗留，2026-09-22 起不再使用）第一版把助手写成 `score-tool.update.cmd`。

    现在助手是 `tools\\更新助手.py`，由创作台 exe 以 `--update-helper` 跑起来——
    .cmd 那条路在分离窗口里会卡住（见 _launch_helper 的说明）。这个函数只留着给
    旧日志/旧文档一个对照，别在新代码里用它。
    """
    return os.path.join(_exe_dir(), "score-tool.update.cmd")


def update_check():
    """只读：当前版 / 远端版 / 要不要更新 / 体积 / 源码落后几个提交。不下载不写盘不起进程。"""
    if not _ver:
        return {"ok": False, "error": "版本组件没加载上（打包时漏了 版本.py？）"}
    try:
        d = _ver.payload()
    except Exception as e:                                       # noqa: BLE001
        return {"ok": False, "error": "检查更新失败：%s" % e}
    d["busy"] = bool(_UPD_BUSY["flag"])
    d["backups"] = len(_backup_list())          # 有备份才给「回滚到上一版」那颗按钮
    return d


def _backup_list():
    """旧版备份，按时间从旧到新。

    两种形态都认（2026-10-13）：老的单文件 exe（dist\\score-tool_旧_*.exe）；
    onedir 的 `dist\\_old\\<时间戳>\\`（里面是 score-tool.exe + _internal\\）。
    """
    d = _exe_dir()
    fs = []
    for pat in ("score-tool_旧_*.exe", "score-tool_old_*.exe"):
        fs += glob.glob(os.path.join(d, pat))
    try:
        old_root = os.path.join(d, "_old")
        fs += [os.path.join(old_root, x) for x in os.listdir(old_root)
               if os.path.isdir(os.path.join(old_root, x))]
    except OSError:
        pass
    return sorted(set(fs), key=lambda p: os.path.getmtime(p))


def update_state():
    """下载/换位的实时状态（界面弹窗轮询它画进度）。"""
    with _UPD_LOCK:
        st = dict(_UPD)
    return {"ok": True, "busy": bool(_UPD_BUSY["flag"]), "state": st}


def update_peek():
    """开机静默检查的结果（标题条小圆点用）：**只读缓存**，绝不在这里下载。

    缓存超过 15 分钟就**后台**再查一次（本次照旧回旧缓存，点/文案下一轮变对）——
    否则 30 分钟的界面刷新读的永远是开机那一份，你推了 git 也亮不了点。
    """
    cur = ""
    try:
        cur = (_ver.current().get("version") if _ver else "") or ""
    except Exception:                                            # noqa: BLE001
        cur = ""
    if _UPD_PEEK.get("checked") and time.time() - _UPD_PEEK.get("at", 0) > 600 \
            and not _UPD_PEEK.get("spinning"):
        _UPD_PEEK["spinning"] = True

        def _go():
            try:
                _peek_once(0.0)
            finally:
                _UPD_PEEK["spinning"] = False
        threading.Thread(target=_go, daemon=True).start()
    return {"ok": True, "checked": _UPD_PEEK["checked"], "need": bool(_UPD_PEEK["need"]),
            "why": _UPD_PEEK["why"], "version": _UPD_PEEK["version"],
            "behind": _UPD_PEEK.get("behind"),
            "current": cur, "at": _UPD_PEEK["at"]}


def _peek_once(delay=5.0):
    """开机 5 秒后查一次远端（不阻塞开窗）；有新版本就给标题条点亮一个小圆点。

    2026-09-22：payload 带上 with_repo（git push 也要能把点点亮——用户"要能接受到我在
    git 仓库上的推送"）；git fetch 放在这个后台线程里做，不拖开窗。
    """
    try:
        time.sleep(max(0.0, delay))
        if not _ver:
            return
        d = _ver.payload()
        _UPD_PEEK.update({"at": time.time(), "need": bool(d.get("need")),
                          "why": d.get("why") or "", "checked": True,
                          "version": (d.get("remote") or {}).get("version") or "",
                          "behind": (d.get("repo") or {}).get("behind")})
    except Exception:                                            # noqa: BLE001
        _UPD_PEEK["checked"] = True


def tidy_backups(keep=UPD_KEEP_OLD):
    """只留最近 N 个旧 exe 备份。

    ⚠️ 两种命名都要认：`换exe.py`（开发机）造的是 `score-tool_旧_<时间>.exe`，
    更新助手（装机端自更新）造的是 `score-tool_old_<时间>.exe`（助手内容必须纯 ASCII，
    所以那边不能用中文）。**别只盯一种**，否则另一条路造出来的会永远堆着。
    """
    d = _exe_dir()
    fs = _backup_list()
    fs = sorted(set(fs), key=lambda p: os.path.getmtime(p))
    for old in (fs[:-keep] if len(fs) > keep else []):
        try:
            os.remove(old)
        except OSError:
            pass


def _dist_writable():
    d = _exe_dir()
    try:
        os.makedirs(d, exist_ok=True)
        p = os.path.join(d, "_wtest.tmp")
        with open(p, "w") as f:
            f.write("x")
        os.remove(p)
        return True, ""
    except OSError as e:
        return False, str(e)


def _git_dirty():
    """技能目录是 git 工作树且有未提交改动 → 返回改动条数（否则 0）。

    为什么更新 exe 也要拦它（仓库铁律）：用户的工作区不该被"顺手"搅动；有未提交改动时
    先让人提交/暂存，比事后猜「我的改动哪去了」安全得多。
    """
    root = _ver.skill_root() if _ver else ""
    if not (root and os.path.isdir(os.path.join(root, ".git"))):
        return 0
    try:
        r = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                           capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=25,
                           **({"creationflags": 0x08000000} if os.name == "nt" else {}))
        if r.returncode != 0:
            return 0
        return len([l for l in (r.stdout or "").splitlines() if l.strip()])
    except (OSError, subprocess.SubprocessError):
        return 0


def _fail(msg):
    _UPD_BUSY["flag"] = False
    _set_upd(phase="error", error=msg, msg=msg)
    return {"ok": False, "error": msg}


def helper_text(src_name, pid=None, ts=None):
    """更新助手脚本的正文（纯 ASCII，CRLF 由写盘时给）。

    ⚠️ 2026-09-22 起**不再用 .cmd 助手**（这段保留只为说明坑在哪，别再用它）：
    分离出来的 cmd 没有控制台 —— `timeout /t` 卡死不返回；改用 ping 后仍会停在
    "等进程退出"那步（实测 .new 与 .cmd 都留在盘上、一直不换位）。
    现在走 `更新助手.py`：由创作台 exe 以 `--update-helper` 再跑一份自己来完成换位。
    """
    exe = os.path.basename(_exe_now())
    L = ["@echo off", "setlocal enableextensions",
         'set "D=%~dp0"', 'set "EXE=%s"' % exe]
    return "\r\n".join(L) + "\r\n"


def _helper_exe():
    """拿哪个程序当更新助手：**当前这个创作台 exe**（它一定存在、一定能跑，且自带解释器）。

    单独抽成一个函数是为了**能被替换**：源码方式跑的时代替成"打包版 exe"就能测真链路，
    而不必真去换那个正在跑的实例。
    """
    return _exe_now()


def _launch_helper(mode, src_name):
    """拉起更新助手：**用创作台 exe 自己**（`--update-helper`），返回 (ok, 说明)。

    为什么用 exe 而不是 .cmd / 系统 python：
      · exe 里自带解释器 → 装机端不需要另装 Python；
      · 没有"分离 cmd 无控制台"那堆坑（timeout 卡死、管道卡住，2026-09-22 实测）；
      · 助手是同一个 exe 的第二份实例，`--update-helper` 在 tkinter 之前就分流掉了，
        不会弹窗口、不会抢端口。
    """
    exe = _helper_exe()
    if not os.path.isfile(exe):
        return False, "找不到创作台程序（%s）" % exe
    # ── 2026-10-21：apply 模式**改用「更新包里解压出来的新 exe」当助手** ──────────────
    # 为什么（用户同事真机实踩，根因已复现）：
    #   助手原来 = dist 里的 exe 第二实例 → 它自己的 Python 运行时正映射着
    #   dist\_internal\base_library.zip / *.dll → 换位时 `shutil.move(dist\_internal, _old)` 挪不动
    #   （WinError 32 另一个程序正在使用此文件）→ 旧版没有回滚，而 score-tool.exe 已被挪进 _old
    #   → 结束：exe 不见了，桌面快捷方式报「找不到该应用程序」。
    #   新 exe 的 _internal 解压在 %TEMP% 下，**不占用 dist** → 换位时旧目录没人用，移动必成。
    if mode == "apply":
        srcp = os.path.join(_exe_dir(), src_name)
        if os.path.isfile(srcp) and srcp.lower().endswith(".zip"):
            import tempfile as _tf
            import zipfile as _zf
            tmp = os.path.join(_tf.gettempdir(),
                               "heronbo_upd_%s" % time.strftime("%Y%m%d-%H%M%S"))
            try:
                with _zf.ZipFile(srcp) as z:
                    for n in z.namelist():                 # 防目录穿越：只解常规相对路径
                        if os.path.isabs(n) or ".." in n.replace("\\", "/").split("/"):
                            return False, "更新包里路径不合法：%s" % n
                    z.extractall(tmp)
            except Exception as e:                                     # noqa: BLE001
                return False, "更新包解不开（%s）" % e
            exe2 = os.path.join(tmp, "score-tool.exe")
            if not os.path.isfile(exe2):
                for x in os.listdir(tmp):                  # 兼容"zip 里套了一层同名目录"
                    p2 = os.path.join(tmp, x, "score-tool.exe")
                    if os.path.isfile(p2):
                        exe2 = p2
                        break
            if os.path.isfile(exe2):
                exe = exe2
    # 参数走 JSON 文件（UTF-8），命令行只传这个文件路径（纯 ASCII）：
    # exe 经 PyInstaller bootloader 解析的**中文 argv 会乱码**（实踩：`D:\AI开发\…`
    # 进助手变成 `D:\AI寮€鍙慭…`）→ 助手找不到更新包 → 换位失败。
    import tempfile as _tf2
    af = os.path.join(_tf2.gettempdir(), "heronbo_helper_args.json")
    try:
        with open(af, "w", encoding="utf-8") as f:
            json.dump({"dir": _exe_dir(), "src": src_name, "pid": os.getpid(),
                       "mode": mode, "keep": UPD_KEEP_OLD}, f, ensure_ascii=False)
    except OSError as e:
        return False, "写参数文件失败（%s）" % e
    args = [exe, "--update-helper", "--args-file", af]
    kw = {}
    if os.name == "nt":
        kw["creationflags"] = 0x00000008 | 0x00000200     # DETACHED_PROCESS | NEW_PROCESS_GROUP
    try:
        subprocess.Popen(args, cwd=_exe_dir(), **kw)
    except OSError as e:
        return False, "起不来助手（%s）" % e
    _push_line("· 更新助手已启动：换位会在创作台退出后进行（页面会自动关掉，稍等它自己回来）")
    return True, "ok"


def update_apply():
    """点「下载并重启」：查版本 → 下载 → 校验 → 交更新助手换位并重启。

    先把 {"ok": true, "restart": true} 回给界面（界面立刻显示"正在下载…"），
    真正下载在后台线程里做；下完 → 写助手 → 主进程退出（创作台窗口随之关闭）。
    """
    if _UPD_BUSY["flag"]:
        return {"ok": False, "error": "已经在更新了，等这一次走完"}
    if not _ver:
        return {"ok": False, "error": "版本组件没加载上"}
    try:
        d = _ver.payload(with_repo=False)
    except Exception as e:                                       # noqa: BLE001
        return {"ok": False, "error": "检查更新失败：%s" % e}
    if not d.get("need"):
        return {"ok": False, "error": d.get("why") or "已经是最新版"}
    # 更新包必须是"onedir 的 zip"（2026-10-13）。两道门都过不了就明确让人走完整安装包——
    # 硬更新会把程序换成跑不起来的形态（单文件缺依赖目录 / 目录式被单文件覆盖）。
    rem = _ver.remote()
    pkg = rem.get("pkg") or {}
    sha = (pkg.get("sha256") or "").strip()
    name = (pkg.get("name") or "").strip()
    if not sha or not name:
        return {"ok": False, "error": "新版「%s」要装完整安装包：远端还没有配套的更新包"
                                      "（程序从单文件改成了目录式）。到 Release 下载最新的 "
                                      "HeronBo-Workbench-Setup 重装一次，之后就能在线更新了。"
                                      % (d.get("version") or "更新")}
    if not _is_onedir():
        return {"ok": False, "error": "这一版要装完整安装包：你的程序还是旧的单文件形态，"
                                      "接不上新的目录式更新包。到 Release 下载最新的 "
                                      "HeronBo-Workbench-Setup 重装一次即可（一次性）。"}
    okw, why = _dist_writable()
    if not okw:
        return {"ok": False, "error": "创作台所在目录写不进去（权限不够？）——换个位置装或检查一下权限"}
    dirty = _git_dirty()
    if dirty:
        return {"ok": False, "error": "你的工作区有 %d 处未提交的改动，先提交或暂存再更新（我不会动你的文件）"
                                      % dirty}
    _UPD_BUSY["flag"] = True
    mb = round((pkg.get("size") or 0) / 1048576.0, 1)
    _set_upd(phase="download", pct=0, msg="正在下载新版创作台…", version=rem.get("version") or "",
             mb=mb, error="")
    threading.Thread(target=_do_apply, args=(rem, sha, name), daemon=True).start()
    return {"ok": True, "restart": True, "version": rem.get("version") or "", "mb": mb}


def _do_apply(rem, sha, name):
    d = _exe_dir()
    new = os.path.join(d, name)          # 下到 dist\<zip 名>；更新助手认 zip（2026-10-13 onedir）
    try:
        # 交叉校验：**以 version.json 里的自洽性为准**——它自带 `sumsPkgSha256`
        # （发行时从 SHA256SUMS.txt 抄进来的同一份哈希）。两个字段对不上 = 真·自相矛盾 → 不装。
        # ⚠️ 别拿**远端现成的 SHA256SUMS.txt** 当硬判据：Gitee 同名附件不能覆盖，我们换包时
        # 往往只重传包与 version.json，清单可能还是上一版的 → 那样会永远报"矛盾"、更新全被挡。
        # 所以清单只作参考：对得上就用，对不上就跳过（版本号 + 内嵌哈希已经够严）。
        baked = (rem.get("sumsPkgSha256") or "").strip().lower()
        if baked and baked != sha.lower():
            return _fail("远端元数据互相矛盾（两个文件里的校验值不一致），已放弃安装")
        sums = {}
        if _dl and _kp:
            try:
                sums = _dl.hashes(_kp.urls_for("SHA256SUMS.txt"))
            except Exception:                                    # noqa: BLE001
                sums = {}
        s2 = (sums.get(name) or "").lower()
        if s2 and s2 != sha.lower():
            _push_line("· 提示：远端清单里的校验值和这一版对不上（清单可能还没跟着换），"
                       "以版本信息里的为准，继续更新")
        urls = _kp.urls_for(name) if _kp else []
        if not urls:
            return _fail("取不到新版下载地址（能力包组件没加载上）")

        def _prog(got, total):
            pct = int(got * 100 / total) if total else 0
            _set_upd(phase="download", pct=pct,
                     msg="正在下载新版创作台…已 %d%%" % pct)

        _set_upd(phase="download", pct=0, msg="正在下载新版创作台…")
        _dl.fetch_any(urls, new, sha256=sha, progress=_prog, log=lambda *_a: None)
        _set_upd(phase="verify", pct=99, msg="正在校验文件…")
        if _dl.sha256_file(new).lower() != sha.lower():
            return _fail("下载的文件校验不过，已放弃安装（远端可能还在上传，稍后再试）")
        _set_upd(phase="restart", pct=100, msg="马上重启创作台完成更新，请稍候…")
        ok, msg = _launch_helper("apply", os.path.basename(new))
        if not ok:
            return _fail("准备重启没成：%s" % msg)
        time.sleep(0.7)                    # 让界面把"正在重启"显示出来
        os._exit(0)
    except Exception as e:                                       # noqa: BLE001
        low = str(e).lower()
        if "sha256" in low or "校验" in low:
            # 文案纪律：不暴露 URL / 哈希 / 术语 —— 只说要人做的事
            return _fail("下载的文件校验不过，已放弃安装（远端可能还在上传，稍后再试）")
        return _fail("下载新版没成功（网络不通？）——稍后再试")


def update_rollback():
    """回到上一版：取最新的旧备份 → 复制成 ASCII 名 → 交助手换回去 → 退出。"""
    if _UPD_BUSY["flag"]:
        return {"ok": False, "error": "已经在更新了，等这一次走完"}
    d = _exe_dir()
    fs = _backup_list()
    if not fs:
        return {"ok": False, "error": "没有可回滚的旧版本"}
    src = fs[-1]
    if os.path.isdir(src):
        # onedir（2026-10-13）：备份本身就是目录（_old\<时间戳>\ 里是 exe + _internal\），
        # 直接把相对路径交给助手摊回去——不用也不能复制成单个 .rollback.exe。
        rb_name = os.path.relpath(src, d)
    else:
        rb = os.path.join(d, "score-tool.rollback.exe")
        try:
            shutil.copy2(src, rb)
        except OSError as e:
            return {"ok": False, "error": "拿不到那个旧版本：%s" % e}
        rb_name = os.path.basename(rb)
    _UPD_BUSY["flag"] = True
    _set_upd(phase="restart", pct=100, msg="马上重启创作台回到上一版，请稍候…")
    ok, msg = _launch_helper("rollback", rb_name)
    if not ok:
        _UPD_BUSY["flag"] = False
        return {"ok": False, "error": "准备重启没成：%s" % msg}
    threading.Thread(target=_delayed_exit, daemon=True).start()
    return {"ok": True, "restart": True, "to": os.path.basename(src)}


def update_pull():
    """面板上的「拉取」（2026-09-22 用户："要能接受到我在 git 仓库上的推送"）：
    把远端的提交拉下来。

    两道护栏：①工作区有未提交改动 → 拒绝（仓库铁律：不动用户的工作区）
    ②`--ff-only` 快进合并，本地与远端**分叉**时拒绝并说清（不替用户做合并决策）。
    拉成功即 behind=0，直接回给界面重画。
    """
    if _UPD_BUSY["flag"]:
        return {"ok": False, "error": "正在更新创作台，等这次走完"}
    if not _ver:
        return {"ok": False, "error": "版本组件没加载上"}
    dirty = _git_dirty()
    if dirty:
        return {"ok": False, "error": "本地有 %d 处未提交改动——先提交或暂存再拉（我不会动你的工作区）" % dirty}
    root = _ver.skill_root()
    if not (root and os.path.isdir(os.path.join(root, ".git"))):
        return {"ok": False, "error": "这个安装不是 git 仓库（发行包安装的机器上没有源码可拉）"}
    try:
        r = subprocess.run(["git", "-C", root, "pull", "--ff-only"],
                           capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=120,
                           **({"creationflags": 0x08000000} if os.name == "nt" else {}))
    except (OSError, subprocess.SubprocessError) as e:
        return {"ok": False, "error": "拉取失败：%s" % str(e)[:100]}
    if r.returncode != 0:
        tail = [l for l in ((r.stdout or "") + (r.stderr or "")).splitlines() if l.strip()]
        return {"ok": False, "error": "拉不了（多半是本地与远端分叉了，要先合并）：%s"
                % (tail[-1][:140] if tail else "未知原因")}
    return {"ok": True, "msg": "已拉取到最新源码", "behind": 0}


def _delayed_exit(delay=0.7):
    try:
        time.sleep(delay)
    finally:
        os._exit(0)


# ── HTTP ───────────────────────────────────────────────────────────────────
class Handler(BaseHTTPRequestHandler):
    server_version = "HeronBoWorkbench/1.0"
    last_ping = time.time()
    loaded_at = 0.0          # 页面（index.html/app.js）被拉取的时刻 → 判断"不是白窗"
    root = ""

    def log_message(self, *a):                                   # 静默：别刷控制台
        pass

    # ---- 小工具 ----
    def _json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def handle_one_request(self):
        """兜住所有没被路由自己处理的异常：回 400/500 后正常关连接，别让 do_POST 裸崩。"""
        try:
            super().handle_one_request()
        except BadRequestBody as e:
            self.close_connection = True
            try:
                self._json({"ok": False, "error": str(e)}, 400)
            except Exception:                                # noqa: BLE001
                pass
        except Exception as e:                               # noqa: BLE001
            self.close_connection = True
            try:
                self._json({"ok": False, "error": "请求处理失败：%s" % str(e)[:200]}, 500)
            except Exception:                                # noqa: BLE001
                pass

    def _body(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = 0
        if not n:
            return {}
        raw = self.rfile.read(n)
        try:
            obj = json.loads(raw.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            # 2026-11 QA 实测：原实现 return {} → save_fields 把六栏当空值写回去，
            # 一次坏请求就清空用户填的内容。坏 JSON 必须显式报错，不能伪装成"空对象"。
            raise BadRequestBody("请求体不是合法 JSON（没有改动任何数据）")
        if not isinstance(obj, dict):
            raise BadRequestBody("请求体必须是 JSON 对象，不能是数组/字符串/数字")
        return obj

    def _proj(self, payload=None):
        """当前项目目录；只认当前项目库下的项目，不接受客户端塞任意路径。

        原实现直接把请求里的 project 原样返回，save_fields / save_need / save_flags /
        feedback / save_review / open_path 这些写入口就能往任意目录落文件。
        项目库根只从服务端状态取，客户端只能选库内项目。
        """
        if payload and payload.get("project"):
            pdir = str(payload["project"])
        else:
            pdir = read_proj()
        root = Handler.root or detect_root()
        if not (pdir and root and os.path.isdir(pdir) and _inside(root, pdir)):
            return ""
        if os.path.normcase(_norm_path(pdir)) == os.path.normcase(_norm_path(root)):
            return ""
        return pdir

    def _set_proj(self, pdir):
        write_proj(pdir)

    # ---- 画布反代 /canvas/* → 127.0.0.1:9190/* ----
    def _proxy_canvas(self):
        """把 /canvas/ 前缀剥掉转给画布。画布仍只监听回环，页面里不再出现第二个端口。"""
        parsed = urllib.parse.urlsplit(self.path)
        if parsed.path != "/canvas" and not parsed.path.startswith("/canvas/"):
            return False
        if self.command not in ("GET", "HEAD") and not _same_origin(self):
            self._json({"ok": False, "error": "跨站请求已拒绝（Origin 与服务不同源）"}, 403)
            return True
        if parsed.path == "/canvas":
            loc = "/canvas/" + ("?" + parsed.query if parsed.query else "")
            self.send_response(302)
            self.send_header("Location", loc)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True
        if not _canvas_health(2.0):
            ensure_canvas(wait=15.0)
        if not _canvas_health(2.5):
            detail = ""
            try:
                r = urllib.request.urlopen(CANVAS_URL + "api/health", timeout=2.0)
                detail = r.read(300).decode("utf-8", "ignore")
            except Exception as e:                               # noqa: BLE001
                detail = str(e)
            self._json({"ok": False,
                        "error": "画布服务没起来（%s）；日志：%%LOCALAPPDATA%%\\HeronBoScoreTool\\canvas.log；探活：%s"
                                 % (CANVAS_URL, detail)},
                       502)
            return True
        target = parsed.path[len("/canvas"):] or "/"
        if parsed.query:
            target += "?" + parsed.query
        body = b""
        if self.command in ("POST", "PUT", "PATCH", "DELETE"):
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = 0
            if n:
                body = self.rfile.read(n)
        req = {}
        for k, v in self.headers.items():
            if k.lower() in ("host", "connection", "content-length",
                             "transfer-encoding", "expect"):
                continue
            req[k] = v
        req["Host"] = "127.0.0.1:%d" % CANVAS_PORT
        req["Connection"] = "close"
        if body:
            req["Content-Length"] = str(len(body))
        conn = http.client.HTTPConnection("127.0.0.1", CANVAS_PORT, timeout=60)
        try:
            conn.request(self.command, target, body=body if body else None, headers=req)
            resp = conn.getresponse()
            self.send_response(resp.status, resp.reason)
            length = resp.getheader("Content-Length")
            for k, v in resp.getheaders():
                lk = k.lower()
                if lk in ("connection", "transfer-encoding", "content-length"):
                    continue
                if lk == "location" and v.startswith("/"):
                    v = "/canvas" + v
                self.send_header(k, v)
            if length is None and self.command != "HEAD":
                self.send_header("Connection", "close")
                self.close_connection = True
            elif length is not None:
                self.send_header("Content-Length", length)
            self.end_headers()
            if self.command == "HEAD":
                return True
            if length is not None:
                left = int(length)
                while left > 0:
                    chunk = resp.read(min(65536, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
            else:
                while True:
                    chunk = resp.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
            try:
                self.wfile.flush()
            except OSError:
                pass
            return True
        except Exception as e:                                   # noqa: BLE001
            try:
                self._json({"ok": False, "error": "画布转发失败：%s" % e}, 502)
            except Exception:                                    # noqa: BLE001
                pass
            return True
        finally:
            try:
                conn.close()
            except Exception:                                    # noqa: BLE001
                pass

    # ---- 静态 ----
    def do_GET(self):
        if self._proxy_canvas():
            return
        path = urllib.parse.urlparse(self.path).path
