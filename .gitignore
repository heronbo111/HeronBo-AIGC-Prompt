*.mp4
*.mov
*.webm
*.wav
*.png
*.jpg
素材/
成片/
废片/
评价/
# 例外：samples/ 下的评价 json 属于规律数据，随仓库同步
!samples/**/评价/
!samples/**/评价/*.json
# 本机私有取值/账本（不进仓库，避免多机冲突）
references/*.local.md
references/*.local.json
# Python 缓存（诊断脚本 import 工具时会生成）
__pycache__/

# exe 打包中间产物（不进仓库）
tools/build/
tools/*.spec
# 例外：dist 里的成品 exe 随仓库分发 —— 用户 clone/pull 即有可用工具，
# 不必在每台机器上装 Python + PyInstaller 再打包。
!tools/dist/
!tools/dist/score-tool.exe
